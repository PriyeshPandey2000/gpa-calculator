---
import Layout from '../layouts/Layout.astro';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Weighted GPA Calculator",
  "url": "https://gpacalculatorfree.com/weighted-gpa-calculator",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What is a weighted GPA?", "acceptedAnswer": { "@type": "Answer", "text": "A weighted GPA gives extra grade points for harder courses. AP and IB courses add +1.0 points, and Honors courses add +0.5 points to the standard grade points. This means an A in an AP course equals 5.0 weighted GPA points instead of 4.0." } },
    { "@type": "Question", "name": "What is the highest possible weighted GPA?", "acceptedAnswer": { "@type": "Answer", "text": "On a 5.0 scale, the highest possible weighted GPA is 5.0, achieved by earning A grades in all AP or IB courses. On a 4.5 scale, the maximum is 4.5 (all A's in Honors courses)." } },
    { "@type": "Question", "name": "Do colleges use weighted or unweighted GPA?", "acceptedAnswer": { "@type": "Answer", "text": "Most colleges recalculate GPAs on their own scale for fair comparison between applicants. However, weighted GPA signals academic rigor. Many colleges look at both. It's important to know your unweighted GPA as well." } },
    { "@type": "Question", "name": "How is weighted GPA calculated?", "acceptedAnswer": { "@type": "Answer", "text": "Add the course weight bonus to grade points first (e.g., A in AP = 4.0 + 1.0 = 5.0), then multiply by credit hours. Sum all weighted quality points, divide by total credit hours." } },
    { "@type": "Question", "name": "What is the difference between 4.0 and 5.0 scale weighted GPA?", "acceptedAnswer": { "@type": "Answer", "text": "On a 4.0 scale, even AP/Honors bonuses are capped at 4.0. On a 5.0 scale, AP courses can push GPA above 4.0. Most high schools in the US use the 5.0 weighted scale." } },
    { "@type": "Question", "name": "Should I take AP classes just for the GPA boost?", "acceptedAnswer": { "@type": "Answer", "text": "Only if you can maintain good grades. An A in a regular class (4.0) is worth more than a C in AP (2.0 + 1.0 = 3.0 weighted, 2.0 unweighted). Taking AP classes you'll struggle in can hurt your GPA." } }
  ]
};
---

<Layout
  title="Weighted GPA Calculator — Calculate Weighted & Unweighted GPA Free"
  description="Calculate your weighted GPA with AP, Honors, and IB courses. See both weighted and unweighted GPA side by side instantly. Free weighted GPA calculator."
  canonical="/weighted-gpa-calculator"
  schema={[webAppSchema, faqSchema]}
>

  <section class="page-hero">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="breadcrumb mb-4" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep" aria-hidden="true">/</span>
        <span>Weighted GPA Calculator</span>
      </nav>
      <h1 class="mb-3">Weighted GPA Calculator</h1>
      <p class="text-lg mb-4" style="color:var(--color-body);max-width:580px">Calculate your weighted and unweighted GPA side by side. Supports AP (+1.0), Honors (+0.5), and IB (+1.0) courses. Choose 4.0 or 5.0 scale.</p>
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-blue">Weighted & Unweighted</span>
        <span class="badge badge-green">AP / Honors / IB</span>
        <span class="badge badge-blue">4.0 & 5.0 Scale</span>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-8">
    <div class="grid lg:grid-cols-3 gap-6">

      <!-- Input panel -->
      <div class="lg:col-span-2">
        <div class="card p-5">
          <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
            <h2 class="text-lg font-semibold m-0" style="color:var(--color-ink)">Enter Your Courses</h2>
            <div class="flex items-center gap-4 flex-wrap">
              <!-- Scale toggle -->
              <div class="flex items-center gap-2 text-sm">
                <span style="color:var(--color-body)">4.0</span>
                <label class="toggle">
                  <input type="checkbox" id="scale-toggle" />
                  <span class="toggle-track"></span>
                  <span class="toggle-thumb"></span>
                </label>
                <span style="color:var(--color-body)">5.0 scale</span>
              </div>
              <!-- No credits toggle -->
              <label class="toggle-wrap text-sm" style="color:var(--color-body)">
                <span class="toggle">
                  <input type="checkbox" id="no-credits-toggle" />
                  <span class="toggle-track"></span>
                  <span class="toggle-thumb"></span>
                </span>
                No credits
              </label>
            </div>
          </div>

          <!-- Column headers -->
          <div class="hidden sm:grid gap-2 mb-2 px-3 text-xs font-medium uppercase tracking-wide" id="col-headers" style="color:var(--color-mute);grid-template-columns:1.5fr 1fr 1fr 1fr auto">
            <span>Course</span><span>Type</span><span>Grade</span><span id="cr-header">Credits</span><span></span>
          </div>

          <div id="courses-container" class="flex flex-col gap-2"></div>

          <button id="add-btn" class="btn btn-ghost btn-sm mt-3 w-full" style="border:1px dashed var(--color-hairline-strong)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Add Course
          </button>

          <div class="flex flex-wrap gap-2 mt-4 pt-4" style="border-top:1px solid var(--color-hairline)">
            <button id="reset-btn" class="btn btn-secondary btn-sm">Reset</button>
            <button id="share-btn" class="btn btn-secondary btn-sm">Share Results</button>
            <button id="print-btn" class="btn btn-secondary btn-sm">Print</button>
          </div>
        </div>
      </div>

      <!-- Result panel -->
      <div class="lg:col-span-1">
        <div class="result-panel sticky top-20">
          <p class="text-xs font-medium uppercase tracking-wide mb-3" style="color:var(--color-brand)">Your GPA Results</p>

          <!-- Side by side weighted vs unweighted -->
          <div class="grid grid-cols-2 gap-3 mb-4">
            <div class="text-center p-3 rounded-lg" style="background:var(--color-canvas);border:1px solid var(--color-hairline)">
              <div class="text-xs mb-1 font-medium" style="color:var(--color-mute)">Unweighted</div>
              <div id="gpa-unweighted" class="tabular font-bold" style="font-size:2.25rem;letter-spacing:-0.04em;color:var(--color-mute)">—</div>
              <div class="text-xs mt-0.5" style="color:var(--color-mute)">/ 4.0</div>
            </div>
            <div class="text-center p-3 rounded-lg" style="background:var(--color-canvas);border:1px solid var(--color-hairline)">
              <div class="text-xs mb-1 font-medium" style="color:var(--color-mute)">Weighted</div>
              <div id="gpa-weighted" class="tabular font-bold" style="font-size:2.25rem;letter-spacing:-0.04em;color:var(--color-mute)">—</div>
              <div id="scale-label" class="text-xs mt-0.5" style="color:var(--color-mute)">/ 4.0</div>
            </div>
          </div>

          <div id="gpa-status-label" class="text-sm text-center mb-3 font-medium" style="color:var(--color-mute)">Enter courses above</div>

          <!-- Unweighted meter -->
          <div class="mb-1">
            <div class="flex justify-between text-xs mb-1" style="color:var(--color-mute)"><span>Unweighted</span><span>4.0</span></div>
            <div class="gpa-meter-container"><div id="meter-unweighted" class="gpa-meter-fill" style="width:0%"></div></div>
          </div>
          <!-- Weighted meter -->
          <div class="mb-3">
            <div class="flex justify-between text-xs mb-1" style="color:var(--color-mute)"><span>Weighted</span><span id="meter-scale-max">4.0</span></div>
            <div class="gpa-meter-container"><div id="meter-weighted" class="gpa-meter-fill" style="width:0%"></div></div>
          </div>

          <div id="proximity-msg" class="text-xs text-center" style="color:var(--color-brand);min-height:16px"></div>

          <div class="grid grid-cols-2 gap-3 mt-4 pt-4" style="border-top:1px solid var(--color-brand-soft)">
            <div class="text-center">
              <div id="stat-credits" class="font-bold text-lg tabular" style="color:var(--color-ink)">—</div>
              <div class="text-xs" style="color:var(--color-mute)">Credits</div>
            </div>
            <div class="text-center">
              <div id="stat-courses" class="font-bold text-lg tabular" style="color:var(--color-ink)">—</div>
              <div class="text-xs" style="color:var(--color-mute)">Courses</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Explanation -->
  <section class="max-w-3xl mx-auto px-4 py-8">
    <div class="grid md:grid-cols-2 gap-8 prose">
      <div>
        <h2>What is a Weighted GPA?</h2>
        <p>A weighted GPA adjusts grade points upward for more challenging courses. The standard 4.0 scale treats every course equally — but schools and colleges recognize that an A in AP Calculus represents greater academic achievement than an A in a regular class.</p>
        <p>The weighted GPA system addresses this by adding bonus points: <strong>AP and IB courses add +1.0</strong>, and <strong>Honors courses add +0.5</strong> to each grade. This means a student who takes all AP courses can potentially earn a weighted GPA above 4.0 — often up to 5.0.</p>
        <p>Use this calculator to see both your weighted and unweighted GPA side by side, so you understand how each metric will appear on college applications.</p>
      </div>
      <div>
        <h2>Weighted vs Unweighted: Which Matters More?</h2>
        <p>Both matter for college applications — but in different ways. Your <strong>unweighted GPA</strong> is a consistent measure that admissions officers can compare across different high schools. Your <strong>weighted GPA</strong> signals that you challenged yourself with rigorous coursework.</p>
        <p>Most selective colleges recalculate your GPA on their own scale to ensure fair comparisons. However, they also look at your course rigor separately. Taking AP and Honors classes matters even if the college unweights your GPA.</p>
        <p>A strategic approach: aim for strong grades first. A B+ in AP is better weighted (3.3 + 1.0 = 4.3) but worse unweighted (3.3) than an A in a regular class (4.0 both ways).</p>
      </div>
    </div>

    <!-- Weight reference table -->
    <div class="card overflow-hidden mt-6">
      <table class="w-full text-sm" style="border-collapse:collapse">
        <thead style="background:var(--color-canvas-soft-2)">
          <tr>
            <th class="text-left px-4 py-3" style="border-bottom:1px solid var(--color-hairline);color:var(--color-ink)">Course Type</th>
            <th class="text-center px-4 py-3" style="border-bottom:1px solid var(--color-hairline);color:var(--color-ink)">Weight Bonus</th>
            <th class="text-center px-4 py-3" style="border-bottom:1px solid var(--color-hairline);color:var(--color-ink)">A = (4.0 scale)</th>
            <th class="text-center px-4 py-3" style="border-bottom:1px solid var(--color-hairline);color:var(--color-ink)">A = (5.0 scale)</th>
          </tr>
        </thead>
        <tbody>
          {[["Regular","+0.0","4.0","4.0"],["Honors","+0.5","4.0 (cap)","4.5"],["AP","+1.0","4.0 (cap)","5.0"],["IB","+1.0","4.0 (cap)","5.0"]].map(([type,bonus,s4,s5],i)=>(
            <tr style={i%2===1?"background:var(--color-canvas-soft-2)":""}>
              <td class="px-4 py-3 font-medium" style="color:var(--color-ink);border-bottom:1px solid var(--color-hairline)">{type}</td>
              <td class="px-4 py-3 text-center" style="color:var(--color-brand);border-bottom:1px solid var(--color-hairline)">{bonus}</td>
              <td class="px-4 py-3 text-center tabular" style="color:var(--color-body);border-bottom:1px solid var(--color-hairline)">{s4}</td>
              <td class="px-4 py-3 text-center tabular" style="color:var(--color-body);border-bottom:1px solid var(--color-hairline)">{s5}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-3xl mx-auto px-4 py-8">
    <h2 class="text-2xl font-bold mb-6" style="color:var(--color-ink)">Frequently Asked Questions</h2>
    <div>
      {[
        {q:"What is a weighted GPA?",a:"A weighted GPA gives extra grade points for harder courses. AP and IB courses add +1.0 points, Honors courses add +0.5 points. An A in AP equals 5.0 weighted (vs 4.0 unweighted)."},
        {q:"What is the highest possible weighted GPA?",a:"On a 5.0 scale, the maximum is 5.0 — achieved by earning A grades in all AP or IB courses. On a 4.5 scale (Honors max), the ceiling is 4.5."},
        {q:"Do colleges use weighted or unweighted GPA?",a:"Most colleges recalculate GPAs on their own scale for fair comparison. However, weighted GPA signals academic rigor. Many look at both. Know your unweighted GPA too."},
        {q:"How is weighted GPA calculated?",a:"Add the course bonus to grade points first (A in AP = 4.0 + 1.0 = 5.0 on 5.0 scale), multiply by credit hours to get quality points, sum all quality points, divide by total credits."},
        {q:"What's the difference between 4.0 and 5.0 weighted scale?",a:"On a 4.0 weighted scale, bonuses are capped — an A in AP still shows 4.0. On a 5.0 scale, AP/IB courses push above 4.0, with a 5.0 maximum for A grades in AP."},
        {q:"Should I take AP classes just for the GPA boost?",a:"Only if you can earn good grades. An A in regular (4.0) outperforms a C in AP (2.0 weighted on 4.0 scale, 3.0 on 5.0 scale). Academic rigor matters, but grades matter more."},
      ].map(({q,a})=>(
        <div class="faq-item">
          <button class="faq-question"><span>{q}</span><svg class="faq-chevron w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></button>
          <div class="faq-answer">{a}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Related -->
  <section class="max-w-6xl mx-auto px-4 py-6 pb-12">
    <h2 class="text-xl font-bold mb-4" style="color:var(--color-ink)">Related Calculators</h2>
    <div class="flex flex-wrap gap-3">
      {[["Unweighted GPA Calculator","/unweighted-gpa-calculator"],["High School GPA Calculator","/high-school-gpa-calculator"],["College GPA Calculator","/college-gpa-calculator"],["Cumulative GPA Calculator","/cumulative-gpa-calculator"],["What If GPA Calculator","/what-if-gpa-calculator"]].map(([l,h])=>(
        <a href={h} class="btn btn-secondary btn-sm">{l}</a>
      ))}
    </div>
  </section>

</Layout>

<script>
(function(){
  const GRADE_POINTS={'A+':4.0,'A':4.0,'A-':3.7,'B+':3.3,'B':3.0,'B-':2.7,'C+':2.3,'C':2.0,'C-':1.7,'D+':1.3,'D':1.0,'D-':0.7,'F':0.0};
  const GRADES=['A+','A','A-','B+','B','B-','C+','C','C-','D+','D','D-','F','P','W'];
  const TYPES=['Regular','Honors','AP','IB'];
  const WEIGHTS={Regular:0,Honors:0.5,AP:1.0,IB:1.0};

  let noCredits=false, use5Scale=false, count=0;
  const container=document.getElementById('courses-container');

  function gpaColor(g){if(g<2)return'#ee0000';if(g<3)return'#f5a623';if(g<3.5)return'#16a34a';return'#0070f3';}
  function gpaLabel(g){if(g>=3.9)return'Summa Cum Laude';if(g>=3.7)return'Magna Cum Laude';if(g>=3.5)return"Dean's List";if(g>=3.0)return'Good Standing';if(g>=2.0)return'Satisfactory';if(g>=1.0)return'Below Average';return'Failing';}

  function buildRow(){
    count++;
    const row=document.createElement('div');
    row.className='course-row';
    row.style.gridTemplateColumns=noCredits?'1.5fr 1fr 1fr auto':'1.5fr 1fr 1fr 1fr auto';

    const name=document.createElement('input');
    name.type='text';name.placeholder=`Course ${count}`;name.className='input';
    name.style.fontSize='0.875rem';
    name.addEventListener('input',calc);

    const typeWrap=document.createElement('div');
    const typeSelect=document.createElement('select');
    typeSelect.className='input';typeSelect.style.fontSize='0.875rem';
    TYPES.forEach(t=>{const o=document.createElement('option');o.value=t;o.textContent=t;typeSelect.appendChild(o);});
    typeSelect.addEventListener('change',calc);
    typeWrap.appendChild(typeSelect);

    const gradeWrap=document.createElement('div');
    const gradeSelect=document.createElement('select');
    gradeSelect.className='input';gradeSelect.style.fontSize='0.875rem';
    GRADES.forEach(g=>{const o=document.createElement('option');o.value=g;o.textContent=g;if(g==='A')o.selected=true;gradeSelect.appendChild(o);});
    gradeSelect.addEventListener('change',calc);
    gradeWrap.appendChild(gradeSelect);

    const crInput=document.createElement('input');
    crInput.type='number';crInput.min='0.5';crInput.max='12';crInput.step='0.5';crInput.value='3';
    crInput.className='input';crInput.style.cssText='font-size:0.875rem;width:72px;text-align:center';
    crInput.addEventListener('input',calc);

    const rmBtn=document.createElement('button');
    rmBtn.type='button';rmBtn.className='btn btn-secondary btn-sm';
    rmBtn.style.cssText='padding:0.375rem 0.5rem;color:var(--color-mute)';
    rmBtn.innerHTML='<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    rmBtn.addEventListener('click',()=>{row.remove();calc();});

    row.appendChild(name);row.appendChild(typeWrap);row.appendChild(gradeWrap);
    if(!noCredits)row.appendChild(crInput);
    row.appendChild(rmBtn);
    return row;
  }

  function add(){container.appendChild(buildRow());calc();}

  function calc(){
    const rows=container.querySelectorAll('.course-row');
    let totalUQP=0,totalWQP=0,totalCr=0,validCount=0;
    const scale=use5Scale?5.0:4.0;

    rows.forEach(row=>{
      const selects=row.querySelectorAll('select');
      if(selects.length<2)return;
      const type=selects[0].value;
      const grade=selects[1].value;
      if(!(grade in GRADE_POINTS))return;
      const basePoints=GRADE_POINTS[grade];
      const bonus=WEIGHTS[type]||0;
      const weightedPoints=Math.min(basePoints+bonus,scale);
      const credits=noCredits?1:parseFloat(row.querySelector('input[type="number"]')?.value||'0');
      if(!credits||credits<=0)return;
      totalUQP+=basePoints*credits;
      totalWQP+=weightedPoints*credits;
      totalCr+=credits;
      validCount++;
    });

    const uwGPA=document.getElementById('gpa-unweighted');
    const wGPA=document.getElementById('gpa-weighted');
    const label=document.getElementById('gpa-status-label');
    const mU=document.getElementById('meter-unweighted');
    const mW=document.getElementById('meter-weighted');
    const prox=document.getElementById('proximity-msg');
    const statCr=document.getElementById('stat-credits');
    const statCo=document.getElementById('stat-courses');

    if(validCount===0||totalCr===0){
      [uwGPA,wGPA].forEach(el=>{if(el){el.textContent='—';el.style.color='var(--color-mute)';}});
      if(label)label.textContent='Enter courses above';
      if(mU)mU.style.width='0%';
      if(mW)mW.style.width='0%';
      if(prox)prox.textContent='';
      if(statCr)statCr.textContent='—';
      if(statCo)statCo.textContent='—';
      return;
    }

    const uw=Math.round((totalUQP/totalCr)*1000)/1000;
    const w=Math.round((totalWQP/totalCr)*1000)/1000;
    const color=gpaColor(uw);

    if(uwGPA){uwGPA.textContent=uw.toFixed(2);uwGPA.style.color=color;}
    if(wGPA){wGPA.textContent=w.toFixed(2);wGPA.style.color=color;}
    if(label)label.textContent=gpaLabel(uw);
    if(mU){mU.style.width=Math.min((uw/4.0)*100,100)+'%';mU.style.background=color;}
    if(mW){mW.style.width=Math.min((w/scale)*100,100)+'%';mW.style.background=color;}
    if(statCr)statCr.textContent=noCredits?`${validCount}`:totalCr.toFixed(1);
    if(statCo)statCo.textContent=String(validCount);

    // Proximity for unweighted
    const thresholds=[{v:4.0,l:'Perfect (4.0)'},{v:3.7,l:'Magna Cum Laude (3.7)'},{v:3.5,l:"Dean's List (3.5)"},{v:3.0,l:'Good Standing (3.0)'}];
    let proxMsg='';
    for(const t of thresholds){
      if(uw<t.v){const diff=(t.v-uw).toFixed(2);if(parseFloat(diff)<=0.3){proxMsg=`${diff} away from ${t.l}`;break;}}
    }
    if(prox)prox.textContent=proxMsg;
  }

  // Toggles
  document.getElementById('scale-toggle')?.addEventListener('change',function(){
    use5Scale=this.checked;
    const scaleLabel=document.getElementById('scale-label');
    const meterMax=document.getElementById('meter-scale-max');
    if(scaleLabel)scaleLabel.textContent=use5Scale?'/ 5.0':'/ 4.0';
    if(meterMax)meterMax.textContent=use5Scale?'5.0':'4.0';
    calc();
  });

  document.getElementById('no-credits-toggle')?.addEventListener('change',function(){
    noCredits=this.checked;
    const hdr=document.getElementById('cr-header');
    if(hdr)hdr.style.display=noCredits?'none':'';
    const colH=document.getElementById('col-headers');
    if(colH)colH.style.gridTemplateColumns=noCredits?'1.5fr 1fr 1fr auto':'1.5fr 1fr 1fr 1fr auto';
    const rows=[...container.querySelectorAll('.course-row')];
    const data=rows.map(r=>({type:r.querySelectorAll('select')[0]?.value||'Regular',grade:r.querySelectorAll('select')[1]?.value||'A',credits:r.querySelector('input[type="number"]')?.value||'3'}));
    container.innerHTML='';count=0;
    data.forEach(d=>{
      const row=buildRow();
      const selects=row.querySelectorAll('select');
      if(selects[0])selects[0].value=d.type;
      if(selects[1])selects[1].value=d.grade;
      if(!noCredits){const ci=row.querySelector('input[type="number"]');if(ci)ci.value=d.credits;}
      container.appendChild(row);
    });
    calc();
  });

  document.getElementById('add-btn')?.addEventListener('click',add);
  document.getElementById('reset-btn')?.addEventListener('click',()=>{container.innerHTML='';count=0;for(let i=0;i<4;i++)add();});
  document.getElementById('share-btn')?.addEventListener('click',()=>{
    const uw=document.getElementById('gpa-unweighted')?.textContent||'—';
    const w=document.getElementById('gpa-weighted')?.textContent||'—';
    const url=new URL(window.location.href);
    url.searchParams.set('uw',uw);url.searchParams.set('w',w);
    navigator.clipboard?.writeText(url.toString()).then(()=>{
      const btn=document.getElementById('share-btn');
      if(btn){const t=btn.textContent;btn.textContent='✓ Copied!';setTimeout(()=>{btn.textContent=t;},2000);}
    });
  });
  document.getElementById('print-btn')?.addEventListener('click',()=>window.print());

  // FAQ
  document.querySelectorAll('.faq-question').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const item=btn.closest('.faq-item');
      const open=item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(el=>el.classList.remove('open'));
      if(!open)item.classList.add('open');
    });
  });

  // Init
  for(let i=0;i<4;i++)add();
})();
</script>
