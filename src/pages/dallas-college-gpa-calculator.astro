---
import Layout from '../layouts/Layout.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What GPA do you need to stay in good standing at Dallas College?",
      "acceptedAnswer": { "@type": "Answer", "text": "A cumulative GPA of 2.0 or higher is required to remain in good academic standing at Dallas College. Students falling below this threshold are placed on academic probation." }
    },
    {
      "@type": "Question",
      "name": "What happens if your GPA falls below 2.0 at Dallas College?",
      "acceptedAnswer": { "@type": "Answer", "text": "If your cumulative GPA falls below 2.0 at Dallas College, you are placed on academic probation. You must raise your GPA to 2.0 or above by the end of the following semester or face academic suspension, which can affect financial aid eligibility." }
    },
    {
      "@type": "Question",
      "name": "What GPA do you need to transfer from Dallas College to a university?",
      "acceptedAnswer": { "@type": "Answer", "text": "Most four-year universities in Texas require a minimum 2.5 GPA for transfer from Dallas College, though competitive programs and universities like UT Austin may require 3.0 or higher. Check the specific requirements of the university you are transferring to." }
    },
    {
      "@type": "Question",
      "name": "Does Dallas College use a 4.0 GPA scale?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. Dallas College uses the standard 4.0 GPA scale with plus/minus grades. A=4.0, B=3.0, C=2.0, D=1.0, F=0. This scale applies across all Dallas College campuses including Brookhaven, Cedar Valley, Eastfield, El Centro, Mountain View, North Lake, and Richland." }
    },
    {
      "@type": "Question",
      "name": "How many credits do I need to graduate from Dallas College?",
      "acceptedAnswer": { "@type": "Answer", "text": "Dallas College Associate Degree programs typically require 60 credit hours. Certificate programs vary from 15 to 45+ credit hours depending on the field. Check your specific program's degree plan in the Dallas College catalog for exact requirements." }
    }
  ]
};
---

<Layout
  title="Dallas College GPA Calculator — Free GPA Calculator"
  description="Calculate your Dallas College GPA instantly. Free GPA calculator using the standard 4.0 scale for Dallas College students."
  canonical="/dallas-college-gpa-calculator"
  schema={faqSchema}
>
  <section class="page-hero">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="breadcrumb mb-4"><a href="/">Home</a><span class="sep">/</span><span>Dallas College GPA Calculator</span></nav>
      <h1 class="mb-3">Dallas College GPA Calculator</h1>
      <p class="text-lg mb-4" style="color:var(--color-body);max-width:580px">Free GPA calculator for Dallas College students. Uses the standard 4.0 scale. Enter your courses, grades, and credit hours for instant results.</p>
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-blue">Dallas College</span>
        <span class="badge badge-green">4.0 Scale</span>
        <span class="badge badge-blue">Free</span>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-8">
    <div class="grid lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2">
        <div class="card p-5">
          <h2 class="text-lg font-semibold mb-5" style="color:var(--color-ink)">Enter Your Courses</h2>
          <div class="hidden sm:grid gap-2 mb-2 px-3 text-xs font-medium uppercase tracking-wide" style="color:var(--color-mute);grid-template-columns:2fr 1fr 1fr auto">
            <span>Course</span><span>Grade</span><span>Credits</span><span></span>
          </div>
          <div id="courses-container" class="flex flex-col gap-2"></div>
          <button id="add-btn" class="btn btn-ghost btn-sm mt-3 w-full" style="border:1px dashed var(--color-hairline-strong)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Add Course
          </button>
          <div class="flex gap-2 mt-4 pt-4 flex-wrap" style="border-top:1px solid var(--color-hairline)">
            <button id="reset-btn" class="btn btn-secondary btn-sm">Reset</button>
            <button id="print-btn" class="btn btn-secondary btn-sm">Print</button>
          </div>
        </div>
      </div>
      <div class="lg:col-span-1">
        <div class="result-panel sticky top-20 text-center">
          <div class="text-xs font-medium uppercase tracking-wide mb-2" style="color:var(--color-brand)">Your GPA</div>
          <div id="gpa-result" class="tabular font-bold mb-2" style="font-size:3.5rem;letter-spacing:-0.04em;color:var(--color-mute)">—</div>
          <div id="gpa-label" class="text-sm font-medium mb-3" style="color:var(--color-mute)">Enter courses above</div>
          <div class="gpa-meter-container mb-1"><div id="gpa-meter" class="gpa-meter-fill" style="width:0%"></div></div>
          <div id="proximity" class="text-xs mt-2" style="color:var(--color-brand);min-height:16px"></div>
          <div class="mt-4 pt-4 text-xs text-left" style="border-top:1px solid var(--color-brand-soft);color:var(--color-body)">
            <div class="flex justify-between mb-1"><span>Good Standing</span><span class="tabular font-medium">2.0+</span></div>
            <div class="flex justify-between mb-1"><span>Dean's List</span><span class="tabular font-medium">3.5+</span></div>
            <div class="flex justify-between"><span>Summa Cum Laude</span><span class="tabular font-medium">3.9+</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 py-6 prose pb-8">
    <h2>Dallas College GPA Information</h2>
    <p>Dallas College (formerly Dallas County Community College District) uses the standard 4.0 GPA scale. Students must maintain a cumulative GPA of 2.0 or higher for good academic standing. Dallas College includes multiple campuses: Brookhaven, Cedar Valley, Eastfield, El Centro, Mountain View, North Lake, and Richland.</p>
    <p>Good standing requires 2.0+ cumulative GPA. Contact Dallas College registrar for specific program GPA requirements.</p>
    <p>Use our <a href="/cumulative-gpa-calculator">Cumulative GPA Calculator</a> to track GPA across all semesters, or the <a href="/what-if-gpa-calculator">What If GPA Calculator</a> to simulate future grade scenarios.</p>
    <div class="not-prose flex flex-wrap gap-2 mt-4">
      <a href="/college-gpa-calculator" class="btn btn-secondary btn-sm">College GPA Calculator</a>
      <a href="/cumulative-gpa-calculator" class="btn btn-secondary btn-sm">Cumulative GPA</a>
      <a href="/what-if-gpa-calculator" class="btn btn-secondary btn-sm">What If GPA</a>
      <a href="/gpa-scale" class="btn btn-secondary btn-sm">GPA Scale Chart</a>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 pb-12" aria-labelledby="faq-dallas">
    <h2 id="faq-dallas" class="mb-6 text-xl font-semibold" style="color:var(--color-ink)">Dallas College GPA — Frequently Asked Questions</h2>
    <div>
      <div class="faq-item open">
        <button class="faq-question" type="button" aria-expanded="true">What GPA do you need to stay in good standing at Dallas College?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="faq-answer">A cumulative GPA of 2.0 or higher is required to remain in good academic standing at Dallas College. Students falling below this threshold are placed on academic probation.</div>
      </div>
      <div class="faq-item">
        <button class="faq-question" type="button" aria-expanded="false">What happens if your GPA falls below 2.0 at Dallas College?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="faq-answer">If your cumulative GPA falls below 2.0 at Dallas College, you are placed on academic probation. You must raise your GPA to 2.0 or above by the end of the following semester or face academic suspension, which can affect financial aid eligibility.</div>
      </div>
      <div class="faq-item">
        <button class="faq-question" type="button" aria-expanded="false">What GPA do you need to transfer from Dallas College to a university?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="faq-answer">Most four-year universities in Texas require a minimum 2.5 GPA for transfer from Dallas College, though competitive programs and universities like UT Austin may require 3.0 or higher. Check the specific requirements of the university you are transferring to.</div>
      </div>
      <div class="faq-item">
        <button class="faq-question" type="button" aria-expanded="false">Does Dallas College use a 4.0 GPA scale?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="faq-answer">Yes. Dallas College uses the standard 4.0 GPA scale with plus/minus grades. A=4.0, B=3.0, C=2.0, D=1.0, F=0. This scale applies across all Dallas College campuses including Brookhaven, Cedar Valley, Eastfield, El Centro, Mountain View, North Lake, and Richland.</div>
      </div>
      <div class="faq-item">
        <button class="faq-question" type="button" aria-expanded="false">How many credits do I need to graduate from Dallas College?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="faq-answer">Dallas College Associate Degree programs typically require 60 credit hours. Certificate programs vary from 15 to 45+ credit hours depending on the field. Check your specific program's degree plan in the Dallas College catalog for exact requirements.</div>
      </div>
    </div>
  </section>
</Layout>

<script>
document.querySelectorAll('.faq-question').forEach(btn => {
  btn.addEventListener('click', () => {
    const item = btn.closest('.faq-item');
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(el => { el.classList.remove('open'); el.querySelector('.faq-question')?.setAttribute('aria-expanded','false'); });
    if (!isOpen) { item.classList.add('open'); btn.setAttribute('aria-expanded','true'); }
  });
});
</script>

<script>
(function(){
  var GP={'A+':4.0,'A':4.0,'A-':3.7,'B+':3.3,'B':3.0,'B-':2.7,'C+':2.3,'C':2.0,'C-':1.7,'D+':1.3,'D':1.0,'D-':0.7,'F':0.0};
  var GRADES=['A+','A','A-','B+','B','B-','C+','C','C-','D+','D','D-','F','P','W'];
  var count=0;
  var container=document.getElementById('courses-container');
  function gpaColor(g){return g<2?'#ee0000':g<3?'#f5a623':g<3.5?'#16a34a':'#0070f3';}
  function gpaLabel(g){return g>=3.9?'Summa Cum Laude':g>=3.5?"Dean's List":g>=3.0?'Good Standing':g>=2.0?'Satisfactory':'At Risk';}
  function buildRow(){
    count++;
    var row=document.createElement('div');row.className='course-row';row.style.gridTemplateColumns='2fr 1fr 1fr auto';
    var name=document.createElement('input');name.type='text';name.placeholder='Course '+count;name.className='input';name.style.fontSize='0.875rem';name.addEventListener('input',calc);
    var gs=document.createElement('select');gs.className='input';gs.style.fontSize='0.875rem';
    GRADES.forEach(function(g){var o=document.createElement('option');o.value=g;o.textContent=g;if(g==='A')o.selected=true;gs.appendChild(o);});
    gs.addEventListener('change',calc);
    var ci=document.createElement('input');ci.type='number';ci.min='0.5';ci.max='12';ci.step='0.5';ci.value='3';ci.className='input';ci.style.cssText='font-size:0.875rem;width:72px;text-align:center';ci.addEventListener('input',calc);
    var rm=document.createElement('button');rm.type='button';rm.className='btn btn-secondary btn-sm';rm.style.cssText='padding:0.375rem 0.5rem;color:var(--color-mute)';
    rm.innerHTML='<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/><\/svg>';
    rm.addEventListener('click',function(){row.remove();calc();});
    row.appendChild(name);row.appendChild(gs);row.appendChild(ci);row.appendChild(rm);return row;
  }
  function add(){container.appendChild(buildRow());calc();}
  function calc(){
    var rows=container.querySelectorAll('.course-row');var tQP=0,tCr=0;
    rows.forEach(function(row){
      var gs=row.querySelector('select');var ci=row.querySelector('input[type="number"]');
      if(!gs||!(gs.value in GP))return;
      var cr=parseFloat(ci?ci.value:'0');if(!cr||cr<=0)return;
      tQP+=GP[gs.value]*cr;tCr+=cr;
    });
    var res=document.getElementById('gpa-result');var lbl=document.getElementById('gpa-label');
    var meter=document.getElementById('gpa-meter');var prox=document.getElementById('proximity');
    if(tCr===0){if(res){res.textContent='\u2014';res.style.color='var(--color-mute)';}if(lbl)lbl.textContent='Enter courses above';if(meter)meter.style.width='0%';if(prox)prox.textContent='';return;}
    var gpa=Math.round((tQP/tCr)*1000)/1000;var color=gpaColor(gpa);
    if(res){res.textContent=gpa.toFixed(2);res.style.color=color;}
    if(lbl){lbl.textContent=gpaLabel(gpa);lbl.style.color=color;}
    if(meter){meter.style.width=Math.min((gpa/4.0)*100,100)+'%';meter.style.background=color;}
    var thresholds=[{v:3.5,l:"Dean's List (3.5)"},{v:3.0,l:'Good Standing (3.0)'},{v:2.0,l:'Passing (2.0)'}];
    var proxMsg='';
    for(var i=0;i<thresholds.length;i++){var t=thresholds[i];if(gpa<t.v){var d=(t.v-gpa).toFixed(2);if(parseFloat(d)<=0.3){proxMsg=d+' away from '+t.l;break;}}}
    if(prox)prox.textContent=proxMsg;
  }
  var addBtn=document.getElementById('add-btn');if(addBtn)addBtn.addEventListener('click',add);
  var resetBtn=document.getElementById('reset-btn');if(resetBtn)resetBtn.addEventListener('click',function(){container.innerHTML='';count=0;for(var i=0;i<4;i++)add();});
  var printBtn=document.getElementById('print-btn');if(printBtn)printBtn.addEventListener('click',function(){window.print();});
  for(var i=0;i<4;i++)add();
})();
</script>
