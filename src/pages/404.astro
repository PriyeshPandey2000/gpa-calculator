---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found — GPA Calculator Free"
  description="The page you're looking for doesn't exist. Return to GPA Calculator Free for free GPA calculators."
  canonical="/404"
>
  <section class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="text-center max-w-md">
      <div class="text-8xl font-bold tabular mb-4" style="color:var(--color-hairline);letter-spacing:-0.04em">404</div>
      <h1 class="text-2xl font-bold mb-3" style="color:var(--color-ink)">Page Not Found</h1>
      <p class="mb-8" style="color:var(--color-body)">The page you're looking for doesn't exist. Try one of our GPA calculators below.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/" class="btn btn-primary">GPA Calculator</a>
        <a href="/college-gpa-calculator" class="btn btn-secondary">College GPA</a>
        <a href="/high-school-gpa-calculator" class="btn btn-secondary">High School GPA</a>
        <a href="/what-if-gpa-calculator" class="btn btn-secondary">What If GPA</a>
      </div>
    </div>
  </section>
</Layout>
