---
import Layout from '../layouts/Layout.astro';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "College GPA Calculator",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "Any",
  "url": "https://gpacalculatorfree.com/college-gpa-calculator",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Free college GPA calculator. Enter your courses, grades, and credits to calculate your semester GPA and cumulative GPA instantly on the 4.0 scale.",
  "browserRequirements": "Requires JavaScript",
  "featureList": [
    "Semester GPA calculation by course",
    "Cumulative GPA with previous semester data",
    "Letter grade and percentage input modes",
    "Multiple semesters with collapsible sections",
    "Live GPA progress bar with Dean's List indicators",
    "Share and print results"
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a good college GPA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A GPA of 3.0 or above is considered good standing at most colleges. A 3.5 or above typically qualifies students for the Dean's List and is competitive for many scholarships. A 3.7 or above is considered excellent and positions you well for graduate school applications, honors at graduation, and top internship opportunities."
      }
    },
    {
      "@type": "Question",
      "name": "How is college GPA calculated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "College GPA is calculated by converting each letter grade to grade points (A=4.0, B=3.0, C=2.0, D=1.0, F=0.0), multiplying by the course's credit hours to get quality points, then dividing the total quality points by total credit hours. For example, an A in a 3-credit course gives 12 quality points. Semester GPA = total quality points divided by total credits."
      }
    },
    {
      "@type": "Question",
      "name": "What GPA do I need to maintain good academic standing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most colleges and universities require a minimum cumulative GPA of 2.0 to remain in good academic standing. Falling below 2.0 can result in academic probation, loss of financial aid eligibility, or suspension. Some programs — such as education, nursing, or engineering — may require a higher GPA of 2.5 or 3.0 to continue in the major."
      }
    },
    {
      "@type": "Question",
      "name": "Can I calculate cumulative college GPA with previous semesters?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Use Tab 2 — 'Include Previous GPA' — on this calculator. Enter your existing cumulative GPA and total credits completed, then add your current semester courses. The calculator automatically combines your previous academic record with your new courses to give you an updated cumulative GPA."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between semester GPA and cumulative GPA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Semester GPA reflects only the courses taken during a single term — it resets each semester. Cumulative GPA is the running weighted average of all courses taken across every semester you have completed. Your transcript shows both: semester GPA lets you see term-by-term performance, while cumulative GPA is what graduate schools, employers, and honor societies use to evaluate your overall academic record."
      }
    },
    {
      "@type": "Question",
      "name": "Does college GPA include all courses?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, in most cases college GPA includes all graded courses. Pass/Fail courses and official withdrawals (W) are excluded from the GPA calculation. If your college offers grade forgiveness or grade replacement for repeated courses, the earlier grade may be excluded — check your school's specific policy. Incomplete grades (I) are typically excluded until a final grade is assigned."
      }
    },
    {
      "@type": "Question",
      "name": "What GPA is needed for graduate school?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most graduate programs require a minimum undergraduate GPA of 3.0 for admission. Top programs and research universities typically expect 3.5 or higher. Highly competitive programs — such as top MBA programs, medical schools, and law schools — often see successful applicants with GPAs of 3.6 to 3.9. Some programs also consider your GPA in your major separately from your overall GPA."
      }
    },
    {
      "@type": "Question",
      "name": "How do I raise my college GPA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To raise your GPA, prioritize high-credit courses since they move your GPA more than 1-credit electives. If your school allows grade replacement, retaking courses where you earned a D or F can significantly boost your cumulative GPA. Focus on consistent A and B grades rather than overloading your schedule. Use office hours, tutoring, and study groups early in the semester. Use the GPA planning tool on this page to find out exactly what grades you need to reach your target."
      }
    }
  ]
};
---

<Layout
  title="College GPA Calculator — Semester & Cumulative (Free)"
  description="Free college GPA calculator. Enter your courses, grades, and credits to calculate your semester GPA and cumulative GPA instantly on the 4.0 scale."
  canonical="/college-gpa-calculator"
  schema={[webAppSchema, faqSchema]}
>

  <!-- ══════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════ -->
  <section class="page-hero">
    <div class="max-w-6xl mx-auto px-4">

      <!-- Breadcrumb -->
      <nav class="breadcrumb mb-4" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        <span aria-current="page">College GPA Calculator</span>
      </nav>

      <div class="max-w-2xl">
        <h1 class="mb-3">College GPA Calculator</h1>
        <p class="text-lg" style="color:var(--color-body)">
          Enter your courses, grades, and credit hours to calculate your semester GPA and cumulative GPA instantly. Supports multiple semesters, percentage mode, and previous GPA rollover — all on the standard 4.0 scale.
        </p>
        <div class="flex flex-wrap gap-2 mt-4">
          <span class="badge badge-blue">4.0 Scale</span>
          <span class="badge badge-green">Live Calculation</span>
          <span class="badge">Free &amp; No Signup</span>
          <span class="badge badge-blue">Shareable Results</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       MAIN CALCULATOR
  ══════════════════════════════════════════════ -->
  <section class="max-w-6xl mx-auto px-4 py-8" id="calculator" aria-labelledby="calc-heading">
    <div class="grid lg:grid-cols-3 gap-6 items-start">

      <!-- Left: Input panel (2/3 width on desktop) -->
      <div class="lg:col-span-2 flex flex-col gap-4">

        <!-- Tab switcher -->
        <div class="card p-0 overflow-hidden">
          <div class="tab-list" role="tablist" aria-label="Calculator mode">
            <button class="tab-btn active" id="tab-semester" role="tab" aria-selected="true" aria-controls="panel-semester" type="button">
              Semester GPA
            </button>
            <button class="tab-btn" id="tab-previous" role="tab" aria-selected="false" aria-controls="panel-previous" type="button">
              Include Previous GPA
            </button>
          </div>
        </div>

        <!-- ── Tab 1: Semester GPA ── -->
        <div id="panel-semester" role="tabpanel" aria-labelledby="tab-semester">

          <!-- Global toggles row -->
          <div class="card p-4 flex flex-wrap items-center gap-x-6 gap-y-3">
            <!-- Grade mode toggle -->
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium" style="color:var(--color-body)" id="grade-mode-label-1">Letter Grade</span>
              <label class="toggle" aria-label="Toggle between letter grade and percentage input">
                <input type="checkbox" id="pct-toggle-1" />
                <span class="toggle-track"></span>
                <span class="toggle-thumb"></span>
              </label>
              <span class="text-sm" style="color:var(--color-mute)">%</span>
            </div>
            <!-- Equal credits toggle -->
            <div class="flex items-center gap-2">
              <label class="toggle" aria-label="Weight all courses equally (no credit hours)">
                <input type="checkbox" id="equal-credits-toggle" />
                <span class="toggle-track"></span>
                <span class="toggle-thumb"></span>
              </label>
              <span class="text-sm" style="color:var(--color-mute)">Equal credits (no weighting)</span>
            </div>
          </div>

          <!-- Semesters container -->
          <div id="semesters-container" class="flex flex-col gap-4 mt-4">
            <!-- Semester blocks injected by JS -->
          </div>

          <!-- Add semester button -->
          <button
            id="add-semester-btn"
            type="button"
            class="btn btn-ghost btn-sm mt-4 w-full"
            style="border: 1px dashed var(--color-hairline-strong); color: var(--color-brand);"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            Add Semester
          </button>

        </div>

        <!-- ── Tab 2: Include Previous GPA ── -->
        <div id="panel-previous" role="tabpanel" aria-labelledby="tab-previous" class="hidden">

          <!-- Previous GPA inputs -->
          <div class="card p-5 mb-4">
            <h2 class="text-base font-semibold mb-4" style="color:var(--color-ink); font-size:1rem;" id="calc-heading">Previous Academic Record</h2>
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="prev-gpa" class="block text-sm font-medium mb-1" style="color:var(--color-body)">Previous Cumulative GPA</label>
                <input
                  type="number"
                  id="prev-gpa"
                  class="input"
                  placeholder="e.g. 3.25"
                  min="0"
                  max="4"
                  step="0.01"
                  aria-describedby="prev-gpa-hint"
                />
                <p id="prev-gpa-hint" class="text-xs mt-1" style="color:var(--color-mute)">Your cumulative GPA before this semester (0.00 – 4.00)</p>
              </div>
              <div>
                <label for="prev-credits" class="block text-sm font-medium mb-1" style="color:var(--color-body)">Credits Completed</label>
                <input
                  type="number"
                  id="prev-credits"
                  class="input"
                  placeholder="e.g. 60"
                  min="0"
                  step="0.5"
                  aria-describedby="prev-credits-hint"
                />
                <p id="prev-credits-hint" class="text-xs mt-1" style="color:var(--color-mute)">Total credit hours completed before this semester</p>
              </div>
            </div>
          </div>

          <!-- Grade mode toggle for tab 2 -->
          <div class="card p-4 flex flex-wrap items-center gap-x-6 gap-y-3 mb-4">
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium" style="color:var(--color-body)" id="grade-mode-label-2">Letter Grade</span>
              <label class="toggle" aria-label="Toggle percentage input for tab 2">
                <input type="checkbox" id="pct-toggle-2" />
                <span class="toggle-track"></span>
                <span class="toggle-thumb"></span>
              </label>
              <span class="text-sm" style="color:var(--color-mute)">%</span>
            </div>
            <div class="flex items-center gap-2">
              <label class="toggle" aria-label="Weight all courses equally in tab 2">
                <input type="checkbox" id="equal-credits-toggle-2" />
                <span class="toggle-track"></span>
                <span class="toggle-thumb"></span>
              </label>
              <span class="text-sm" style="color:var(--color-mute)">Equal credits</span>
            </div>
          </div>

          <!-- Current semester courses -->
          <div class="card p-5">
            <h3 class="text-sm font-semibold mb-3" style="color:var(--color-ink)">Current Semester Courses</h3>

            <!-- Column headers -->
            <div class="hidden sm:grid gap-3 mb-2 px-1" id="prev-course-headers" style="grid-template-columns: 1fr 120px 80px 36px;">
              <span class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-mute)">Course (optional)</span>
              <span class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-mute)">Grade</span>
              <span class="text-xs font-semibold uppercase tracking-wide" id="prev-credits-header" style="color:var(--color-mute)">Credits</span>
              <span></span>
            </div>

            <div id="prev-courses-container" class="flex flex-col gap-3">
              <!-- Rows injected by JS -->
            </div>

            <button
              id="add-prev-course-btn"
              type="button"
              class="btn btn-ghost btn-sm mt-4 w-full"
              style="border: 1px dashed var(--color-hairline-strong); color: var(--color-brand);"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              Add Course
            </button>
          </div>

        </div>

        <!-- Action buttons -->
        <div class="flex flex-wrap gap-2 pt-2">
          <button id="reset-btn" type="button" class="btn btn-secondary btn-sm">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
            Reset
          </button>
          <button id="share-btn" type="button" class="btn btn-secondary btn-sm">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            <span id="share-btn-text">Share Result</span>
          </button>
          <button id="print-btn" type="button" class="btn btn-secondary btn-sm print:hidden">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Print
          </button>
        </div>

        <!-- Share toast -->
        <div id="share-toast" class="hidden text-sm font-medium" style="color:var(--color-success)" role="status" aria-live="polite">
          Link copied to clipboard!
        </div>

      </div>

      <!-- Right: Sticky result panel (1/3 width on desktop) -->
      <div class="flex flex-col gap-4 lg:sticky lg:top-20">

        <!-- Main GPA result -->
        <div class="result-panel" id="result-panel">
          <div class="flex items-start justify-between gap-2 mb-1">
            <p class="text-xs font-semibold uppercase tracking-widest" style="color:var(--color-brand)">Semester GPA</p>
            <p class="text-xs font-semibold uppercase tracking-widest" id="cum-gpa-label" style="color:var(--color-mute); display:none">Cumulative GPA</p>
          </div>

          <div class="flex items-end gap-3 mb-1">
            <span id="semester-gpa-result" class="tabular" style="font-size:3.25rem; font-weight:700; line-height:1; letter-spacing:-0.04em; color:var(--color-brand)">—</span>
            <span class="text-base mb-1" style="color:var(--color-mute)">/&nbsp;4.00</span>
          </div>

          <!-- Cumulative GPA row (shown when tab 2 or multi-semester) -->
          <div id="cum-gpa-row" class="hidden mt-2 mb-2 flex items-center gap-3">
            <span class="text-xs uppercase tracking-wide font-semibold" style="color:var(--color-mute)">Cumulative:</span>
            <span id="cum-gpa-result" class="tabular text-2xl font-bold" style="color:var(--color-brand)">—</span>
          </div>

          <!-- Progress bar -->
          <div class="gpa-meter-container mt-3 mb-1" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="gpa-meter-wrap" aria-label="GPA progress meter">
            <div class="gpa-meter-fill" id="gpa-meter-fill" style="width:0%"></div>
          </div>
          <!-- Markers -->
          <div class="relative mt-1" style="height:16px;">
            <span class="absolute text-xs" style="left:50%;transform:translateX(-50%);color:var(--color-mute)">2.0</span>
            <span class="absolute text-xs" style="left:75%;transform:translateX(-50%);color:var(--color-mute)">3.0</span>
            <span class="absolute text-xs" style="left:87.5%;transform:translateX(-50%);color:var(--color-mute)">3.5</span>
            <span class="absolute text-xs" style="right:0;color:var(--color-mute)">4.0</span>
          </div>

          <div class="flex items-center justify-between mt-3">
            <span id="gpa-standing-label" class="text-sm font-semibold" style="color:var(--color-ink)"></span>
            <span id="gpa-proximity" class="text-xs font-medium" style="color:var(--color-brand)"></span>
          </div>
        </div>

        <!-- Stats card -->
        <div class="card-soft p-4 grid grid-cols-2 gap-4 text-center">
          <div>
            <p class="text-xs uppercase tracking-wide mb-1 font-medium" style="color:var(--color-mute)">Total Credits</p>
            <p id="stat-credits" class="tabular text-2xl font-bold" style="color:var(--color-ink)">—</p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-wide mb-1 font-medium" style="color:var(--color-mute)">Quality Points</p>
            <p id="stat-qp" class="tabular text-2xl font-bold" style="color:var(--color-ink)">—</p>
          </div>
        </div>

        <!-- Proximity callout -->
        <div id="proximity-callout" class="callout callout-blue hidden" role="status" aria-live="polite">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5" style="color:var(--color-brand)" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="proximity-callout-text" class="text-sm"></span>
        </div>

        <!-- GPA scale reference -->
        <div class="card-soft p-4">
          <p class="text-xs font-semibold uppercase tracking-wide mb-3" style="color:var(--color-mute)">GPA Thresholds</p>
          <div class="flex flex-col gap-2 text-xs">
            <div class="flex items-center justify-between">
              <span class="flex items-center gap-2">
                <span class="inline-block w-2.5 h-2.5 rounded-full shrink-0" style="background:#0070f3"></span>
                3.50 – 4.00
              </span>
              <span class="font-semibold" style="color:#0070f3">Dean's List</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="flex items-center gap-2">
                <span class="inline-block w-2.5 h-2.5 rounded-full shrink-0" style="background:#16a34a"></span>
                3.00 – 3.49
              </span>
              <span class="font-semibold" style="color:#16a34a">Good Standing</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="flex items-center gap-2">
                <span class="inline-block w-2.5 h-2.5 rounded-full shrink-0" style="background:#f5a623"></span>
                2.00 – 2.99
              </span>
              <span class="font-semibold" style="color:#f5a623">Satisfactory</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="flex items-center gap-2">
                <span class="inline-block w-2.5 h-2.5 rounded-full shrink-0" style="background:#ee0000"></span>
                0.00 – 1.99
              </span>
              <span class="font-semibold" style="color:#ee0000">Below Average</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       GPA PLANNING TOOL
  ══════════════════════════════════════════════ -->
  <section class="max-w-6xl mx-auto px-4 py-6" aria-labelledby="planning-heading">
    <div class="card p-6">
      <h2 id="planning-heading" class="mb-1" style="font-size:1.15rem;">GPA Planning: What Grades Do I Need?</h2>
      <p class="text-sm mb-5" style="color:var(--color-body)">
        Enter your current GPA and credits, then set a target GPA to see what average grade you need going forward.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-5">
        <div>
          <label for="plan-current-gpa" class="block text-sm font-medium mb-1" style="color:var(--color-body)">Current GPA</label>
          <input type="number" id="plan-current-gpa" class="input" placeholder="e.g. 3.00" min="0" max="4" step="0.01" />
        </div>
        <div>
          <label for="plan-current-credits" class="block text-sm font-medium mb-1" style="color:var(--color-body)">Credits Completed</label>
          <input type="number" id="plan-current-credits" class="input" placeholder="e.g. 60" min="0" step="0.5" />
        </div>
        <div>
          <label for="plan-target-gpa" class="block text-sm font-medium mb-1" style="color:var(--color-body)">Target GPA</label>
          <input type="number" id="plan-target-gpa" class="input" placeholder="e.g. 3.50" min="0" max="4" step="0.01" />
        </div>
        <div>
          <label for="plan-future-credits" class="block text-sm font-medium mb-1" style="color:var(--color-body)">Future Credits Planned</label>
          <input type="number" id="plan-future-credits" class="input" placeholder="e.g. 30" min="0" step="0.5" />
        </div>
      </div>
      <div id="plan-result" class="hidden">
        <div class="callout callout-blue">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5" style="color:var(--color-brand)" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="plan-result-text" class="text-sm"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       HOW COLLEGE GPA WORKS
  ══════════════════════════════════════════════ -->
  <section class="max-w-6xl mx-auto px-4 py-6" aria-labelledby="how-gpa-works-heading">
    <div class="grid md:grid-cols-2 gap-8">

      <div class="prose">
        <h2 id="how-gpa-works-heading">How College GPA Works</h2>
        <p>
          Your college GPA is a single number that summarizes your academic performance across all graded coursework. Nearly every U.S. college and university uses the <strong>4.0 scale</strong>, where A equals 4.0 points, B equals 3.0, C equals 2.0, D equals 1.0, and F equals 0.0. Plus and minus grades introduce intermediate values: an A- is 3.7, a B+ is 3.3, and so on down the scale.
        </p>
        <p>
          To compute your GPA, each course's letter grade is first converted to grade points. Those grade points are then multiplied by the course's credit hours to produce <em>quality points</em>. Your semester GPA equals the total quality points divided by the total credit hours taken that semester. A 4-credit calculus course therefore has four times the impact on your GPA as a 1-credit physical education requirement.
        </p>
        <p>
          Your <strong>cumulative GPA</strong> extends this calculation across all semesters. It is not an average of your semester GPAs — it is a single weighted average of every quality point you have ever earned, divided by every graded credit hour you have completed. This is why recovering a low GPA becomes progressively harder the further along you are in your degree: each new semester contributes a smaller fraction of your total credit hours.
        </p>
        <p>
          Grades of P (Pass), W (Withdrawal), and I (Incomplete) are excluded from the GPA calculation at virtually all institutions. If your college has a grade forgiveness or grade replacement policy for repeated courses, only the most recent grade counts — but check your specific school's academic regulations since these policies vary.
        </p>
      </div>

      <div class="prose">
        <h2>Understanding the 4.0 GPA Scale</h2>
        <p>
          The 4.0 scale is a standardized system used to compare academic performance across different institutions and course loads. Here is the complete grade point mapping used by this calculator:
        </p>

        <!-- Grade scale table -->
        <div class="overflow-x-auto rounded-lg mt-4" style="border:1px solid var(--color-hairline)">
          <table class="w-full text-sm" style="border-collapse:collapse;margin:0">
            <thead>
              <tr style="background:var(--color-canvas-soft-2)">
                <th class="text-left px-3 py-2 text-xs font-semibold uppercase tracking-wide" style="color:var(--color-mute);border-bottom:1px solid var(--color-hairline)">Grade</th>
                <th class="text-center px-3 py-2 text-xs font-semibold uppercase tracking-wide" style="color:var(--color-mute);border-bottom:1px solid var(--color-hairline)">Points</th>
                <th class="text-center px-3 py-2 text-xs font-semibold uppercase tracking-wide" style="color:var(--color-mute);border-bottom:1px solid var(--color-hairline)">Percentage</th>
              </tr>
            </thead>
            <tbody>
              {[
                ["A+ / A","4.0","93–100%"],
                ["A-","3.7","90–92%"],
                ["B+","3.3","87–89%"],
                ["B","3.0","83–86%"],
                ["B-","2.7","80–82%"],
                ["C+","2.3","77–79%"],
                ["C","2.0","73–76%"],
                ["C-","1.7","70–72%"],
                ["D+","1.3","67–69%"],
                ["D","1.0","63–66%"],
                ["D-","0.7","60–62%"],
                ["F","0.0","< 60%"],
              ].map(([grade, pts, pct], i) => (
                <tr style={i % 2 === 0 ? "" : "background:var(--color-canvas-soft-2)"}>
                  <td class="px-3 py-2 font-semibold" style="color:var(--color-ink);border-bottom:1px solid var(--color-hairline);font-family:var(--font-mono)">{grade}</td>
                  <td class="px-3 py-2 text-center font-bold tabular" style="color:var(--color-brand);border-bottom:1px solid var(--color-hairline)">{pts}</td>
                  <td class="px-3 py-2 text-center" style="color:var(--color-body);border-bottom:1px solid var(--color-hairline)">{pct}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs mt-3" style="color:var(--color-mute)">
          P (Pass), W (Withdrawal), and I (Incomplete) grades are excluded from GPA calculations.
        </p>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       FAQ
  ══════════════════════════════════════════════ -->
  <section class="max-w-6xl mx-auto px-4 py-6" aria-labelledby="faq-heading">
    <div class="max-w-2xl">
      <h2 id="faq-heading" class="mb-6">Frequently Asked Questions</h2>
      <div>

        <div class="faq-item open">
          <button class="faq-question" type="button" aria-expanded="true">
            What is a good college GPA?
            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            A GPA of 3.0 or above is considered good standing at most colleges. A 3.5 or above typically qualifies students for the Dean's List and is competitive for many scholarships. A 3.7 or above is considered excellent and positions you well for graduate school applications, honors at graduation (such as Magna Cum Laude or Summa Cum Laude), and top internship or job opportunities.
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            How is college GPA calculated?
            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            College GPA is calculated by converting each letter grade to grade points (A = 4.0, B = 3.0, etc.), multiplying by credit hours to get quality points, then dividing total quality points by total credit hours. For example: an A in a 3-credit course = 12 quality points. An A- in a 4-credit course = 14.8 quality points. Sum all quality points, divide by total credits, and you have your GPA.
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            What GPA do I need to maintain good academic standing?
            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            Most colleges and universities require a minimum cumulative GPA of 2.0 to remain in good academic standing. Falling below 2.0 can result in academic probation, loss of financial aid eligibility, or suspension. Some programs — such as nursing, education, or engineering — may require a higher GPA of 2.5 or 3.0 to continue in the major. Always check your institution's specific requirements.
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            Can I calculate cumulative GPA with previous semesters?
            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            Yes. Use the "Include Previous GPA" tab on this calculator. Enter your existing cumulative GPA and total credits completed, then add your current semester's courses. The calculator automatically combines your previous academic record with your new courses to show your updated cumulative GPA in real time.
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            What is the difference between semester GPA and cumulative GPA?
            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            Semester GPA reflects only the courses taken during a single term — it resets each semester. Cumulative GPA is the running weighted average of all courses taken across every semester you have completed. Your transcript shows both: semester GPA lets you see term-by-term performance, while cumulative GPA is what graduate schools, employers, and honor societies use to evaluate your overall academic record.
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            Does college GPA include all courses?
            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            Yes, in most cases college GPA includes all graded courses. Pass/Fail courses and official withdrawals (W) are excluded from the GPA calculation. If your college has a grade forgiveness or grade replacement policy for repeated courses, the earlier grade may be excluded — check your school's specific academic policy. Incomplete grades (I) are typically excluded until a final grade is assigned.
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            What GPA is needed for graduate school?
            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            Most graduate programs require a minimum undergraduate GPA of 3.0 for admission. Top research programs and highly competitive schools typically expect 3.5 or higher. Professional programs — such as top MBA, medical, and law schools — often see successful applicants with GPAs of 3.6 to 3.9. Some programs also evaluate your GPA in your major field separately from your overall cumulative GPA.
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" type="button" aria-expanded="false">
            How do I raise my college GPA?
            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            To raise your GPA effectively, prioritize high-credit courses since they move your GPA more than 1-credit electives. If your school allows grade replacement, retaking courses where you earned a D or F can significantly boost your cumulative GPA. Focus on earning consistent A and B grades rather than overloading your schedule. Attend office hours, join study groups, and seek tutoring early in the semester. Use the GPA planning tool on this page to calculate exactly what average grade you need to hit your target GPA.
          </div>
        </div>

      </div>
    </div>
  </section>

