<!-- ══════════════════════════════════════════════
     CALCULATOR JAVASCRIPT
══════════════════════════════════════════════ -->
<script>
(function () {
  'use strict';

  // ── Grade constants ──────────────────────────────────────────────────────────

  const GRADE_POINTS = {
    'A+': 4.0, 'A': 4.0, 'A-': 3.7,
    'B+': 3.3, 'B': 3.0, 'B-': 2.7,
    'C+': 2.3, 'C': 2.0, 'C-': 1.7,
    'D+': 1.3, 'D': 1.0, 'D-': 0.7,
    'F': 0.0,
    'P': null, 'W': null, 'I': null,
  };

  const GRADE_OPTIONS = ['A+','A','A-','B+','B','B-','C+','C','C-','D+','D','D-','F','P','W'];

  const GRADE_POINTS_TO_LETTER = [
    { min: 4.0,  letter: 'A+' },
    { min: 3.85, letter: 'A'  },
    { min: 3.65, letter: 'A-' },
    { min: 3.15, letter: 'B+' },
    { min: 2.85, letter: 'B'  },
    { min: 2.65, letter: 'B-' },
    { min: 2.15, letter: 'C+' },
    { min: 1.85, letter: 'C'  },
    { min: 1.65, letter: 'C-' },
    { min: 1.15, letter: 'D+' },
    { min: 0.85, letter: 'D'  },
    { min: 0.65, letter: 'D-' },
    { min: 0.0,  letter: 'F'  },
  ];

  // ── Helpers ──────────────────────────────────────────────────────────────────

  function percentToLetter(pct) {
    const p = parseFloat(pct);
    if (isNaN(p)) return 'F';
    if (p >= 97) return 'A+';
    if (p >= 93) return 'A';
    if (p >= 90) return 'A-';
    if (p >= 87) return 'B+';
    if (p >= 83) return 'B';
    if (p >= 80) return 'B-';
    if (p >= 77) return 'C+';
    if (p >= 73) return 'C';
    if (p >= 70) return 'C-';
    if (p >= 67) return 'D+';
    if (p >= 63) return 'D';
    if (p >= 60) return 'D-';
    return 'F';
  }

  function pointsToLetter(pts) {
    for (const entry of GRADE_POINTS_TO_LETTER) {
      if (pts >= entry.min) return entry.letter;
    }
    return 'F';
  }

  function formatGPA(g) {
    return (g === null || g === undefined || isNaN(g)) ? '—' : g.toFixed(2);
  }

  function gpaColorHex(g) {
    if (g === null || g === undefined || isNaN(g)) return '#888888';
    if (g < 2.0) return '#ee0000';
    if (g < 3.0) return '#f5a623';
    if (g < 3.5) return '#16a34a';
    return '#0070f3';
  }

  function gpaStandingLabel(g) {
    if (g === null || g === undefined || isNaN(g)) return '';
    if (g >= 3.9) return 'Summa Cum Laude';
    if (g >= 3.7) return 'Magna Cum Laude';
    if (g >= 3.5) return "Dean's List";
    if (g >= 3.0) return 'Good Standing';
    if (g >= 2.0) return 'Satisfactory';
    if (g >= 1.0) return 'Below Average';
    return 'Failing';
  }

  function gpaProximityMsg(g) {
    if (g === null || g === undefined || isNaN(g)) return '';
    const thresholds = [
      { val: 4.0,  label: 'Perfect GPA (4.0)' },
      { val: 3.9,  label: 'Summa Cum Laude (3.9)' },
      { val: 3.7,  label: 'Magna Cum Laude (3.7)' },
      { val: 3.5,  label: "Dean's List (3.5)" },
      { val: 3.0,  label: 'Good Standing (3.0)' },
      { val: 2.0,  label: 'Passing (2.0)' },
    ];
    for (const t of thresholds) {
      if (g < t.val) {
        const diff = t.val - g;
        if (diff <= 0.30) {
          return `${diff.toFixed(2)} away from ${t.label}`;
        }
        return '';
      }
    }
    return '';
  }

  function buildGradeSelect(defaultGrade) {
    const sel = document.createElement('select');
    sel.className = 'input grade-select';
    sel.style.cssText = 'font-size:0.875rem;width:100%;';
    sel.setAttribute('aria-label', 'Letter grade');
    GRADE_OPTIONS.forEach(g => {
      const opt = document.createElement('option');
      opt.value = g;
      opt.textContent = g;
      if (g === (defaultGrade || 'A')) opt.selected = true;
      sel.appendChild(opt);
    });
    return sel;
  }

  function buildPctInput() {
    const inp = document.createElement('input');
    inp.type = 'number';
    inp.min = '0';
    inp.max = '100';
    inp.step = '1';
    inp.placeholder = '%';
    inp.className = 'input pct-input';
    inp.style.cssText = 'font-size:0.875rem;width:100%;text-align:center;';
    inp.setAttribute('aria-label', 'Grade percentage');
    return inp;
  }

  // ── State ────────────────────────────────────────────────────────────────────

  let activeTab = 'semester'; // 'semester' | 'previous'
  let pctMode1 = false;       // percentage mode for tab 1
  let noCredits1 = false;     // equal credits mode for tab 1
  let pctMode2 = false;       // percentage mode for tab 2
  let noCredits2 = false;     // equal credits mode for tab 2
  let semesterCounter = 0;
  let courseCounter = 0;
  let prevCourseCounter = 0;

  // ── DOM refs ─────────────────────────────────────────────────────────────────

  const tabSemesterBtn    = document.getElementById('tab-semester');
  const tabPreviousBtn    = document.getElementById('tab-previous');
  const panelSemester     = document.getElementById('panel-semester');
  const panelPrevious     = document.getElementById('panel-previous');

  const semestersContainer = document.getElementById('semesters-container');
  const addSemesterBtn     = document.getElementById('add-semester-btn');

  const prevGPAInput       = document.getElementById('prev-gpa');
  const prevCreditsInput   = document.getElementById('prev-credits');
  const prevCoursesContainer = document.getElementById('prev-courses-container');
  const addPrevCourseBtn   = document.getElementById('add-prev-course-btn');

  const pctToggle1         = document.getElementById('pct-toggle-1');
  const equalCreditsToggle = document.getElementById('equal-credits-toggle');
  const gradeModeLabel1    = document.getElementById('grade-mode-label-1');

  const pctToggle2         = document.getElementById('pct-toggle-2');
  const equalCreditsToggle2 = document.getElementById('equal-credits-toggle-2');
  const gradeModeLabel2    = document.getElementById('grade-mode-label-2');

  const resetBtn           = document.getElementById('reset-btn');
  const shareBtn           = document.getElementById('share-btn');
  const shareBtnText       = document.getElementById('share-btn-text');
  const printBtn           = document.getElementById('print-btn');
  const shareToast         = document.getElementById('share-toast');

  // Result elements
  const semGPAResult       = document.getElementById('semester-gpa-result');
  const cumGPAResult       = document.getElementById('cum-gpa-result');
  const cumGPARow          = document.getElementById('cum-gpa-row');
  const cumGPALabel        = document.getElementById('cum-gpa-label');
  const gpaMeterFill       = document.getElementById('gpa-meter-fill');
  const gpaMeterWrap       = document.getElementById('gpa-meter-wrap');
  const gpaStandingEl      = document.getElementById('gpa-standing-label');
  const gpaProximEl        = document.getElementById('gpa-proximity');
  const statCredits        = document.getElementById('stat-credits');
  const statQP             = document.getElementById('stat-qp');
  const proximityCallout   = document.getElementById('proximity-callout');
  const proximityCallText  = document.getElementById('proximity-callout-text');

  // ── Tab switching ────────────────────────────────────────────────────────────

  function switchTab(tab) {
    activeTab = tab;

    tabSemesterBtn.classList.toggle('active', tab === 'semester');
    tabPreviousBtn.classList.toggle('active', tab === 'previous');
    tabSemesterBtn.setAttribute('aria-selected', String(tab === 'semester'));
    tabPreviousBtn.setAttribute('aria-selected', String(tab === 'previous'));

    panelSemester.classList.toggle('hidden', tab !== 'semester');
    panelPrevious.classList.toggle('hidden', tab !== 'previous');

    recalculate();
  }

  tabSemesterBtn.addEventListener('click', () => switchTab('semester'));
  tabPreviousBtn.addEventListener('click', () => switchTab('previous'));

  // Keyboard navigation for tabs
  [tabSemesterBtn, tabPreviousBtn].forEach(btn => {
    btn.addEventListener('keydown', e => {
      if (e.key === 'ArrowRight') { tabPreviousBtn.focus(); switchTab('previous'); }
      else if (e.key === 'ArrowLeft') { tabSemesterBtn.focus(); switchTab('semester'); }
    });
  });

  // ── Semester block (Tab 1) ───────────────────────────────────────────────────

  const SEMESTER_LABELS = [
    'Fall 2024','Spring 2025','Summer 2025',
    'Fall 2025','Spring 2026','Summer 2026',
    'Fall 2026','Spring 2027','Summer 2027',
    'Fall 2027','Spring 2028',
  ];

  function createCourseRowEl(rowId, pctMode, noCreditsMode, semId) {
    const row = document.createElement('div');
    row.className = 'course-row';
    row.dataset.semId = semId;
    row.style.gridTemplateColumns = noCreditsMode
      ? '1fr 120px 36px'
      : '1fr 120px 80px 36px';

    // Course name
    const nameWrap = document.createElement('div');
    const nameInput = document.createElement('input');
    nameInput.type = 'text';
    nameInput.placeholder = `Course ${rowId}`;
    nameInput.className = 'input';
    nameInput.style.fontSize = '0.875rem';
    nameInput.setAttribute('aria-label', 'Course name (optional)');
    nameInput.addEventListener('input', recalculate);
    nameWrap.appendChild(nameInput);

    // Grade
    const gradeWrap = document.createElement('div');
    let gradeEl;
    if (pctMode) {
      gradeEl = buildPctInput();
    } else {
      gradeEl = buildGradeSelect('A');
    }
    gradeEl.addEventListener('input', recalculate);
    gradeEl.addEventListener('change', recalculate);
    gradeWrap.appendChild(gradeEl);

    // Credits
    const creditsWrap = document.createElement('div');
    const creditsInput = document.createElement('input');
    creditsInput.type = 'number';
    creditsInput.min = '0.5';
    creditsInput.max = '12';
    creditsInput.step = '0.5';
    creditsInput.value = '3';
    creditsInput.className = 'input credits-input';
    creditsInput.style.cssText = 'font-size:0.875rem;text-align:center;';
    creditsInput.setAttribute('aria-label', 'Credit hours');
    creditsInput.addEventListener('input', recalculate);
    creditsWrap.appendChild(creditsInput);

    // Remove button
    const removeWrap = document.createElement('div');
    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'btn btn-secondary btn-sm';
    removeBtn.style.cssText = 'padding:0.35rem 0.5rem;color:var(--color-mute);';
    removeBtn.setAttribute('aria-label', 'Remove course');
    removeBtn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    removeBtn.addEventListener('click', () => {
      const semBlock = document.querySelector(`[data-semester-id="${semId}"]`);
      const rowsContainer = semBlock ? semBlock.querySelector('.sem-courses') : null;
      row.remove();
      recalculate();
      // If this semester has no more course rows, add one back
      if (rowsContainer && rowsContainer.querySelectorAll('.course-row').length === 0) {
        addCourseToSemester(semId);
      }
    });
    removeWrap.appendChild(removeBtn);

    row.appendChild(nameWrap);
    row.appendChild(gradeWrap);
    if (!noCreditsMode) row.appendChild(creditsWrap);
    row.appendChild(removeWrap);

    return row;
  }

  function addCourseToSemester(semId) {
    const semBlock = document.querySelector(`[data-semester-id="${semId}"]`);
    if (!semBlock) return;
    const rowsContainer = semBlock.querySelector('.sem-courses');
    courseCounter++;
    const row = createCourseRowEl(courseCounter, pctMode1, noCredits1, semId);
    rowsContainer.appendChild(row);
    recalculate();
  }

  function createSemesterBlock(semId) {
    const label = SEMESTER_LABELS[semId] || `Semester ${semId + 1}`;

    const block = document.createElement('div');
    block.className = 'card p-0 overflow-hidden';
    block.dataset.semesterId = semId;

    // Semester header
    const header = document.createElement('div');
    header.className = 'flex items-center justify-between px-4 py-3';
    header.style.cssText = 'background:var(--color-canvas-soft);border-bottom:1px solid var(--color-hairline);';

    const leftSide = document.createElement('div');
    leftSide.className = 'flex items-center gap-3';

    // Collapse toggle
    const collapseBtn = document.createElement('button');
    collapseBtn.type = 'button';
    collapseBtn.className = 'btn btn-ghost btn-sm p-1';
    collapseBtn.setAttribute('aria-expanded', 'true');
    collapseBtn.setAttribute('aria-label', 'Collapse semester');
    collapseBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>';

    const semLabel = document.createElement('input');
    semLabel.type = 'text';
    semLabel.value = label;
    semLabel.className = 'input';
    semLabel.style.cssText = 'font-size:0.875rem;font-weight:600;color:var(--color-ink);max-width:180px;border:none;background:transparent;padding:0.2rem 0.4rem;';
    semLabel.setAttribute('aria-label', 'Semester name');

    const semGPABadge = document.createElement('span');
    semGPABadge.className = 'badge tabular';
    semGPABadge.dataset.semGpaBadge = semId;
    semGPABadge.style.cssText = 'font-size:0.75rem;background:var(--color-canvas-soft-2);color:var(--color-mute);';
    semGPABadge.textContent = '— GPA';

    leftSide.appendChild(collapseBtn);
    leftSide.appendChild(semLabel);
    leftSide.appendChild(semGPABadge);

    const rightSide = document.createElement('div');
    rightSide.className = 'flex items-center gap-2';

    const removeSemBtn = document.createElement('button');
    removeSemBtn.type = 'button';
    removeSemBtn.className = 'btn btn-secondary btn-sm';
    removeSemBtn.style.cssText = 'color:var(--color-mute);font-size:0.75rem;';
    removeSemBtn.setAttribute('aria-label', 'Remove semester');
    removeSemBtn.textContent = 'Remove';
    removeSemBtn.addEventListener('click', () => {
      block.remove();
      recalculate();
    });

    rightSide.appendChild(removeSemBtn);
    header.appendChild(leftSide);
    header.appendChild(rightSide);

    // Collapsible body
    const body = document.createElement('div');
    body.className = 'sem-body px-4 pt-3 pb-4';

    // Column headers
    const colHeaders = document.createElement('div');
    colHeaders.className = 'hidden sm:grid gap-2 mb-2 px-1 sem-col-headers';
    colHeaders.style.gridTemplateColumns = noCredits1
      ? '1fr 120px 36px'
      : '1fr 120px 80px 36px';
    colHeaders.innerHTML = `
      <span class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-mute)">Course (optional)</span>
      <span class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-mute)">${pctMode1 ? 'Score %' : 'Grade'}</span>
      ${noCredits1 ? '' : '<span class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-mute)">Credits</span>'}
      <span></span>
    `;

    // Courses container
    const coursesDiv = document.createElement('div');
    coursesDiv.className = 'sem-courses flex flex-col gap-2';

    // Add course button
    const addCourseBtn = document.createElement('button');
    addCourseBtn.type = 'button';
    addCourseBtn.className = 'btn btn-ghost btn-sm mt-3 w-full';
    addCourseBtn.style.cssText = 'border:1px dashed var(--color-hairline);color:var(--color-brand);font-size:0.8rem;';
    addCourseBtn.setAttribute('aria-label', 'Add course to this semester');
    addCourseBtn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg> Add Course';
    addCourseBtn.addEventListener('click', () => addCourseToSemester(semId));

    body.appendChild(colHeaders);
    body.appendChild(coursesDiv);
    body.appendChild(addCourseBtn);

    block.appendChild(header);
    block.appendChild(body);

    // Collapse functionality
    let expanded = true;
    collapseBtn.addEventListener('click', () => {
      expanded = !expanded;
      body.style.display = expanded ? '' : 'none';
      collapseBtn.setAttribute('aria-expanded', String(expanded));
      collapseBtn.innerHTML = expanded
        ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>'
        : '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
    });

    return block;
  }

  function addSemester() {
    const semId = semesterCounter;
    semesterCounter++;

    const block = createSemesterBlock(semId);
    semestersContainer.appendChild(block);

    // Add default course rows
    for (let i = 0; i < 4; i++) {
      addCourseToSemester(semId);
    }
    recalculate();
  }

  addSemesterBtn.addEventListener('click', addSemester);

  // ── Tab 2 course rows ────────────────────────────────────────────────────────

  function createPrevCourseRow(rowId) {
    const row = document.createElement('div');
    row.className = 'course-row';
    row.dataset.prevRowId = rowId;
    row.style.gridTemplateColumns = noCredits2
      ? '1fr 120px 36px'
      : '1fr 120px 80px 36px';

    // Course name
    const nameWrap = document.createElement('div');
    const nameInput = document.createElement('input');
    nameInput.type = 'text';
    nameInput.placeholder = `Course ${rowId}`;
    nameInput.className = 'input';
    nameInput.style.fontSize = '0.875rem';
    nameInput.setAttribute('aria-label', 'Course name');
    nameInput.addEventListener('input', recalculate);
    nameWrap.appendChild(nameInput);

    // Grade
    const gradeWrap = document.createElement('div');
    let gradeEl;
    if (pctMode2) {
      gradeEl = buildPctInput();
    } else {
      gradeEl = buildGradeSelect('A');
    }
    gradeEl.addEventListener('input', recalculate);
    gradeEl.addEventListener('change', recalculate);
    gradeWrap.appendChild(gradeEl);

    // Credits
    const creditsWrap = document.createElement('div');
    const creditsInput = document.createElement('input');
    creditsInput.type = 'number';
    creditsInput.min = '0.5';
    creditsInput.max = '12';
    creditsInput.step = '0.5';
    creditsInput.value = '3';
    creditsInput.className = 'input credits-input';
    creditsInput.style.cssText = 'font-size:0.875rem;text-align:center;';
    creditsInput.setAttribute('aria-label', 'Credit hours');
    creditsInput.addEventListener('input', recalculate);
    creditsWrap.appendChild(creditsInput);

    // Remove
    const removeWrap = document.createElement('div');
    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'btn btn-secondary btn-sm';
    removeBtn.style.cssText = 'padding:0.35rem 0.5rem;color:var(--color-mute);';
    removeBtn.setAttribute('aria-label', 'Remove course');
    removeBtn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    removeBtn.addEventListener('click', () => {
      row.remove();
      recalculate();
      if (prevCoursesContainer.querySelectorAll('.course-row').length === 0) {
        addPrevCourse();
      }
    });
    removeWrap.appendChild(removeBtn);

    row.appendChild(nameWrap);
    row.appendChild(gradeWrap);
    if (!noCredits2) row.appendChild(creditsWrap);
    row.appendChild(removeWrap);

    return row;
  }

  function addPrevCourse() {
    prevCourseCounter++;
    const row = createPrevCourseRow(prevCourseCounter);
    prevCoursesContainer.appendChild(row);
    recalculate();
  }

  addPrevCourseBtn.addEventListener('click', addPrevCourse);
  prevGPAInput.addEventListener('input', recalculate);
  prevCreditsInput.addEventListener('input', recalculate);

  // ── Toggle handlers ──────────────────────────────────────────────────────────

  pctToggle1.addEventListener('change', () => {
    pctMode1 = pctToggle1.checked;
    if (gradeModeLabel1) gradeModeLabel1.textContent = pctMode1 ? 'Percentage' : 'Letter Grade';
    rebuildAllSemesters();
  });

  equalCreditsToggle.addEventListener('change', () => {
    noCredits1 = equalCreditsToggle.checked;
    rebuildAllSemesters();
  });

  pctToggle2.addEventListener('change', () => {
    pctMode2 = pctToggle2.checked;
    if (gradeModeLabel2) gradeModeLabel2.textContent = pctMode2 ? 'Percentage' : 'Letter Grade';
    rebuildPrevCourses();
  });

  equalCreditsToggle2.addEventListener('change', () => {
    noCredits2 = equalCreditsToggle2.checked;
    rebuildPrevCourses();
  });

  function rebuildAllSemesters() {
    // Rebuild course rows within each semester while preserving semester count
    const semBlocks = semestersContainer.querySelectorAll('[data-semester-id]');
    semBlocks.forEach(block => {
      const semId = block.dataset.semesterId;
      const coursesDiv = block.querySelector('.sem-courses');
      const colHeaders = block.querySelector('.sem-col-headers');
      const existingCount = Math.max(coursesDiv.children.length, 1);

      // Update column headers
      if (colHeaders) {
        colHeaders.style.gridTemplateColumns = noCredits1
          ? '1fr 120px 36px'
          : '1fr 120px 80px 36px';
        colHeaders.innerHTML = `
          <span class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-mute)">Course (optional)</span>
          <span class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-mute)">${pctMode1 ? 'Score %' : 'Grade'}</span>
          ${noCredits1 ? '' : '<span class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-mute)">Credits</span>'}
          <span></span>
        `;
      }

      // Rebuild course rows
      coursesDiv.innerHTML = '';
      for (let i = 0; i < existingCount; i++) {
        courseCounter++;
        const row = createCourseRowEl(courseCounter, pctMode1, noCredits1, semId);
        coursesDiv.appendChild(row);
      }
    });
    recalculate();
  }

  function rebuildPrevCourses() {
    const existingCount = Math.max(prevCoursesContainer.children.length, 1);
    prevCoursesContainer.innerHTML = '';
    for (let i = 0; i < existingCount; i++) {
      prevCourseCounter++;
      const row = createPrevCourseRow(prevCourseCounter);
      prevCoursesContainer.appendChild(row);
    }

    // Update column headers
    const prevHeader = document.getElementById('prev-credits-header');
    if (prevHeader) prevHeader.style.display = noCredits2 ? 'none' : '';
    recalculate();
  }

  // ── Calculation logic ────────────────────────────────────────────────────────

  function getGradePoints(row, pctMode) {
    if (pctMode) {
      const pctEl = row.querySelector('.pct-input');
      if (!pctEl || pctEl.value === '') return null;
      const letter = percentToLetter(pctEl.value);
      return GRADE_POINTS[letter] !== undefined ? GRADE_POINTS[letter] : null;
    } else {
      const sel = row.querySelector('.grade-select');
      if (!sel) return null;
      const val = GRADE_POINTS[sel.value];
      return val !== undefined ? val : null;
    }
  }

  function calcRowsGPA(rows, pctMode, noCredits) {
    let totalQP = 0;
    let totalCr = 0;
    rows.forEach(row => {
      const pts = getGradePoints(row, pctMode);
      if (pts === null) return; // skip P/W/I
      const credits = noCredits
        ? 1
        : parseFloat(row.querySelector('.credits-input')?.value || '0');
      if (!credits || credits <= 0) return;
      totalQP += pts * credits;
      totalCr += credits;
    });
    return { totalQP, totalCr, gpa: totalCr > 0 ? totalQP / totalCr : null };
  }

  function recalculate() {
    if (activeTab === 'semester') {
      recalcSemesterTab();
    } else {
      recalcPreviousTab();
    }
  }

  function recalcSemesterTab() {
    const semBlocks = semestersContainer.querySelectorAll('[data-semester-id]');
    let allQP = 0;
    let allCr = 0;

    let firstSemGPA = null;

    semBlocks.forEach((block, idx) => {
      const semId = block.dataset.semesterId;
      const rows = block.querySelectorAll('.course-row');
      const { totalQP, totalCr, gpa } = calcRowsGPA(rows, pctMode1, noCredits1);

      // Update per-semester badge
      const badge = block.querySelector(`[data-sem-gpa-badge="${semId}"]`);
      if (badge) {
        if (gpa !== null) {
          badge.textContent = `${gpa.toFixed(2)} GPA`;
          badge.style.color = gpaColorHex(gpa);
          badge.style.background = 'var(--color-canvas-soft-2)';
        } else {
          badge.textContent = '— GPA';
          badge.style.color = 'var(--color-mute)';
        }
      }

      allQP += totalQP;
      allCr += totalCr;

      if (idx === 0) firstSemGPA = gpa;
    });

    const semCount = semBlocks.length;
    const cumGPA = allCr > 0 ? allQP / allCr : null;

    // Display: if 1 semester, show semester GPA only
    // If multiple, show last semester GPA as "Semester GPA" and cumulative below
    if (semCount <= 1) {
      updateResultPanel({
        primaryGPA: firstSemGPA,
        primaryLabel: 'Semester GPA',
        showCum: false,
        cumGPA: null,
        totalCr: allCr,
        totalQP: allQP,
      });
    } else {
      // Get last semester GPA
      const lastBlock = semBlocks[semBlocks.length - 1];
      const lastRows = lastBlock.querySelectorAll('.course-row');
      const { gpa: lastGPA } = calcRowsGPA(lastRows, pctMode1, noCredits1);

      updateResultPanel({
        primaryGPA: lastGPA,
        primaryLabel: 'Latest Semester',
        showCum: true,
        cumGPA: cumGPA,
        totalCr: allCr,
        totalQP: allQP,
      });
    }
  }

  function recalcPreviousTab() {
    const prevGPA = parseFloat(prevGPAInput.value);
    const prevCr = parseFloat(prevCreditsInput.value);
    const rows = prevCoursesContainer.querySelectorAll('.course-row');
    const { totalQP: newQP, totalCr: newCr, gpa: semGPA } = calcRowsGPA(rows, pctMode2, noCredits2);

    const validPrev = !isNaN(prevGPA) && !isNaN(prevCr) && prevCr >= 0 && prevGPA >= 0 && prevGPA <= 4.0;
    const validNew  = newCr > 0;

    let cumGPA = null;
    let totalCr = newCr;
    let totalQP = newQP;

    if (validPrev && validNew) {
      totalQP = prevGPA * prevCr + newQP;
      totalCr = prevCr + newCr;
      cumGPA = totalQP / totalCr;
    } else if (!validPrev && validNew) {
      cumGPA = semGPA;
      totalCr = newCr;
      totalQP = newQP;
    }

    updateResultPanel({
      primaryGPA: semGPA,
      primaryLabel: 'Semester GPA',
      showCum: validPrev && validNew,
      cumGPA: validPrev && validNew ? cumGPA : null,
      totalCr: totalCr,
      totalQP: totalQP,
    });
  }

  function updateResultPanel({ primaryGPA, primaryLabel, showCum, cumGPA, totalCr, totalQP }) {
    const displayGPA = primaryGPA;
    const color = gpaColorHex(displayGPA);

    // Primary GPA number
    semGPAResult.textContent = formatGPA(displayGPA);
    semGPAResult.style.color = displayGPA !== null ? color : 'var(--color-brand)';

    // Pulse animation
    semGPAResult.classList.remove('pulse-once');
    void semGPAResult.offsetWidth;
    if (displayGPA !== null) semGPAResult.classList.add('pulse-once');

    // Cumulative GPA row
    if (showCum && cumGPA !== null) {
      cumGPARow.style.display = 'flex';
      cumGPALabel.style.display = '';
      cumGPAResult.textContent = formatGPA(cumGPA);
      cumGPAResult.style.color = gpaColorHex(cumGPA);
    } else {
      cumGPARow.style.display = 'none';
      cumGPALabel.style.display = 'none';
    }

    // Meter — use cum GPA if available, else primary
    const meterGPA = (showCum && cumGPA !== null) ? cumGPA : displayGPA;
    const pct = meterGPA !== null ? Math.min(Math.max((meterGPA / 4.0) * 100, 0), 100) : 0;
    gpaMeterFill.style.width = pct + '%';
    gpaMeterFill.style.background = gpaColorHex(meterGPA);
    gpaMeterWrap.setAttribute('aria-valuenow', Math.round(pct).toString());

    // Standing label and proximity
    const refGPA = meterGPA;
    gpaStandingEl.textContent = refGPA !== null ? gpaStandingLabel(refGPA) : '';
    gpaStandingEl.style.color = gpaColorHex(refGPA);

    const proxMsg = refGPA !== null ? gpaProximityMsg(refGPA) : '';
    gpaProximEl.textContent = proxMsg;

    // Stats
    statCredits.textContent = totalCr > 0 ? (totalCr % 1 === 0 ? String(totalCr) : totalCr.toFixed(1)) : '—';
    statQP.textContent = totalQP > 0 ? totalQP.toFixed(2) : '—';

    // Proximity callout
    if (proxMsg) {
      proximityCallout.classList.remove('hidden');
      proximityCallText.textContent = proxMsg;
    } else {
      proximityCallout.classList.add('hidden');
    }
  }

  // ── GPA Planning Tool ────────────────────────────────────────────────────────

  const planCurrentGPA     = document.getElementById('plan-current-gpa');
  const planCurrentCredits = document.getElementById('plan-current-credits');
  const planTargetGPA      = document.getElementById('plan-target-gpa');
  const planFutureCredits  = document.getElementById('plan-future-credits');
  const planResult         = document.getElementById('plan-result');
  const planResultText     = document.getElementById('plan-result-text');

  function recalcPlan() {
    const curGPA = parseFloat(planCurrentGPA.value);
    const curCr  = parseFloat(planCurrentCredits.value);
    const tgtGPA = parseFloat(planTargetGPA.value);
    const futCr  = parseFloat(planFutureCredits.value);

    if (isNaN(curGPA) || isNaN(curCr) || isNaN(tgtGPA) || isNaN(futCr)) {
      planResult.classList.add('hidden');
      return;
    }
    if (curGPA < 0 || curGPA > 4 || tgtGPA < 0 || tgtGPA > 4 || curCr < 0 || futCr <= 0) {
      planResult.classList.add('hidden');
      return;
    }

    // Needed avg GPA = (target * (curCr + futCr) - curGPA * curCr) / futCr
    const neededQP = tgtGPA * (curCr + futCr) - curGPA * curCr;
    const neededGPA = neededQP / futCr;

    planResult.classList.remove('hidden');

    if (neededGPA > 4.0) {
      planResultText.innerHTML = `To reach a <strong>${tgtGPA.toFixed(2)} GPA</strong>, you would need a <strong>${neededGPA.toFixed(2)} GPA</strong> over your next ${futCr} credits — which exceeds 4.0. Consider extending your timeline or adjusting your target.`;
    } else if (neededGPA < 0) {
      planResultText.innerHTML = `You have already surpassed a <strong>${tgtGPA.toFixed(2)} GPA</strong>! Even a 0.0 semester GPA over the next ${futCr} credits would keep you above your target.`;
    } else {
      const letter = pointsToLetter(neededGPA);
      planResultText.innerHTML = `To reach a <strong>${tgtGPA.toFixed(2)} cumulative GPA</strong>, you need an average of <strong>${neededGPA.toFixed(2)} GPA</strong> (roughly a <strong>${letter}</strong> average) over your next <strong>${futCr} credits</strong>.`;
    }
  }

  [planCurrentGPA, planCurrentCredits, planTargetGPA, planFutureCredits].forEach(el => {
    el.addEventListener('input', recalcPlan);
  });

  // ── Reset ────────────────────────────────────────────────────────────────────

  function fullReset() {
    // Clear all semesters
    semestersContainer.innerHTML = '';
    semesterCounter = 0;
    courseCounter = 0;

    // Clear prev tab
    prevCoursesContainer.innerHTML = '';
    prevCourseCounter = 0;
    prevGPAInput.value = '';
    prevCreditsInput.value = '';

    // Reset toggles
    pctMode1 = false;
    noCredits1 = false;
    pctMode2 = false;
    noCredits2 = false;
    pctToggle1.checked = false;
    equalCreditsToggle.checked = false;
    pctToggle2.checked = false;
    equalCreditsToggle2.checked = false;
    if (gradeModeLabel1) gradeModeLabel1.textContent = 'Letter Grade';
    if (gradeModeLabel2) gradeModeLabel2.textContent = 'Letter Grade';

    // Reset result panel
    updateResultPanel({ primaryGPA: null, primaryLabel: 'Semester GPA', showCum: false, cumGPA: null, totalCr: 0, totalQP: 0 });

    // Re-add defaults
    addSemester();

    for (let i = 0; i < 4; i++) addPrevCourse();

    recalculate();
  }

  resetBtn.addEventListener('click', fullReset);

  // ── Share ────────────────────────────────────────────────────────────────────

  shareBtn.addEventListener('click', async () => {
    const gpaText = semGPAResult.textContent || '—';
    const url = window.location.href.split('?')[0];
    const shareURL = `${url}?gpa=${encodeURIComponent(gpaText)}`;

    const copy = async (text) => {
      if (navigator.clipboard?.writeText) {
        return navigator.clipboard.writeText(text);
      }
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.cssText = 'position:fixed;opacity:0';
      document.body.appendChild(ta);
      ta.focus(); ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    };

    try {
      await copy(shareURL);
      if (shareBtnText) shareBtnText.textContent = 'Copied!';
      shareToast.classList.remove('hidden');
      setTimeout(() => {
        if (shareBtnText) shareBtnText.textContent = 'Share Result';
        shareToast.classList.add('hidden');
      }, 2500);
    } catch {
      if (shareBtnText) shareBtnText.textContent = 'Copy failed';
      setTimeout(() => { if (shareBtnText) shareBtnText.textContent = 'Share Result'; }, 2000);
    }
  });

  printBtn.addEventListener('click', () => window.print());

  // ── FAQ accordion ────────────────────────────────────────────────────────────

  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(el => {
        el.classList.remove('open');
        el.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // ── Restore shared result ─────────────────────────────────────────────────────

  function restoreFromURL() {
    const params = new URLSearchParams(window.location.search);
    const sharedGPA = params.get('gpa');
    if (!sharedGPA || sharedGPA === '—') return;

    const banner = document.createElement('div');
    banner.className = 'callout callout-blue';
    banner.style.cssText = 'margin-bottom:1rem;font-size:0.875rem;';
    banner.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0" style="color:var(--color-brand)" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg><span>Shared result: <strong>${sharedGPA}</strong> GPA — enter your courses to recalculate.</span>`;
    const calcSection = document.getElementById('calculator');
    if (calcSection) calcSection.insertBefore(banner, calcSection.firstChild);
  }

  // ── Init ─────────────────────────────────────────────────────────────────────

  // Add one default semester with 4 courses
  addSemester();

  // Add 4 default courses for tab 2
  for (let i = 0; i < 4; i++) addPrevCourse();

  // Restore URL state if any
  restoreFromURL();

  // Initial calculation
  recalculate();

})();
</script>
