---
import Layout from '../layouts/Layout.astro';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "What If GPA Calculator",
  "url": "https://gpacalculatorfree.com/what-if-gpa-calculator",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "See exactly how your GPA will change based on future grades. Enter your current GPA and planned grades to simulate your new GPA instantly.",
  "featureList": [
    "Live before/after GPA comparison",
    "Unlimited future course rows",
    "Target GPA finder with required grade calculator",
    "All A's / All B's / All C's scenario comparison cards",
    "GPA change indicator with color-coded delta",
    "Dean's List and honor threshold proximity alerts"
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What does the What If GPA Calculator do?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The What If GPA Calculator lets you simulate how your planned future grades will change your cumulative GPA. Enter your current GPA and credits completed, then add upcoming courses with expected grades. The calculator instantly shows your projected new GPA, the change amount, and whether you're moving toward or away from key thresholds like Dean's List."
      }
    },
    {
      "@type": "Question",
      "name": "How much will my GPA go up if I get all A's?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The GPA boost from all A's depends on how many credits you've already completed. If you have 30 credits at a 2.8 GPA and take 15 credits of all A's (4.0), your new GPA would be (2.8×30 + 4.0×15) / 45 = 3.20 — an increase of 0.40 points. With 90 existing credits, the same semester of all A's would only raise your GPA by about 0.13 points. Use the simulator above to see your exact scenario."
      }
    },
    {
      "@type": "Question",
      "name": "What grades do I need to reach a 3.5 GPA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Enter your current GPA and total credits completed, then set the Target GPA to 3.5 and input the number of credits you plan to take. The calculator will instantly show the average grade points per credit you need to reach 3.5, and map that to the nearest letter grade. Generally, students with more existing credits need higher future grades to reach 3.5."
      }
    },
    {
      "@type": "Question",
      "name": "How many credits does it take to raise GPA significantly?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A useful rule of thumb is that one full semester of 15 credits typically moves your cumulative GPA by 0.1 to 0.3 points, depending on how many total credits you've already completed and the grade differential. Students earlier in their academic career (30–45 credits) see larger per-semester swings. Those approaching graduation with 100+ credits see smaller movements because each new semester represents a smaller fraction of total credits."
      }
    },
    {
      "@type": "Question",
      "name": "Can I recover from a bad GPA semester?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — recovery is absolutely possible, though it requires sustained strong performance. A single poor semester early in college (when you have fewer total credits) has a larger negative impact, but it also means you have more semesters ahead to correct it. The key insight is that your GPA is a weighted average: each future semester with grades above your current GPA will pull the average up. Use the What If simulator to model how many semesters of strong grades you'd need."
      }
    },
    {
      "@type": "Question",
      "name": "What will my GPA be if I get all A's next semester?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Use the simulator above. Enter your current GPA and the total credits you've completed so far, then add your upcoming courses using grade A for each. The result panel will immediately show your projected GPA along with the exact change amount. You can also use the scenario cards at the bottom which automatically compute all-A, all-B, and all-C outcomes side by side."
      }
    },
    {
      "@type": "Question",
      "name": "How is the projected GPA calculated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Projected GPA = (existing quality points + planned quality points) ÷ (current credits + planned credits). Existing quality points = current GPA × current credits. Planned quality points = sum of (grade points × course credits) for each future course. Grade points are A/A+=4.0, A−=3.7, B+=3.3, B=3.0, B−=2.7, C+=2.3, C=2.0, C−=1.7, D+=1.3, D=1.0, D−=0.7, F=0.0."
      }
    },
    {
      "@type": "Question",
      "name": "What if I drop a class — does that affect my GPA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A Withdrawal (W) grade typically does not affect your GPA at most US colleges and universities, since it carries no grade points. However, policies vary by institution — some schools require drops before a specific deadline to avoid the W entirely, and excessive withdrawals may trigger academic review. Always confirm your school's specific withdrawal and repeat-course policies. In the What If Calculator, simply do not add dropped courses to your planned course list."
      }
    }
  ]
};
---

<Layout
  title="What If GPA Calculator — See How Future Grades Will Change Your GPA"
  description="See exactly how your GPA will change based on future grades. Enter your current GPA and planned grades to simulate your new GPA instantly."
  canonical="/what-if-gpa-calculator"
  schema={[webAppSchema, faqSchema]}
>

  <!-- ══════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════ -->
  <section class="page-hero">
    <div class="max-w-6xl mx-auto px-4">

      <!-- Breadcrumb -->
      <nav class="breadcrumb mb-4" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        <span aria-current="page">What If GPA Calculator</span>
      </nav>

      <div class="max-w-3xl">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="badge badge-blue">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Unique Feature
          </span>
          <span class="badge badge-green">No Other Calculator Does This</span>
        </div>
        <h1 class="mb-3">What If GPA Calculator</h1>
        <p class="text-lg" style="color:var(--color-body)">
          The only GPA simulator that shows you <em>exactly</em> how your planned future grades will change your cumulative GPA — live, as you type. Enter your current GPA, add upcoming courses, and watch your projected GPA update in real time.
        </p>
        <!-- Use-case pills -->
        <div class="flex flex-wrap gap-2 mt-4">
          <span class="badge badge-blue">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Plan next semester
          </span>
          <span class="badge badge-blue">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            Model GPA recovery
          </span>
          <span class="badge badge-blue">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Target Dean's List
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       MAIN WHAT-IF SIMULATOR
  ══════════════════════════════════════════════ -->
  <section class="max-w-6xl mx-auto px-4 py-8" aria-labelledby="simulator-heading">
    <h2 id="simulator-heading" class="sr-only">What If GPA Simulator</h2>

    <div class="grid lg:grid-cols-[1fr_360px] gap-6 items-start">

      <!-- ── LEFT: Input panel ── -->
      <div class="card p-6">

        <!-- Section 1: Current Standing -->
        <div class="mb-6">
          <h3 class="text-base font-semibold mb-1" style="color:var(--color-ink)">Step 1: Your Current Standing</h3>
          <p class="text-sm mb-4" style="color:var(--color-mute)">Enter your existing GPA and total credits completed before the upcoming semester.</p>

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="current-gpa">Current GPA</label>
              <input
                type="number"
                id="current-gpa"
                class="input"
                placeholder="e.g. 3.20"
                min="0"
                max="4"
                step="0.01"
                aria-describedby="current-gpa-hint"
              />
              <p id="current-gpa-hint" class="text-xs mt-1" style="color:var(--color-mute)">Your GPA before planned courses</p>
            </div>
            <div>
              <label for="current-credits">Credits Completed</label>
              <input
                type="number"
                id="current-credits"
                class="input"
                placeholder="e.g. 45"
                min="0"
                max="999"
                step="1"
                aria-describedby="current-credits-hint"
              />
              <p id="current-credits-hint" class="text-xs mt-1" style="color:var(--color-mute)">Total graded credits earned so far</p>
            </div>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Section 2: Planned Courses -->
        <div>
          <h3 class="text-base font-semibold mb-1" style="color:var(--color-ink)">Step 2: Planned / Future Courses</h3>
          <p class="text-sm mb-4" style="color:var(--color-mute)">Add every course you plan to take. Select the grade you expect (or aim for) and the credit hours.</p>

          <!-- Column headers (desktop) -->
          <div class="hidden sm:grid gap-3 mb-2 px-1" style="grid-template-columns: 2fr 1.4fr 1fr auto;">
            <span class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-mute)">Course (optional)</span>
            <span class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-mute)">Expected Grade</span>
            <span class="text-xs font-semibold uppercase tracking-wide" style="color:var(--color-mute)">Credits</span>
            <span></span>
          </div>

          <!-- Course rows injected by JS -->
          <div id="whatif-course-rows" class="flex flex-col gap-3"></div>

          <button id="add-whatif-course" class="btn btn-ghost btn-sm mt-4 w-full sm:w-auto" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            Add Course
          </button>
        </div>

        <!-- Action row -->
        <div class="flex flex-wrap gap-2 mt-6 pt-5" style="border-top:1px solid var(--color-hairline)">
          <button id="whatif-reset" class="btn btn-secondary btn-sm" type="button">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
            Reset
          </button>
          <button id="whatif-share" class="btn btn-secondary btn-sm" type="button">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            Share Results
          </button>
        </div>
        <div id="whatif-share-toast" class="hidden mt-2 text-sm font-medium" style="color:var(--color-success)" role="status" aria-live="polite">
          Link copied to clipboard!
        </div>

      </div>

      <!-- ── RIGHT: Live result panel ── -->
      <div class="flex flex-col gap-4 lg:sticky lg:top-20">

        <!-- Star result panel -->
        <div class="result-panel" id="whatif-result-panel" style="background:var(--color-brand-bg);border:1px solid var(--color-brand-soft);border-radius:var(--radius-lg);padding:1.5rem;">
          <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--color-brand)">Projected GPA</p>

          <!-- Big before → after display -->
          <div class="flex items-center gap-3 mb-4 flex-wrap">
            <div class="text-center">
              <p class="text-xs font-medium mb-1" style="color:var(--color-mute)">Before</p>
              <span id="wi-gpa-before" class="tabular text-3xl font-bold" style="color:var(--color-mute)">—</span>
            </div>

            <!-- Arrow -->
            <div class="flex flex-col items-center gap-1 px-1">
              <svg width="28" height="16" viewBox="0 0 28 16" fill="none" aria-hidden="true" style="color:var(--color-mute)">
                <path d="M0 8h24M20 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <!-- Delta badge -->
              <span id="wi-delta" class="tabular text-xs font-bold px-2 py-0.5 rounded-full" style="background:var(--color-canvas-soft-2);color:var(--color-mute)">+0.00</span>
            </div>

            <div class="text-center">
              <p class="text-xs font-medium mb-1" style="color:var(--color-mute)">After</p>
              <span id="wi-gpa-after" class="tabular text-3xl font-bold" style="color:var(--color-brand)">—</span>
            </div>
          </div>

          <!-- Label row -->
          <div class="flex items-center justify-between mb-4 text-sm">
            <span id="wi-label-before" class="font-medium" style="color:var(--color-mute)"></span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--color-mute)" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            <span id="wi-label-after" class="font-medium" style="color:var(--color-ink)"></span>
          </div>

          <!-- Before / After progress bars -->
          <div class="flex flex-col gap-2 mb-4">
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs" style="color:var(--color-mute)">Before</span>
                <span id="wi-pct-before-label" class="text-xs tabular" style="color:var(--color-mute)">0%</span>
              </div>
              <div class="gpa-meter-container" role="presentation">
                <div id="wi-bar-before" class="gpa-meter-fill" style="width:0%;opacity:0.45;"></div>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs" style="color:var(--color-mute)">After</span>
                <span id="wi-pct-after-label" class="text-xs tabular" style="color:var(--color-mute)">0%</span>
              </div>
              <div class="gpa-meter-container" role="presentation">
                <div id="wi-bar-after" class="gpa-meter-fill" style="width:0%;"></div>
              </div>
            </div>
          </div>

          <!-- Credits breakdown -->
          <div class="grid grid-cols-3 gap-2 text-center pt-3" style="border-top:1px solid var(--color-brand-soft)">
            <div>
              <p class="text-xs mb-1" style="color:var(--color-mute)">Current</p>
              <p id="wi-credits-current" class="tabular text-sm font-bold" style="color:var(--color-ink)">—</p>
              <p class="text-xs" style="color:var(--color-mute)">credits</p>
            </div>
            <div>
              <p class="text-xs mb-1" style="color:var(--color-mute)">Planned</p>
              <p id="wi-credits-planned" class="tabular text-sm font-bold" style="color:var(--color-ink)">—</p>
              <p class="text-xs" style="color:var(--color-mute)">credits</p>
            </div>
            <div>
              <p class="text-xs mb-1" style="color:var(--color-mute)">New Total</p>
              <p id="wi-credits-total" class="tabular text-sm font-bold" style="color:var(--color-brand)">—</p>
              <p class="text-xs" style="color:var(--color-mute)">credits</p>
            </div>
          </div>
        </div>

        <!-- Proximity callout -->
        <div id="wi-proximity-callout" class="callout callout-blue hidden">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5" style="color:var(--color-brand)" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="wi-proximity-text"></span>
        </div>

        <!-- GPA scale reference -->
        <div class="card-soft p-4">
          <p class="text-xs font-semibold uppercase tracking-wide mb-3" style="color:var(--color-mute)">GPA Thresholds</p>
          <div class="flex flex-col gap-1.5 text-xs">
            <div class="flex items-center justify-between">
              <span class="flex items-center gap-2"><span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#0070f3"></span>3.50 – 4.00</span>
              <span class="font-medium" style="color:#0070f3">Dean's List</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="flex items-center gap-2"><span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#16a34a"></span>3.00 – 3.49</span>
              <span class="font-medium" style="color:#16a34a">Good Standing</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="flex items-center gap-2"><span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#f5a623"></span>2.00 – 2.99</span>
              <span class="font-medium" style="color:#f5a623">Satisfactory</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="flex items-center gap-2"><span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#ee0000"></span>0.00 – 1.99</span>
              <span class="font-medium" style="color:#ee0000">Below Average</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       SCENARIO COMPARISON CARDS
  ══════════════════════════════════════════════ -->
  <section class="max-w-6xl mx-auto px-4 pb-4" id="scenario-section" aria-labelledby="scenario-heading">
    <h3 id="scenario-heading" class="text-base font-semibold mb-3" style="color:var(--color-ink)">
      Grade Scenario Comparison
      <span class="ml-2 text-xs font-normal" style="color:var(--color-mute)">(based on your planned credit hours)</span>
    </h3>
    <div class="grid sm:grid-cols-3 gap-4">

      <!-- All A's card -->
      <div class="card p-4 text-center" id="scenario-a">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center mx-auto mb-3" style="background:#eff6ff">
          <span class="text-lg font-bold" style="color:#0070f3">A</span>
        </div>
        <p class="text-xs font-semibold uppercase tracking-wide mb-1" style="color:var(--color-mute)">All A's (4.0)</p>
        <p id="scenario-a-gpa" class="tabular text-2xl font-bold mb-1" style="color:var(--color-mute)">—</p>
        <p id="scenario-a-delta" class="text-xs font-medium" style="color:var(--color-mute)">—</p>
        <p id="scenario-a-label" class="text-xs mt-1" style="color:var(--color-mute)">Enter your GPA + credits first</p>
      </div>

      <!-- All B's card -->
      <div class="card p-4 text-center" id="scenario-b">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center mx-auto mb-3" style="background:#f0fdf4">
          <span class="text-lg font-bold" style="color:#16a34a">B</span>
        </div>
        <p class="text-xs font-semibold uppercase tracking-wide mb-1" style="color:var(--color-mute)">All B's (3.0)</p>
        <p id="scenario-b-gpa" class="tabular text-2xl font-bold mb-1" style="color:var(--color-mute)">—</p>
        <p id="scenario-b-delta" class="text-xs font-medium" style="color:var(--color-mute)">—</p>
        <p id="scenario-b-label" class="text-xs mt-1" style="color:var(--color-mute)">Enter your GPA + credits first</p>
      </div>

      <!-- All C's card -->
      <div class="card p-4 text-center" id="scenario-c">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center mx-auto mb-3" style="background:#fffbeb">
          <span class="text-lg font-bold" style="color:#f5a623">C</span>
        </div>
        <p class="text-xs font-semibold uppercase tracking-wide mb-1" style="color:var(--color-mute)">All C's (2.0)</p>
        <p id="scenario-c-gpa" class="tabular text-2xl font-bold mb-1" style="color:var(--color-mute)">—</p>
        <p id="scenario-c-delta" class="text-xs font-medium" style="color:var(--color-mute)">—</p>
        <p id="scenario-c-label" class="text-xs mt-1" style="color:var(--color-mute)">Enter your GPA + credits first</p>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       TARGET GPA FINDER
  ══════════════════════════════════════════════ -->
  <section class="max-w-6xl mx-auto px-4 py-8" aria-labelledby="target-heading">
    <div class="card p-6">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
        <div>
          <span class="badge badge-yellow mb-2">Target GPA Finder</span>
          <h2 id="target-heading" class="text-xl font-bold" style="color:var(--color-ink)">What Average Grade Do I Need?</h2>
          <p class="text-sm mt-1" style="color:var(--color-mute)">Enter a target GPA and planned credits. The calculator will tell you what average grade you need to hit it.</p>
        </div>
      </div>

      <div class="grid sm:grid-cols-3 gap-4 mb-6">
        <div>
          <label for="target-gpa">My Target GPA is:</label>
          <input
            type="number"
            id="target-gpa"
            class="input"
            value="3.50"
            min="0"
            max="4"
            step="0.01"
            aria-describedby="target-gpa-hint"
          />
          <p id="target-gpa-hint" class="text-xs mt-1" style="color:var(--color-mute)">Goal GPA on a 4.0 scale</p>
        </div>
        <div>
          <label for="target-planned-credits">Credits I Plan to Take:</label>
          <input
            type="number"
            id="target-planned-credits"
            class="input"
            placeholder="e.g. 15"
            min="1"
            step="1"
            aria-describedby="target-credits-hint"
          />
          <p id="target-credits-hint" class="text-xs mt-1" style="color:var(--color-mute)">Future credits for this target</p>
        </div>
        <div class="sm:col-span-1 flex flex-col justify-end">
          <div id="target-result-box" class="card-soft p-4 h-full flex flex-col justify-center" aria-live="polite">
            <p class="text-xs font-semibold uppercase tracking-wide mb-1" style="color:var(--color-mute)">Required Average</p>
            <p id="target-needed-grade" class="text-xl font-bold" style="color:var(--color-ink)">—</p>
            <p id="target-needed-detail" class="text-xs mt-1" style="color:var(--color-mute)">Fill in your current GPA + credits above</p>
          </div>
        </div>
      </div>

      <!-- Comparison mini-cards: all A's / all B's -->
      <div class="grid sm:grid-cols-2 gap-4" id="target-compare-cards">
