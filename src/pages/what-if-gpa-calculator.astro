<!-- ══════════════════════════════════════════════
     VANILLA JS — WHAT IF CALCULATOR LOGIC
══════════════════════════════════════════════ -->
<script>
  // ── Grade point map ───────────────────────────────────────────────────────────
  const GRADE_POINTS: Record<string, number> = {
    'A+': 4.0, 'A': 4.0, 'A-': 3.7,
    'B+': 3.3, 'B': 3.0, 'B-': 2.7,
    'C+': 2.3, 'C': 2.0, 'C-': 1.7,
    'D+': 1.3, 'D': 1.0, 'D-': 0.7,
    'F':  0.0,
  };

  const GRADE_OPTIONS = ['A+','A','A-','B+','B','B-','C+','C','C-','D+','D','D-','F'];

  function gradeOptionsHTML(selected = 'A'): string {
    return GRADE_OPTIONS.map(g =>
      `<option value="${g}"${g === selected ? ' selected' : ''}>${g}</option>`
    ).join('');
  }

  function fmt(v: number | null): string {
    if (v === null || isNaN(v)) return '—';
    return v.toFixed(2);
  }

  function gpaColor(gpa: number | null): string {
    if (gpa === null || isNaN(gpa)) return 'var(--color-mute)';
    if (gpa < 2.0) return '#ee0000';
    if (gpa < 3.0) return '#f5a623';
    if (gpa < 3.5) return '#16a34a';
    return '#0070f3';
  }

  function gpaLabel(gpa: number | null): string {
    if (gpa === null || isNaN(gpa)) return '';
    if (gpa >= 3.9) return 'Summa Cum Laude';
    if (gpa >= 3.7) return 'Magna Cum Laude';
    if (gpa >= 3.5) return "Dean's List";
    if (gpa >= 3.0) return 'Good Standing';
    if (gpa >= 2.0) return 'Satisfactory';
    if (gpa >= 1.0) return 'Below Average';
    return 'Failing';
  }

  function proximityMsg(gpa: number | null): string {
    if (gpa === null || isNaN(gpa)) return '';
    const thresholds = [
      { val: 4.0,  label: 'Perfect GPA (4.0)' },
      { val: 3.9,  label: 'Summa Cum Laude (3.9)' },
      { val: 3.7,  label: 'Magna Cum Laude (3.7)' },
      { val: 3.5,  label: "Dean's List (3.5)" },
      { val: 3.0,  label: 'Good Standing (3.0)' },
      { val: 2.0,  label: 'Passing (2.0)' },
    ];
    for (const t of thresholds) {
      if (gpa < t.val) {
        const diff = t.val - gpa;
        if (diff <= 0.30) {
          return `You are only ${diff.toFixed(2)} GPA points away from ${t.label} — you can make it!`;
        }
        break;
      }
    }
    return '';
  }

  function neededGradeLabel(needed: number): string {
    // Map needed grade points to nearest letter
    const table: [number, string][] = [
      [4.0, 'A / A+'], [3.85, 'A-'], [3.5, 'B+'], [3.15, 'B'],
      [2.85, 'B-'], [2.5, 'C+'], [2.15, 'C'], [1.85, 'C-'],
      [1.5, 'D+'], [1.15, 'D'], [0.85, 'D-'], [0, 'F'],
    ];
    for (const [threshold, label] of table) {
      if (needed >= threshold) return label;
    }
    return 'F';
  }

  // ── DOM refs ─────────────────────────────────────────────────────────────────
  const currentGPAInput     = document.getElementById('current-gpa') as HTMLInputElement;
  const currentCreditsInput = document.getElementById('current-credits') as HTMLInputElement;
  const courseRowsEl        = document.getElementById('whatif-course-rows')!;
  const addCourseBtn        = document.getElementById('add-whatif-course')!;
  const resetBtn            = document.getElementById('whatif-reset')!;
  const shareBtn            = document.getElementById('whatif-share')!;
  const shareToast          = document.getElementById('whatif-share-toast')!;

  const wiGpaBefore         = document.getElementById('wi-gpa-before')!;
  const wiGpaAfter          = document.getElementById('wi-gpa-after')!;
  const wiDelta             = document.getElementById('wi-delta')!;
  const wiLabelBefore       = document.getElementById('wi-label-before')!;
  const wiLabelAfter        = document.getElementById('wi-label-after')!;
  const wiBarBefore         = document.getElementById('wi-bar-before')!;
  const wiBarAfter          = document.getElementById('wi-bar-after')!;
  const wiPctBeforeLabel    = document.getElementById('wi-pct-before-label')!;
  const wiPctAfterLabel     = document.getElementById('wi-pct-after-label')!;
  const wiCreditsCurrent    = document.getElementById('wi-credits-current')!;
  const wiCreditsPlanned    = document.getElementById('wi-credits-planned')!;
  const wiCreditsTotal      = document.getElementById('wi-credits-total')!;
  const wiProximCallout     = document.getElementById('wi-proximity-callout')!;
  const wiProximText        = document.getElementById('wi-proximity-text')!;

  // Scenario cards
  const scnAGpa    = document.getElementById('scenario-a-gpa')!;
  const scnADelta  = document.getElementById('scenario-a-delta')!;
  const scnALabel  = document.getElementById('scenario-a-label')!;
  const scnBGpa    = document.getElementById('scenario-b-gpa')!;
  const scnBDelta  = document.getElementById('scenario-b-delta')!;
  const scnBLabel  = document.getElementById('scenario-b-label')!;
  const scnCGpa    = document.getElementById('scenario-c-gpa')!;
  const scnCDelta  = document.getElementById('scenario-c-delta')!;
  const scnCLabel  = document.getElementById('scenario-c-label')!;
  const scnACard   = document.getElementById('scenario-a')!;
  const scnBCard   = document.getElementById('scenario-b')!;
  const scnCCard   = document.getElementById('scenario-c')!;

  // Target GPA finder
  const targetGPAInput     = document.getElementById('target-gpa') as HTMLInputElement;
  const targetCreditsInput = document.getElementById('target-planned-credits') as HTMLInputElement;
  const targetNeededGrade  = document.getElementById('target-needed-grade')!;
  const targetNeededDetail = document.getElementById('target-needed-detail')!;
  const targetAllA         = document.getElementById('target-all-a')!;
  const targetAllB         = document.getElementById('target-all-b')!;

  // ── State ────────────────────────────────────────────────────────────────────
  let courseCounter = 0;

  // ── Course rows ───────────────────────────────────────────────────────────────
  function createCourseRow(id: number): HTMLElement {
    const div = document.createElement('div');
    div.className = 'course-row fade-in';
    div.id = `wi-row-${id}`;
    div.style.cssText = 'grid-template-columns: 2fr 1.4fr 1fr auto;';
    div.innerHTML = `
      <div>
        <label class="sm:hidden text-xs" for="wi-name-${id}">Course</label>
        <input
          type="text"
          id="wi-name-${id}"
          class="input"
          placeholder="e.g. MATH 301 (optional)"
          aria-label="Course name (optional)"
        />
      </div>
      <div>
        <label class="sm:hidden text-xs" for="wi-grade-${id}">Expected Grade</label>
        <select
          id="wi-grade-${id}"
          class="input"
          aria-label="Expected grade"
          data-wi-id="${id}"
        >${gradeOptionsHTML('A')}</select>
      </div>
      <div>
        <label class="sm:hidden text-xs" for="wi-credits-${id}">Credits</label>
        <input
          type="number"
          id="wi-credits-${id}"
          class="input"
          placeholder="3"
          min="0"
          step="0.5"
          aria-label="Credit hours"
          data-wi-id="${id}"
        />
      </div>
      <div class="flex items-end">
        <button
          type="button"
          class="btn btn-danger btn-sm"
          aria-label="Remove course"
          data-wi-remove="${id}"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    `;
    return div;
  }

  function addCourseRow() {
    const row = createCourseRow(courseCounter);
    courseRowsEl.appendChild(row);

    row.querySelectorAll('input[data-wi-id], select[data-wi-id]').forEach(el => {
      el.addEventListener('input', recalculate);
      el.addEventListener('change', recalculate);
    });

    const removeBtn = row.querySelector(`[data-wi-remove="${courseCounter}"]`);
    removeBtn?.addEventListener('click', () => {
      row.remove();
      recalculate();
    });

    courseCounter++;
    recalculate();
  }

  addCourseBtn.addEventListener('click', addCourseRow);

  // ── Collect planned courses ───────────────────────────────────────────────────
  function getPlannedData(): { totalQP: number; totalCredits: number } {
    let totalQP = 0;
    let totalCredits = 0;

    courseRowsEl.querySelectorAll('.course-row').forEach(row => {
      const id      = row.id.replace('wi-row-', '');
      const gradeEl = row.querySelector(`#wi-grade-${id}`) as HTMLSelectElement;
      const crEl    = row.querySelector(`#wi-credits-${id}`) as HTMLInputElement;
      const grade   = gradeEl?.value;
      const cr      = parseFloat(crEl?.value);

      if (grade && !isNaN(cr) && cr > 0 && GRADE_POINTS[grade] !== undefined) {
        totalQP      += GRADE_POINTS[grade] * cr;
        totalCredits += cr;
      }
    });

    return { totalQP, totalCredits };
  }

  // ── Main recalculation ────────────────────────────────────────────────────────
  function recalculate() {
    const currentGPA     = parseFloat(currentGPAInput.value);
    const currentCredits = parseFloat(currentCreditsInput.value);
    const { totalQP: plannedQP, totalCredits: plannedCredits } = getPlannedData();

    const hasCurrentGPA     = !isNaN(currentGPA) && currentGPA >= 0 && currentGPA <= 4;
    const hasCurrentCredits = !isNaN(currentCredits) && currentCredits >= 0;
    const hasPlanned        = plannedCredits > 0;

    let projectedGPA: number | null = null;
    let beforeGPA: number | null    = hasCurrentGPA ? currentGPA : null;

    if (hasCurrentGPA && hasCurrentCredits && hasPlanned) {
      const existingQP = currentGPA * currentCredits;
      const totalQP    = existingQP + plannedQP;
      const totalCr    = currentCredits + plannedCredits;
      projectedGPA     = Math.round((totalQP / totalCr) * 10000) / 10000;
    } else if (!hasCurrentGPA && !hasCurrentCredits && hasPlanned) {
      // Only planned data — show planned-only semester GPA
      projectedGPA = Math.round((plannedQP / plannedCredits) * 10000) / 10000;
    }

    updateResultPanel(beforeGPA, projectedGPA, hasCurrentCredits ? currentCredits : 0, plannedCredits);
    updateScenarioCards(beforeGPA, hasCurrentCredits ? currentCredits : 0, plannedCredits);
    updateTargetFinder();
  }

  // ── Update main result panel ──────────────────────────────────────────────────
  function updateResultPanel(
    before: number | null,
    after: number | null,
    currentCr: number,
    plannedCr: number
  ) {
    // Before GPA
    wiGpaBefore.textContent = fmt(before);
    wiGpaBefore.style.color = before !== null ? gpaColor(before) : 'var(--color-mute)';

    // After GPA
    wiGpaAfter.textContent = fmt(after);
    wiGpaAfter.style.color = after !== null ? gpaColor(after) : 'var(--color-brand)';

    // Delta badge
    if (before !== null && after !== null) {
      const delta = after - before;
      const sign  = delta > 0 ? '+' : '';
      wiDelta.textContent = `${sign}${delta.toFixed(2)}`;
      if (Math.abs(delta) < 0.005) {
        wiDelta.style.background = 'var(--color-canvas-soft-2)';
        wiDelta.style.color      = 'var(--color-mute)';
      } else if (delta > 0) {
        wiDelta.style.background = '#dcfce7';
        wiDelta.style.color      = '#16a34a';
      } else {
        wiDelta.style.background = '#fee2e2';
        wiDelta.style.color      = '#ee0000';
      }
    } else if (after !== null && before === null) {
      wiDelta.textContent      = fmt(after);
      wiDelta.style.background = 'var(--color-brand-bg)';
      wiDelta.style.color      = 'var(--color-brand)';
    } else {
      wiDelta.textContent      = '+0.00';
      wiDelta.style.background = 'var(--color-canvas-soft-2)';
      wiDelta.style.color      = 'var(--color-mute)';
    }

    // Labels
    wiLabelBefore.textContent = before !== null ? gpaLabel(before) : '';
    wiLabelAfter.textContent  = after  !== null ? gpaLabel(after)  : '';

    // Progress bars
    const beforePct = before !== null ? Math.min((before / 4) * 100, 100) : 0;
    const afterPct  = after  !== null ? Math.min((after  / 4) * 100, 100) : 0;

    wiBarBefore.style.width      = `${beforePct}%`;
    wiBarBefore.style.background = before !== null ? gpaColor(before) : 'var(--color-mute)';
    wiPctBeforeLabel.textContent = before !== null ? `${before.toFixed(2)} / 4.00` : '—';

    wiBarAfter.style.width      = `${afterPct}%`;
    wiBarAfter.style.background = after !== null ? gpaColor(after) : 'var(--color-brand)';
    wiPctAfterLabel.textContent = after !== null ? `${after.toFixed(2)} / 4.00` : '—';

    // Credits breakdown
    wiCreditsCurrent.textContent = currentCr > 0 ? currentCr.toString() : '—';
    wiCreditsPlanned.textContent = plannedCr > 0 ? plannedCr.toString() : '—';
    wiCreditsTotal.textContent   = (currentCr + plannedCr) > 0 ? (currentCr + plannedCr).toString() : '—';

    // Proximity callout
    const msg = after !== null ? proximityMsg(after) : '';
    if (msg) {
      wiProximCallout.classList.remove('hidden');
      wiProximText.textContent = msg;
    } else {
      wiProximCallout.classList.add('hidden');
    }
  }

  // ── Scenario cards ────────────────────────────────────────────────────────────
  function calcScenarioGPA(before: number | null, beforeCr: number, plannedCr: number, gradePoints: number): number | null {
    if (plannedCr <= 0) return null;
    if (before !== null && beforeCr > 0) {
      const existingQP = before * beforeCr;
      const newQP      = gradePoints * plannedCr;
      return Math.round(((existingQP + newQP) / (beforeCr + plannedCr)) * 10000) / 10000;
    }
    if (before === null || beforeCr === 0) {
      // Only planned scenario
      return gradePoints;
    }
    return null;
  }

  function styleScenarioCard(
    card: HTMLElement,
    gpaEl: HTMLElement,
    deltaEl: HTMLElement,
    labelEl: HTMLElement,
    gpa: number | null,
    before: number | null
  ) {
    if (gpa === null) {
      gpaEl.textContent   = '—';
      gpaEl.style.color   = 'var(--color-mute)';
      deltaEl.textContent = '—';
      deltaEl.style.color = 'var(--color-mute)';
      labelEl.textContent = 'Enter your GPA + credits first';
      card.style.borderColor = '';
      return;
    }

    gpaEl.textContent  = fmt(gpa);
    gpaEl.style.color  = gpaColor(gpa);
    labelEl.textContent = gpaLabel(gpa);

    if (before !== null) {
      const delta = gpa - before;
      const sign  = delta > 0 ? '+' : '';
      deltaEl.textContent = `${sign}${delta.toFixed(2)}`;
      deltaEl.style.color = delta > 0 ? '#16a34a' : (delta < 0 ? '#ee0000' : 'var(--color-mute)');
    } else {
      deltaEl.textContent = '';
      deltaEl.style.color = 'var(--color-mute)';
    }

    // Border color
    const c = gpaColor(gpa);
    card.style.borderColor = c;
    card.style.borderWidth = '2px';
  }

  function updateScenarioCards(before: number | null, beforeCr: number, plannedCr: number) {
    const aGpa = calcScenarioGPA(before, beforeCr, plannedCr, 4.0);
    const bGpa = calcScenarioGPA(before, beforeCr, plannedCr, 3.0);
    const cGpa = calcScenarioGPA(before, beforeCr, plannedCr, 2.0);

    styleScenarioCard(scnACard, scnAGpa, scnADelta, scnALabel, aGpa, before);
    styleScenarioCard(scnBCard, scnBGpa, scnBDelta, scnBLabel, bGpa, before);
    styleScenarioCard(scnCCard, scnCGpa, scnCDelta, scnCLabel, cGpa, before);
  }

  // ── Target GPA Finder ─────────────────────────────────────────────────────────
  function updateTargetFinder() {
    const targetGPA      = parseFloat(targetGPAInput.value);
    const targetCr       = parseFloat(targetCreditsInput.value);
    const currentGPA     = parseFloat(currentGPAInput.value);
    const currentCredits = parseFloat(currentCreditsInput.value);

    const hasTarget    = !isNaN(targetGPA) && targetGPA >= 0 && targetGPA <= 4;
    const hasTargetCr  = !isNaN(targetCr) && targetCr > 0;
    const hasCurrent   = !isNaN(currentGPA) && currentGPA >= 0 && currentGPA <= 4;
    const hasCurrentCr = !isNaN(currentCredits) && currentCredits >= 0;

    // Target-finder all-A / all-B projections
    if (hasCurrent && hasCurrentCr && hasTargetCr) {
      const aGpa = calcScenarioGPA(currentGPA, currentCredits, targetCr, 4.0);
      const bGpa = calcScenarioGPA(currentGPA, currentCredits, targetCr, 3.0);
      targetAllA.textContent = aGpa !== null ? `GPA → ${fmt(aGpa)} (${gpaLabel(aGpa)})` : 'GPA → —';
      targetAllB.textContent = bGpa !== null ? `GPA → ${fmt(bGpa)} (${gpaLabel(bGpa)})` : 'GPA → —';
    } else {
      targetAllA.textContent = 'GPA → —';
      targetAllB.textContent = 'GPA → —';
    }

    if (!hasTarget || !hasTargetCr || !hasCurrent || !hasCurrentCr) {
      targetNeededGrade.textContent  = '—';
      targetNeededDetail.textContent = 'Fill in your current GPA + credits above';
      return;
    }

    // needed_avg = (target_gpa × (current + planned) - current_gpa × current) / planned
    const totalCrNeeded = currentCredits + targetCr;
    const needed        = (targetGPA * totalCrNeeded - currentGPA * currentCredits) / targetCr;

    if (needed > 4.0) {
      targetNeededGrade.textContent  = 'Not possible';
      targetNeededDetail.textContent = `You would need a ${needed.toFixed(2)} average — above the 4.0 maximum. Consider more credit hours or a lower target.`;
      targetNeededGrade.style.color  = 'var(--color-error)';
    } else if (needed < 0) {
      targetNeededGrade.textContent  = 'Any grade works';
      targetNeededDetail.textContent = `Even if you get F's, you would still exceed your ${targetGPA.toFixed(2)} target. Consider aiming higher.`;
      targetNeededGrade.style.color  = 'var(--color-success)';
    } else {
      const letter = neededGradeLabel(needed);
      targetNeededGrade.textContent  = `${letter} avg (${needed.toFixed(2)} GPA pts)`;
      targetNeededDetail.textContent = `You need an average of ${letter} across ${targetCr} planned credits to reach your ${targetGPA.toFixed(2)} target GPA.`;
      targetNeededGrade.style.color  = 'var(--color-ink)';
    }
  }

  // ── Event listeners ───────────────────────────────────────────────────────────
  currentGPAInput.addEventListener('input', recalculate);
  currentCreditsInput.addEventListener('input', recalculate);
  targetGPAInput.addEventListener('input', updateTargetFinder);
  targetCreditsInput.addEventListener('input', updateTargetFinder);

  // ── Reset ────────────────────────────────────────────────────────────────────
  resetBtn.addEventListener('click', () => {
    currentGPAInput.value     = '';
    currentCreditsInput.value = '';
    courseRowsEl.innerHTML    = '';
    courseCounter             = 0;

    // Reset result panel
    updateResultPanel(null, null, 0, 0);
    updateScenarioCards(null, 0, 0);
    updateTargetFinder();

    // Add 3 fresh rows
    addCourseRow();
    addCourseRow();
    addCourseRow();
  });

  // ── Share ─────────────────────────────────────────────────────────────────────
  shareBtn.addEventListener('click', async () => {
    const gpa  = wiGpaAfter.textContent || '—';
    const delta = wiDelta.textContent || '—';
    const url  = window.location.href.split('?')[0];
    const encoded = btoa(JSON.stringify({ gpa, delta }));
    const shareURL = `${url}?r=${encoded}`;

    try {
      await navigator.clipboard.writeText(shareURL);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = shareURL;
      ta.style.cssText = 'position:fixed;opacity:0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    }

    shareToast.classList.remove('hidden');
    setTimeout(() => shareToast.classList.add('hidden'), 3000);
  });

  // ── FAQ accordion ─────────────────────────────────────────────────────────────
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item   = btn.closest('.faq-item')!;
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(el => {
        el.classList.remove('open');
        el.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // ── Init ──────────────────────────────────────────────────────────────────────
  addCourseRow();
  addCourseRow();
  addCourseRow();

  // Pre-populate from URL params if present
  function restoreFromURL() {
    const params = new URLSearchParams(window.location.search);
    const r = params.get('r');
    if (!r) return;
    try {
      const data = JSON.parse(atob(r));
      if (data?.gpa && data.gpa !== '—') {
        wiGpaAfter.textContent = data.gpa;
      }
    } catch {
      // ignore
    }
  }

  restoreFromURL();
</script>
