---
import Layout from '../layouts/Layout.astro';
const uniName = "University of Florida (UF)";
const slug = "uf-gpa-calculator";
const keyword = "uf gpa calculator";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What GPA do you need for Dean's List at UF?",
      "acceptedAnswer": { "@type": "Answer", "text": "To qualify for Dean's List at the University of Florida, you need at least a 3.5 GPA with 12 or more graded credit hours completed in the semester. The Dean's List is awarded each semester, not cumulatively." }
    },
    {
      "@type": "Question",
      "name": "What is UF's academic probation GPA?",
      "acceptedAnswer": { "@type": "Answer", "text": "Any UF student whose cumulative GPA falls below 2.0 is placed on academic probation. Students on probation must raise their cumulative GPA to 2.0 or above by the end of the following semester or face academic suspension." }
    },
    {
      "@type": "Question",
      "name": "What GPA do you need to graduate from UF?",
      "acceptedAnswer": { "@type": "Answer", "text": "A minimum cumulative GPA of 2.0 is required to earn any undergraduate degree from the University of Florida. Some majors and colleges at UF require a higher minimum GPA — check your specific program requirements." }
    },
    {
      "@type": "Question",
      "name": "Does UF have a grade forgiveness policy?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. UF allows students to retake up to three courses under grade forgiveness. Only the better grade counts toward your GPA, though both grades remain on your transcript. This policy can significantly improve your cumulative GPA if you retake courses where you earned a D or F." }
    },
    {
      "@type": "Question",
      "name": "What GPA do you need to get into UF as a freshman?",
      "acceptedAnswer": { "@type": "Answer", "text": "The middle 50% of admitted UF freshmen have a weighted high school GPA between 4.4 and 4.6. UF is highly selective — a strong GPA combined with rigorous coursework (AP/IB) is important. Check UF's admissions website for the most current statistics." }
    }
  ]
};
---
<Layout
  title="UF GPA Calculator — University of Florida GPA Calculator (Free)"
  description="Calculate your University of Florida GPA instantly. Free UF GPA calculator using the standard 4.0 scale. Works for all UF colleges and degree programs."
  canonical={`/${slug}`}
  schema={faqSchema}
>
  <section class="page-hero">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="breadcrumb mb-4"><a href="/">Home</a><span class="sep">/</span><span>UF GPA Calculator</span></nav>
      <h1 class="mb-3">University of Florida GPA Calculator</h1>
      <p class="text-lg mb-4" style="color:var(--color-body);max-width:580px">Calculate your UF GPA instantly using the standard 4.0 scale. Enter your courses, grades, and credit hours for semester and cumulative GPA.</p>
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-blue">University of Florida</span>
        <span class="badge badge-green">4.0 Scale</span>
        <span class="badge badge-blue">Free & Instant</span>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 py-6">
    <div class="callout callout-blue mb-6">
      <span>UF uses the standard 4.0 GPA scale. A=4.0, B=3.0, C=2.0, D=1.0, F=0. Plus/minus grades are used. Minimum 2.0 GPA required to remain in good academic standing.</span>
    </div>
  </section>

  <!-- Embed the standard calculator -->
  <section class="max-w-6xl mx-auto px-4 pb-8">
    <div class="grid lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2">
        <div class="card p-5">
          <h2 class="text-lg font-semibold mb-5" style="color:var(--color-ink)">Enter Your UF Courses</h2>
          <div class="hidden sm:grid gap-2 mb-2 px-3 text-xs font-medium uppercase tracking-wide" id="col-headers" style="color:var(--color-mute);grid-template-columns:2fr 1fr 1fr auto">
            <span>Course</span><span>Grade</span><span>Credits</span><span></span>
          </div>
          <div id="courses-container" class="flex flex-col gap-2"></div>
          <button id="add-btn" class="btn btn-ghost btn-sm mt-3 w-full" style="border:1px dashed var(--color-hairline-strong)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Add Course
          </button>
          <div class="flex gap-2 mt-4 pt-4 flex-wrap" style="border-top:1px solid var(--color-hairline)">
            <button id="reset-btn" class="btn btn-secondary btn-sm">Reset</button>
            <button id="print-btn" class="btn btn-secondary btn-sm">Print</button>
          </div>
        </div>
      </div>
      <div class="lg:col-span-1">
        <div class="result-panel sticky top-20 text-center">
          <div class="text-xs font-medium uppercase tracking-wide mb-2" style="color:var(--color-brand)">Your UF GPA</div>
          <div id="gpa-result" class="tabular font-bold mb-2" style="font-size:3.5rem;letter-spacing:-0.04em;color:var(--color-mute)">—</div>
          <div id="gpa-label" class="text-sm font-medium mb-3" style="color:var(--color-mute)">Enter courses above</div>
          <div class="gpa-meter-container mb-3"><div id="gpa-meter" class="gpa-meter-fill" style="width:0%"></div></div>
          <div id="proximity" class="text-xs" style="color:var(--color-brand);min-height:16px"></div>
          <div class="mt-4 pt-4 text-xs" style="border-top:1px solid var(--color-brand-soft);color:var(--color-body);text-align:left">
            <p class="font-semibold mb-2" style="color:var(--color-ink)">UF Academic Standing</p>
            <div class="space-y-1">
              <div class="flex justify-between"><span>Good Standing</span><span class="tabular font-medium">2.0+</span></div>
              <div class="flex justify-between"><span>Dean's List</span><span class="tabular font-medium">3.5+</span></div>
              <div class="flex justify-between"><span>Summa Cum Laude</span><span class="tabular font-medium">3.9+</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 py-6 prose pb-8">
    <h2>University of Florida GPA Information</h2>
    <p>The University of Florida (UF) uses the standard 4.0 GPA scale. All letter grades A through F are used, including plus and minus grades. UF requires a minimum cumulative GPA of 2.0 to maintain good academic standing. Students who fall below 2.0 may be placed on academic probation.</p>
    <p>UF's plus/minus grading system: A=4.0, A-=3.67, B+=3.33, B=3.0, B-=2.67, C+=2.33, C=2.0, C-=1.67, D+=1.33, D=1.0, D-=0.67, F=0. Note: UF uses 3.67 for A- (not 3.7), so results may vary slightly from standard calculations.</p>
    <p>For honors at graduation: Cum Laude typically requires 3.5+, Magna Cum Laude 3.7+, and Summa Cum Laude 3.9+. Check with UF's registrar for current requirements as policies may change.</p>
    <p>Use our <a href="/cumulative-gpa-calculator">Cumulative GPA Calculator</a> to track your GPA across all semesters, or the <a href="/what-if-gpa-calculator">What If GPA Calculator</a> to simulate how future grades will affect your UF GPA.</p>
  </section>

  <section class="max-w-3xl mx-auto px-4 pb-12" aria-labelledby="faq-uf">
    <h2 id="faq-uf" class="mb-6 text-xl font-semibold" style="color:var(--color-ink)">UF GPA — Frequently Asked Questions</h2>
    <div>
      <div class="faq-item open">
        <button class="faq-question" type="button" aria-expanded="true">What GPA do you need for Dean's List at UF?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="faq-answer">To qualify for Dean's List at the University of Florida, you need at least a 3.5 GPA with 12 or more graded credit hours completed in the semester. The Dean's List is awarded each semester, not cumulatively.</div>
      </div>
      <div class="faq-item">
        <button class="faq-question" type="button" aria-expanded="false">What is UF's academic probation GPA?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="faq-answer">Any UF student whose cumulative GPA falls below 2.0 is placed on academic probation. Students on probation must raise their cumulative GPA to 2.0 or above by the end of the following semester or face academic suspension.</div>
      </div>
      <div class="faq-item">
        <button class="faq-question" type="button" aria-expanded="false">What GPA do you need to graduate from UF?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="faq-answer">A minimum cumulative GPA of 2.0 is required to earn any undergraduate degree from the University of Florida. Some majors and colleges at UF require a higher minimum GPA — check your specific program requirements.</div>
      </div>
      <div class="faq-item">
        <button class="faq-question" type="button" aria-expanded="false">Does UF have a grade forgiveness policy?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="faq-answer">Yes. UF allows students to retake up to three courses under grade forgiveness. Only the better grade counts toward your GPA, though both grades remain on your transcript. This can significantly improve your cumulative GPA if you retake courses where you earned a D or F.</div>
      </div>
      <div class="faq-item">
        <button class="faq-question" type="button" aria-expanded="false">What GPA do you need to get into UF as a freshman?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        <div class="faq-answer">The middle 50% of admitted UF freshmen have a weighted high school GPA between 4.4 and 4.6. UF is highly selective — a strong GPA combined with rigorous coursework (AP/IB) is important. Check UF's admissions website for the most current statistics.</div>
      </div>
    </div>
  </section>
</Layout>

<script>
document.querySelectorAll('.faq-question').forEach(btn => {
  btn.addEventListener('click', () => {
    const item = btn.closest('.faq-item');
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(el => { el.classList.remove('open'); el.querySelector('.faq-question')?.setAttribute('aria-expanded','false'); });
    if (!isOpen) { item.classList.add('open'); btn.setAttribute('aria-expanded','true'); }
  });
});
</script>

<script>
(function(){
  const GP={'A+':4.0,'A':4.0,'A-':3.7,'B+':3.3,'B':3.0,'B-':2.7,'C+':2.3,'C':2.0,'C-':1.7,'D+':1.3,'D':1.0,'D-':0.7,'F':0.0};
  const GRADES=['A+','A','A-','B+','B','B-','C+','C','C-','D+','D','D-','F','P','W'];
  let count=0;
  const container=document.getElementById('courses-container');
  function gpaColor(g){if(g<2)return'#ee0000';if(g<3)return'#f5a623';if(g<3.5)return'#16a34a';return'#0070f3';}
  function gpaLabel(g){if(g>=3.9)return'Summa Cum Laude';if(g>=3.5)return"Dean's List";if(g>=3.0)return'Good Standing';if(g>=2.0)return'Satisfactory';return'Below 2.0 — At Risk';}
  function buildRow(){
    count++;
    const row=document.createElement('div');row.className='course-row';row.style.gridTemplateColumns='2fr 1fr 1fr auto';
    const name=document.createElement('input');name.type='text';name.placeholder=`Course ${count}`;name.className='input';name.style.fontSize='0.875rem';name.addEventListener('input',calc);
    const gs=document.createElement('select');gs.className='input';gs.style.fontSize='0.875rem';
    GRADES.forEach(g=>{const o=document.createElement('option');o.value=g;o.textContent=g;if(g==='A')o.selected=true;gs.appendChild(o);});
    gs.addEventListener('change',calc);
    const ci=document.createElement('input');ci.type='number';ci.min='0.5';ci.max='12';ci.step='0.5';ci.value='3';ci.className='input';ci.style.cssText='font-size:0.875rem;width:72px;text-align:center';ci.addEventListener('input',calc);
    const rm=document.createElement('button');rm.type='button';rm.className='btn btn-secondary btn-sm';rm.style.cssText='padding:0.375rem 0.5rem;color:var(--color-mute)';
    rm.innerHTML='<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    rm.addEventListener('click',()=>{row.remove();calc();});
    row.appendChild(name);row.appendChild(gs);row.appendChild(ci);row.appendChild(rm);return row;
  }
  function add(){container.appendChild(buildRow());calc();}
  function calc(){
    const rows=container.querySelectorAll('.course-row');let tQP=0,tCr=0;
    rows.forEach(row=>{
      const gs=row.querySelector('select');const ci=row.querySelector('input[type="number"]');
      if(!gs||!(gs.value in GP))return;
      const cr=parseFloat(ci?.value||'0');if(!cr||cr<=0)return;
      tQP+=GP[gs.value]*cr;tCr+=cr;
    });
    const res=document.getElementById('gpa-result');const lbl=document.getElementById('gpa-label');
    const meter=document.getElementById('gpa-meter');const prox=document.getElementById('proximity');
    if(tCr===0){if(res){res.textContent='—';res.style.color='var(--color-mute)';}if(lbl)lbl.textContent='Enter courses above';if(meter)meter.style.width='0%';if(prox)prox.textContent='';return;}
    const gpa=Math.round((tQP/tCr)*1000)/1000;const color=gpaColor(gpa);
    if(res){res.textContent=gpa.toFixed(2);res.style.color=color;}
    if(lbl){lbl.textContent=gpaLabel(gpa);lbl.style.color=color;}
    if(meter){meter.style.width=Math.min((gpa/4.0)*100,100)+'%';meter.style.background=color;}
    const thresholds=[{v:3.5,l:"Dean's List (3.5)"},{v:3.0,l:'Good Standing (3.0)'},{v:2.0,l:'Passing (2.0)'}];
    let proxMsg='';for(const t of thresholds){if(gpa<t.v){const d=(t.v-gpa).toFixed(2);if(parseFloat(d)<=0.3){proxMsg=`${d} away from ${t.l}`;break;}}}
    if(prox)prox.textContent=proxMsg;
  }
  document.getElementById('add-btn')?.addEventListener('click',add);
  document.getElementById('reset-btn')?.addEventListener('click',()=>{container.innerHTML='';count=0;for(let i=0;i<4;i++)add();});
  document.getElementById('print-btn')?.addEventListener('click',()=>window.print());
  for(let i=0;i<4;i++)add();
})();
</script>
