---
import Layout from '../layouts/Layout.astro';
import CalculatorSummary from '../components/CalculatorSummary.astro';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "High School GPA Calculator",
  "url": "https://gpacalculatorfree.com/high-school-gpa-calculator/",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Calculate your high school GPA with weighted and unweighted results. Supports AP, Honors, and IB courses. Free, instant, no signup required.",
  "featureList": [
    "Weighted and unweighted GPA calculated simultaneously",
    "Supports AP, Honors, IB, and Regular courses",
    "Multiple semester tracking with cumulative GPA",
    "Previous GPA inclusion mode",
    "No-credits equal-weight mode",
    "Percentage-to-letter-grade conversion",
    "Share and print results"
  ]
};

// Mirrors the calculator script at the bottom of this file. Keep both in sync.
const POINTS: Record<string, number> = {
  'A+': 4.0, 'A': 4.0, 'A-': 3.7,
  'B+': 3.3, 'B': 3.0, 'B-': 2.7,
  'C+': 2.3, 'C': 2.0, 'C-': 1.7,
  'D+': 1.3, 'D': 1.0, 'D-': 0.7,
  'F': 0.0,
};
const BONUS: Record<string, number> = { Regular: 0, Honors: 0.5, AP: 1.0, IB: 1.0 };
const MAX_WEIGHTED = 5.0;
// A failing grade earns no bonus, and no class is worth more than the maximum.
const weightedPoints = (points: number, type: string) =>
  points > 0 ? Math.min(points + BONUS[type], MAX_WEIGHTED) : 0;
// Same rounding as the calculator: three decimals, then two shown.
const fmt = (x: number) => (Math.round(x * 1000) / 1000).toFixed(2);
const one = (x: number) => x.toFixed(1);

// Grade-by-course-type table.
const typeRows = [
  { label: 'AP / IB', type: 'AP' },
  { label: 'Honors', type: 'Honors' },
  { label: 'Regular', type: 'Regular' },
].flatMap(({ label, type }) =>
  ['A', 'B', 'C'].map((grade) => ({
    label, grade,
    unweighted: one(POINTS[grade]),
    weighted: one(weightedPoints(POINTS[grade], type)),
  })));

// One student, six classes, different credits.
type Course = { name: string; type: string; grade: string; credits: number; core: boolean };
const courses: Course[] = [
  { name: 'English 11', type: 'Honors', grade: 'A-', credits: 1, core: true },
  { name: 'U.S. History', type: 'AP', grade: 'B+', credits: 1, core: true },
  { name: 'Calculus AB', type: 'AP', grade: 'B-', credits: 1, core: true },
  { name: 'Chemistry', type: 'Honors', grade: 'A', credits: 1, core: true },
  { name: 'Spanish III', type: 'Regular', grade: 'A-', credits: 1, core: true },
  { name: 'Physical education', type: 'Regular', grade: 'A', credits: 0.5, core: false },
];
const exampleRows = courses.map((c) => {
  const points = POINTS[c.grade];
  return { ...c,
    uwQp: one(points * c.credits),
    wQp: one(weightedPoints(points, c.type) * c.credits) };
});
const gpaFor = (list: Course[], ignorePlusMinus = false) => {
  let credits = 0, uw = 0, w = 0;
  for (const c of list) {
    const points = POINTS[ignorePlusMinus ? c.grade[0] : c.grade];
    credits += c.credits;
    uw += points * c.credits;
    w += weightedPoints(points, c.type) * c.credits;
  }
  return { credits, uwQp: uw, wQp: w, uw: fmt(uw / credits), w: fmt(w / credits) };
};
const base = gpaFor(courses);
const ruleSets = [
  { label: "This calculator's rules", ...base },
  { label: 'No plus or minus grades (A- scores 4.0, B+ and B- score 3.0)', ...gpaFor(courses, true) },
  { label: 'Core classes only (physical education left out)', ...gpaFor(courses.filter((c) => c.core)) },
];
const apBMinus = one(weightedPoints(POINTS['B-'], 'AP'));

const faq = [
  {
    q: "What is the difference between weighted and unweighted high school GPA?",
    a: "An unweighted GPA uses a fixed 4.0 scale, so an A is worth 4.0 in every class. A weighted GPA adds points for harder classes. In this calculator honors adds 0.5 and AP or IB adds 1.0, so an A is worth 4.5 in honors and 5.0 in AP or IB. The weighted maximum is 5.0.",
  },
  {
    q: "How is weighted high school GPA calculated?",
    a: "For each passing class, add the course bonus to the grade points. Multiply the result by the class's credits, add up all the classes and divide by total credits. A B+ in an AP class, for example, is worth 3.3 plus 1.0, which is 4.3 points. No class is worth more than 5.0, and an F always stays at 0.",
  },
  {
    q: "Do colleges look at weighted or unweighted GPA?",
    a: "Many colleges recalculate your GPA from your transcript using their own rules, often counting only core academic classes. Some publish how they do it, so check the admissions page of each college you are applying to. They also see which courses you took, so a harder schedule can say more than the number alone.",
  },
  {
    q: "Can I calculate GPA without credit hours?",
    a: "Yes. Turn on the No Credits toggle in a semester and every class in it counts equally, so your GPA is a simple average of the grade points. This suits schools that give every class the same weight, or students who do not know their credits.",
  },
  {
    q: "What is the highest possible weighted GPA?",
    a: "On the scale this calculator uses, it is 5.0: an A or A+ in every AP or IB class. A school with a different bonus or a different maximum can have a different top number, so check your own school's policy.",
  },
  {
    q: "How do AP courses affect my GPA?",
    a: "On this scale an AP class adds 1.0 to the grade points, so an A is worth 5.0 weighted and a B is worth 4.0 weighted, the same as an A in a regular class. Your unweighted GPA ignores the bonus and uses only the letter grade.",
  },
  {
    q: "Is a 4.0 GPA weighted or unweighted?",
    a: "A 4.0 is a perfect unweighted GPA, which means straight A's. A weighted 4.0 is a different result: a student with B's in AP classes can reach about 4.0 weighted. Always check which scale a number comes from.",
  },
  {
    q: "What is a good high school GPA?",
    a: "There is no single cutoff. It depends on the college, the program and the rest of your application. For reference, a 3.0 unweighted GPA is a B average and 3.5 sits between a B+ and an A-. Look up the typical GPA of admitted students at each college you are considering, and compare it with your unweighted GPA, since many colleges recalculate.",
  },
  {
    q: "Do pass, fail and withdrawn classes count?",
    a: "In this calculator a P (pass) or W (withdrawn) is left out, so it neither raises nor lowers your GPA. An F counts as 0 points. Schools differ, so check how yours treats them.",
  },
  {
    q: "Does high school GPA include all 4 years?",
    a: "A cumulative high school GPA normally covers all four years, grades 9 to 12. Some colleges and scholarships look at grades 9 to 11 only, because senior year grades may not exist yet when you apply. Add a semester for each term in the calculator to see how every year moves your cumulative GPA.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a },
  })),
};
---

<Layout
  title="High School GPA Calculator: Weighted & Unweighted (Free)"
  description="Calculate your weighted and unweighted high school GPA with AP, honors and IB points. Includes a worked example and how school scales change the result."
  canonical="/high-school-gpa-calculator"
  schema={[webAppSchema, faqSchema]}
>

  <!-- ══════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════ -->
  <section class="page-hero" aria-label="High School GPA Calculator Hero">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <!-- Breadcrumb -->
      <nav class="breadcrumb justify-center mb-5" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        <span aria-current="page">High School GPA Calculator</span>
      </nav>

      <!-- Badges -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-5" aria-label="Feature highlights">
        <span class="badge badge-blue">Weighted + Unweighted</span>
        <span class="badge badge-green">AP / Honors / IB</span>
        <span class="badge" style="background: var(--color-canvas-soft-2); color: var(--color-body);">No Signup Required</span>
        <span class="badge" style="background: var(--color-canvas-soft-2); color: var(--color-body);">Free Forever</span>
      </div>

      <h1 class="mb-4">
        High School GPA Calculator
      </h1>

      <p class="text-lg mb-2" style="color: var(--color-body); max-width: 580px; margin-left: auto; margin-right: auto; line-height: 1.65;">
        Enter your classes, grades and credits to get your <strong>unweighted</strong> GPA (4.0 scale) and your <strong>weighted</strong> GPA (5.0 scale) at once. Honors adds 0.5 and AP or IB adds 1.0.
      </p>
      <p class="text-sm mb-0" style="color: var(--color-mute);">
        Unweighted 4.0 scale &middot; Weighted 5.0 scale &middot; Works for all 4 years of high school
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       MAIN CALCULATOR
  ══════════════════════════════════════════════ -->
  <section class="max-w-6xl mx-auto px-4 py-8" aria-labelledby="hs-calc-heading" id="hs-calculator" data-calculator-root>
    <CalculatorSummary target="hs-full-result" />
    <div class="flex flex-col lg:flex-row gap-6 items-start">

      <!-- LEFT: Input column -->
      <div class="flex-1 min-w-0 w-full">

        <!-- Previous GPA toggle -->
        <div class="card p-4 mb-4" id="prev-gpa-section">
          <div class="flex items-center justify-between gap-3 flex-wrap">
            <div>
              <div class="font-semibold text-sm" style="color: var(--color-ink);">Include Previous GPA</div>
              <div class="text-xs mt-0.5" style="color: var(--color-mute);">Add existing GPA &amp; credits before this semester</div>
            </div>
            <label class="toggle" aria-label="Toggle previous GPA inclusion">
              <input type="checkbox" id="prev-gpa-toggle" />
              <span class="toggle-track"></span>
              <span class="toggle-thumb"></span>
            </label>
          </div>
          <div id="prev-gpa-inputs" class="hidden mt-4 grid grid-cols-2 gap-3">
            <div>
              <label for="prev-unweighted-gpa" class="text-xs font-medium" style="color: var(--color-mute);">Previous Unweighted GPA (4.0)</label>
              <input type="number" id="prev-unweighted-gpa" min="0" max="4" step="0.01" placeholder="e.g. 3.50" class="input mt-1" style="font-size: 0.875rem;" aria-label="Previous unweighted GPA" />
            </div>
            <div>
              <label for="prev-weighted-gpa" class="text-xs font-medium" style="color: var(--color-mute);">Previous Weighted GPA (5.0)</label>
              <input type="number" id="prev-weighted-gpa" min="0" max="5" step="0.01" placeholder="e.g. 4.10" class="input mt-1" style="font-size: 0.875rem;" aria-label="Previous weighted GPA" />
            </div>
            <div class="col-span-2">
              <label for="prev-credits" class="text-xs font-medium" style="color: var(--color-mute);">Previous Credit Hours</label>
              <input type="number" id="prev-credits" min="0" step="0.5" placeholder="e.g. 24" class="input mt-1" style="font-size: 0.875rem;" aria-label="Previous credit hours" />
            </div>
          </div>
        </div>

        <!-- Semesters container -->
        <div id="semesters-container">
          <!-- Semesters injected by JS -->
        </div>

        <!-- Add semester button -->
        <button
          id="add-semester-btn"
          type="button"
          class="btn btn-ghost btn-sm w-full mt-2"
          style="border: 1px dashed var(--color-hairline-strong); color: var(--color-brand);"
          aria-label="Add another semester"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          Add Semester
        </button>

      </div><!-- end left column -->

      <!-- RIGHT: Sticky result panel -->
      <div class="w-full lg:w-80 xl:w-96 shrink-0 lg:sticky lg:top-20" aria-live="polite" aria-atomic="true">

        <!-- Dual GPA result panel -->
        <div id="hs-full-result" data-full-result tabindex="-1" class="card p-0 overflow-hidden" style="box-shadow: var(--shadow-md);">

          <!-- Panel header -->
          <div class="px-5 py-3 border-b" style="background: var(--color-canvas-soft); border-color: var(--color-hairline);">
            <h2 id="hs-calc-heading" class="text-sm font-semibold m-0" style="color: var(--color-ink);">Your GPA Results</h2>
          </div>

          <!-- Empty state -->
          <div id="hs-empty-hint" class="px-5 py-8 text-center text-sm" style="color: var(--color-mute);">
            Add courses above and your GPA will appear here instantly.
          </div>

          <!-- Results (hidden until courses entered) -->
          <div id="hs-result-panel" class="hidden fade-in">

            <!-- TWO GPA displays side by side -->
            <div class="grid grid-cols-2 gap-0" style="border-bottom: 1px solid var(--color-hairline);">

              <!-- Unweighted GPA -->
              <div class="px-5 py-5" style="border-right: 1px solid var(--color-hairline);">
                <div class="text-xs font-semibold uppercase tracking-widest mb-1" style="color: var(--color-mute); font-family: var(--font-mono);">Unweighted</div>
                <div class="flex items-baseline gap-1.5">
                  <span id="uw-gpa-result" class="tabular" style="font-size: 2.5rem; font-weight: 700; line-height: 1; letter-spacing: -0.04em; color: var(--color-brand);">—</span>
                  <span class="text-sm font-medium" style="color: var(--color-mute);">/ 4.0</span>
                </div>
                <div id="uw-gpa-label" class="text-xs font-medium mt-1.5" style="color: var(--color-body); min-height: 1rem;"></div>
                <!-- UW progress bar -->
                <div class="mt-3">
                  <div class="gpa-meter-container" role="progressbar" aria-valuemin="0" aria-valuemax="4" aria-label="Unweighted GPA meter" style="height: 6px;">
                    <div id="uw-meter-fill" class="gpa-meter-fill" style="width: 0%; background: var(--color-brand);"></div>
                  </div>
                </div>
              </div>

              <!-- Weighted GPA -->
              <div class="px-5 py-5">
                <div class="text-xs font-semibold uppercase tracking-widest mb-1" style="color: var(--color-mute); font-family: var(--font-mono);">Weighted</div>
                <div class="flex items-baseline gap-1.5">
                  <span id="w-gpa-result" class="tabular" style="font-size: 2.5rem; font-weight: 700; line-height: 1; letter-spacing: -0.04em; color: var(--color-brand);">—</span>
                  <span class="text-sm font-medium" style="color: var(--color-mute);">/ 5.0</span>
                </div>
                <div id="w-gpa-label" class="text-xs font-medium mt-1.5" style="color: var(--color-body); min-height: 1rem;"></div>
                <!-- W progress bar -->
                <div class="mt-3">
                  <div class="gpa-meter-container" role="progressbar" aria-valuemin="0" aria-valuemax="5" aria-label="Weighted GPA meter" style="height: 6px;">
                    <div id="w-meter-fill" class="gpa-meter-fill" style="width: 0%; background: var(--color-brand);"></div>
                  </div>
                </div>
              </div>

            </div><!-- end grid -->

            <!-- Stats row -->
            <div class="grid grid-cols-2 gap-0" style="border-bottom: 1px solid var(--color-hairline);">
              <div class="px-5 py-3" style="border-right: 1px solid var(--color-hairline);">
                <div class="text-xs uppercase tracking-wide" style="color: var(--color-mute); font-family: var(--font-mono);">Total Credits</div>
                <div id="hs-total-credits" class="text-xl font-bold tabular mt-0.5" style="color: var(--color-ink);">0</div>
              </div>
              <div class="px-5 py-3">
                <div class="text-xs uppercase tracking-wide" style="color: var(--color-mute); font-family: var(--font-mono);">Quality Points</div>
                <div id="hs-total-qp" class="text-xl font-bold tabular mt-0.5" style="color: var(--color-ink);">0.00</div>
              </div>
            </div>

            <!-- Proximity / motivation message -->
            <div id="hs-proximity-msg" class="px-5 py-2.5 text-sm font-medium" style="color: var(--color-brand); min-height: 2.5rem; border-bottom: 1px solid var(--color-hairline);"></div>

            <!-- Action buttons -->
            <div class="flex flex-wrap gap-2 px-5 py-4">
              <button id="hs-share-btn" type="button" class="btn btn-secondary btn-sm" aria-label="Share your GPA result">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
                <span id="hs-share-text">Share</span>
              </button>
              <button id="hs-print-btn" type="button" class="btn btn-secondary btn-sm" aria-label="Print your GPA">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                Print
              </button>
              <button id="hs-reset-btn" type="button" class="btn btn-secondary btn-sm" aria-label="Reset calculator">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-5.07"/></svg>
                Reset
              </button>
            </div>

          </div><!-- end hs-result-panel -->
        </div>

        <!-- Scale reference card -->
        <div class="card-soft mt-4 p-4 text-xs" style="color: var(--color-mute);">
          <div class="font-semibold mb-2" style="color: var(--color-ink); font-size: 0.8rem;">Course Type Bonuses</div>
          <div class="grid grid-cols-2 gap-y-1.5">
            <span>Regular:</span><span class="font-mono font-medium" style="color: var(--color-body);">+0.0 (max 4.0)</span>
            <span>Honors:</span><span class="font-mono font-medium" style="color: var(--color-body);">+0.5 (max 4.5)</span>
            <span>AP:</span><span class="font-mono font-medium" style="color: var(--color-body);">+1.0 (max 5.0)</span>
            <span>IB:</span><span class="font-mono font-medium" style="color: var(--color-body);">+1.0 (max 5.0)</span>
          </div>
        </div>

      </div><!-- end right sticky column -->
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       HOW IT WORKS, WORKED EXAMPLE, SCHOOL DIFFERENCES
  ══════════════════════════════════════════════ -->
  <section class="max-w-3xl mx-auto px-4 py-8 prose">
    <h2 id="wvu-heading">Weighted vs. unweighted high school GPA</h2>
    <p>Your <strong>unweighted GPA</strong> uses a fixed 4.0 scale, so an A is worth 4.0 in every class. Your <strong>weighted GPA</strong> adds points for harder classes, so the same A is worth {one(weightedPoints(4, 'Honors'))} in honors and {one(weightedPoints(4, 'AP'))} in AP or IB. This calculator shows both at once. It adds {one(BONUS.Honors)} for honors and {one(BONUS.AP)} for AP and IB, with a maximum of {one(MAX_WEIGHTED)} for any class.</p>

    <table>
      <thead>
        <tr><th>Course type</th><th>Grade</th><th>Unweighted</th><th>Weighted</th></tr>
      </thead>
      <tbody>
        {typeRows.map((row) => (
          <tr><td>{row.label}</td><td>{row.grade}</td><td>{row.unweighted}</td><td><strong>{row.weighted}</strong></td></tr>
        ))}
      </tbody>
    </table>

    <p>Two things follow from this table. A B in an AP class is worth 4.0 weighted, the same as an A in a regular class. And the bonus is only added to passing grades, so an F stays at 0 in every class.</p>
    <p>Unweighted GPA is the number most often used to compare students from different schools. Weighted GPA shows that you took harder classes. Neither one is the GPA. Which one you need depends on the form, the scholarship or the college asking.</p>

    <h2 id="worked-example">Worked example: one student, two GPAs</h2>
    <p>Here is one semester with six classes. Each class has credits, and a 1-credit class counts twice as much as a half-credit class. Quality points are grade points multiplied by credits.</p>
    <div class="overflow-x-auto">
      <table>
        <thead>
          <tr><th>Class</th><th>Type</th><th>Grade</th><th>Credits</th><th>Unweighted quality points</th><th>Weighted quality points</th></tr>
        </thead>
        <tbody>
          {exampleRows.map((row) => (
            <tr><td>{row.name}</td><td>{row.type}</td><td>{row.grade}</td><td>{row.credits}</td><td>{row.uwQp}</td><td>{row.wQp}</td></tr>
          ))}
          <tr><td><strong>Total</strong></td><td></td><td></td><td><strong>{base.credits}</strong></td><td><strong>{one(base.uwQp)}</strong></td><td><strong>{one(base.wQp)}</strong></td></tr>
        </tbody>
      </table>
    </div>
    <ul>
      <li>Unweighted GPA: {one(base.uwQp)} ÷ {base.credits} = <strong>{base.uw}</strong></li>
      <li>Weighted GPA: {one(base.wQp)} ÷ {base.credits} = <strong>{base.w}</strong></li>
    </ul>
    <p>The B- in AP Calculus is the lowest grade here at 2.7 unweighted. With the AP bonus it is worth {apBMinus}, the same as the A- in regular Spanish. That is how a weighted scale rewards a harder schedule. You can enter these same classes in the calculator above to check the result.</p>

    <h2 id="school-scales">Why your school's GPA may not match this calculator</h2>
    <p>A calculator follows one set of rules. Your school follows its own, and small differences move the result:</p>
    <ul>
      <li><strong>Plus and minus grades.</strong> Some schools score an A- the same as an A, or give an A+ more than 4.0. This calculator scores A+ and A as 4.0, A- as 3.7 and B+ as 3.3.</li>
      <li><strong>Size of the bonus.</strong> Honors +0.5 and AP or IB +1.0 is a common model, but schools can use other bonuses or a different maximum.</li>
      <li><strong>Which classes count.</strong> Some schools leave out physical education, electives or pass/fail classes. Others count everything. Here, P and W grades are left out and every other class counts.</li>
      <li><strong>Rounding.</strong> Schools may round each semester, or round your final number differently.</li>
    </ul>
    <p>Here are the same six classes under three example rule sets. They are illustrations, not any one school's policy.</p>
    <div class="overflow-x-auto">
      <table>
        <thead>
          <tr><th>Rule set</th><th>Unweighted</th><th>Weighted</th></tr>
        </thead>
        <tbody>
          {ruleSets.map((row) => (
            <tr><td>{row.label}</td><td><strong>{row.uw}</strong></td><td><strong>{row.w}</strong></td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>The grades did not change, but the numbers did. If your school reports a different GPA, check the grading scale and weighting policy in your student handbook. For the standard letter-grade values, see the <a href="/gpa-scale/">GPA scale guide</a>. If your grades are percentages, the <a href="/percentage-to-gpa/">percentage to GPA guide</a> shows how they convert.</p>

    <h2 id="colleges">What colleges do with your GPA</h2>
    <p>Many colleges recalculate your GPA from your transcript using their own rules, often counting only core academic classes. Some publish how they do it, so check the admissions page of each college you are applying to. They also see which courses you took, so a harder schedule can say more than the number alone.</p>
    <p>If you only know a weighted number, <a href="/weighted-to-unweighted-gpa/">see why it cannot be turned into one exact unweighted GPA</a>.</p>

    <h2 id="how-to-enter">How to enter your grades</h2>
    <ol>
      <li>Start with your first semester. Add one row per class. The class name is optional.</li>
      <li>Pick the course type: Regular, Honors, AP or IB.</li>
      <li>Choose a letter grade. If you only know a percentage, switch the semester's <strong>%</strong> toggle on and type the number. It converts using the standard bands.</li>
      <li>Enter the credits for each class. If you do not know them, turn on <strong>No Credits</strong> and every class in that semester counts equally.</li>
      <li>Use <strong>Add Semester</strong> for each term. Your cumulative GPA is weighted by credits across all semesters, so it is not just the average of your semester GPAs.</li>
      <li>Already have a GPA from earlier years? Turn on <strong>Include Previous GPA</strong> and enter your unweighted GPA, weighted GPA and credits.</li>
    </ol>
    <p>Classes graded P (pass) or W (withdrawn) are left out of both GPAs. For a longer view across several years, the <a href="/cumulative-gpa-calculator/">cumulative GPA calculator</a> works the same way.</p>
  </section>

  <!-- ══════════════════════════════════════════════
       FAQ
  ══════════════════════════════════════════════ -->
  <section class="max-w-3xl mx-auto px-4 py-10" aria-labelledby="hs-faq-heading">
    <div class="text-center mb-8">
      <h2 id="hs-faq-heading" class="mb-2">Frequently Asked Questions</h2>
      <p class="text-base m-0" style="color: var(--color-body);">Common questions about weighted, unweighted and cumulative high school GPA.</p>
    </div>

    <div class="card" style="padding: 0;">
      {faq.map((item, i) => (
        <div class={`faq-item${i === 0 ? ' open' : ''}`}>
          <button
            class="faq-question"
            aria-expanded={i === 0 ? "true" : "false"}
            style="padding: 1rem 1.5rem;"
          >
            <span>{item.q}</span>
            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div
            class="faq-answer"
            style="padding: 0 1.5rem 1rem;"
          >
            <p class="m-0 text-sm leading-relaxed" style="color: var(--color-body);">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       RELATED CALCULATORS
  ══════════════════════════════════════════════ -->
  <section class="max-w-6xl mx-auto px-4 py-10" aria-labelledby="related-heading">
    <div style="background: var(--color-canvas-soft-2); border: 1px solid var(--color-hairline); border-radius: var(--radius-xl); padding: 2rem 2.5rem;">
      <h2 id="related-heading" class="text-lg mb-1" style="font-size: 1.2rem; letter-spacing: -0.02em;">Related GPA Calculators</h2>
      <p class="text-sm mb-5" style="color: var(--color-body);">More tools to help you track and improve your academic performance.</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          {
            href: "/weighted-gpa-calculator/",
            title: "Weighted GPA Calculator",
            desc: "Calculate your weighted GPA with AP, Honors, and IB course bonuses on the 5.0 scale."
          },
          {
            href: "/cumulative-gpa-calculator/",
            title: "Cumulative GPA Calculator",
            desc: "Combine multiple semesters to find your overall cumulative GPA across all years."
          },
          {
            href: "/college-gpa-calculator/",
            title: "College GPA Calculator",
            desc: "Calculate your college semester and cumulative GPA using the standard 4.0 scale."
          },
          {
            href: "/unweighted-gpa-calculator/",
            title: "Unweighted GPA Calculator",
            desc: "Calculate your GPA on the standard 4.0 scale without course-difficulty bonuses."
          },
          {
            href: "/what-if-gpa-calculator/",
            title: "What If GPA Calculator",
            desc: "Simulate future grades to see exactly how they will change your GPA."
          },
          {
            href: "/grade-calculator/",
            title: "Grade Calculator",
            desc: "Find out what grade you need on your final exam to hit your target course grade."
          },
          {
            href: "/gpa-scale/",
            title: "GPA Scale Chart",
            desc: "See what each letter grade is worth and how schools treat plus and minus grades."
          },
          {
            href: "/percentage-to-gpa/",
            title: "Percentage to GPA",
            desc: "Convert a percentage grade to a letter grade and GPA points."
          },
          {
            href: "/weighted-to-unweighted-gpa/",
            title: "Weighted to Unweighted GPA",
            desc: "Why a weighted GPA has no single unweighted answer, and how to recalculate it."
          }
        ].map(card => (
          <a
            href={card.href}
            class="card group block p-5 transition-all duration-200 hover:shadow-md no-underline"
            aria-label={card.title}
          >
            <h3 class="text-sm font-semibold mb-1.5 group-hover:text-[color:var(--color-brand)] transition-colors" style="color: var(--color-ink); letter-spacing: -0.01em;">
              {card.title}
            </h3>
            <p class="text-xs leading-relaxed m-0" style="color: var(--color-body);">
              {card.desc}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

<!-- ══════════════════════════════════════════════════════════════════
     HIGH SCHOOL GPA CALCULATOR JAVASCRIPT
══════════════════════════════════════════════════════════════════ -->
<style is:global>
  #hs-calculator .semester-section { --course-columns: minmax(0, 1fr) 110px 110px 72px 32px; }
  #hs-calculator .semester-section[data-no-credits="true"] { --course-columns: minmax(0, 1fr) 110px 110px 32px; }
  #hs-calculator .hs-course-columns,
  #hs-calculator .hs-course-row { display: grid; grid-template-columns: var(--course-columns); gap: 0.5rem; }
  #hs-calculator .hs-course-columns { padding: 0.75rem calc(1.75rem + 1px) 0.25rem; }
  #hs-calculator [data-no-credits="true"] .credit-col-header { display: none; }
  #hs-calculator .hs-course-row > * { min-width: 0; }
  #hs-calculator .hs-field-label { display: none; }
  #hs-calculator .hs-credits-field .credits-input { width: 100% !important; }
  @media (max-width: 639px) {
    #hs-calculator .hs-course-columns { display: none; }
    #hs-calculator .hs-course-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #hs-calculator .hs-course-row > input[type="text"] { grid-column: 1 / -1; }
    #hs-calculator .hs-course-row > button { grid-column: 2; grid-row: 3; justify-self: end; min-width: 44px; min-height: 44px; }
    #hs-calculator .hs-credits-field { grid-column: 1; }
    #hs-calculator .hs-field-label { display: block; margin-bottom: 0.25rem; color: var(--color-body); font-size: 0.75rem; }
    #hs-calculator .hs-course-row .input { font-size: 1rem !important; }
  }
</style>

<script>
import { createCalculatorFeedback } from '../scripts/calculator-feedback';
(function () {
  'use strict';

  // ── Grade point map ─────────────────────────────────────────────────────────
  const GRADE_POINTS = {
    'A+': 4.0, 'A': 4.0, 'A-': 3.7,
    'B+': 3.3, 'B': 3.0, 'B-': 2.7,
    'C+': 2.3, 'C': 2.0, 'C-': 1.7,
    'D+': 1.3, 'D': 1.0, 'D-': 0.7,
    'F': 0.0, 'P': null, 'W': null
  };

  const GRADE_OPTIONS = ['A+','A','A-','B+','B','B-','C+','C','C-','D+','D','D-','F','P','W'];

  const COURSE_TYPES = ['Regular','Honors','AP','IB'];
  const TYPE_BONUS   = { Regular: 0, Honors: 0.5, AP: 1.0, IB: 1.0 };

  // Semester label sequences per year
  const SEMESTER_LABELS = [
    'Freshman Fall', 'Freshman Spring',
    'Sophomore Fall', 'Sophomore Spring',
    'Junior Fall', 'Junior Spring',
    'Senior Fall', 'Senior Spring'
  ];

  // ── State ───────────────────────────────────────────────────────────────────
  let semesterCount  = 0;
  let totalCourseId  = 0;

  // ── DOM refs ────────────────────────────────────────────────────────────────
  const semestersContainer = document.getElementById('semesters-container');
  const addSemesterBtn     = document.getElementById('add-semester-btn');
  const emptyHint          = document.getElementById('hs-empty-hint');
  const resultPanel        = document.getElementById('hs-result-panel');

  const uwGpaEl            = document.getElementById('uw-gpa-result');
  const uwLabelEl          = document.getElementById('uw-gpa-label');
  const uwMeterEl          = document.getElementById('uw-meter-fill');
  const wGpaEl             = document.getElementById('w-gpa-result');
  const wLabelEl           = document.getElementById('w-gpa-label');
  const wMeterEl           = document.getElementById('w-meter-fill');
  const totalCreditsEl     = document.getElementById('hs-total-credits');
  const totalQpEl          = document.getElementById('hs-total-qp');
  const proximityEl        = document.getElementById('hs-proximity-msg');

  const shareBtn           = document.getElementById('hs-share-btn');
  const shareBtnText       = document.getElementById('hs-share-text');
  const printBtn           = document.getElementById('hs-print-btn');
  const resetBtn           = document.getElementById('hs-reset-btn');

  const prevToggle         = document.getElementById('prev-gpa-toggle');
  const prevInputs         = document.getElementById('prev-gpa-inputs');
  const prevUWEl           = document.getElementById('prev-unweighted-gpa');
  const prevWEl            = document.getElementById('prev-weighted-gpa');
  const prevCrEl           = document.getElementById('prev-credits');
  const feedback = createCalculatorFeedback({
    root: document.getElementById('hs-calculator')!, calculator: 'high_school',
    result: document.getElementById('hs-full-result')!, numbers: [uwGpaEl!, wGpaEl!],
  });
  function updateFeedback(uwGpa: number | null, wGpa: number | null) {
    const semesters = [...semestersContainer.querySelectorAll<HTMLElement>('.semester-section')];
    const rows = semesters.flatMap(sem => [...sem.querySelectorAll<HTMLElement>('.course-row')].map(row => ({
      grade: row.querySelector<HTMLInputElement | HTMLSelectElement>('.grade-select, .pct-input')?.value || '',
      type: row.querySelector<HTMLSelectElement>('.course-type')?.value,
      credits: sem.dataset.noCredits === 'true' ? '1' : row.querySelector<HTMLInputElement>('.credits-input')?.value || '',
      percentage: sem.dataset.pctMode === 'true',
    })));
    const excluded = rows.filter(row => row.grade === 'P' || row.grade === 'W').length;
    const incomplete = rows.filter(row => !['P', 'W'].includes(row.grade) && (!row.grade || (row.percentage && (!Number.isFinite(Number(row.grade)) || Number(row.grade) < 0 || Number(row.grade) > 100)) || !Number.isFinite(Number(row.credits)) || Number(row.credits) < 0.5 || Number(row.credits) > 12)).length;
    const previousEnabled = (prevToggle as HTMLInputElement).checked;
    const previous = [prevUWEl, prevWEl, prevCrEl].map(input => (input as HTMLInputElement).value);
    const previousIncomplete = previousEnabled && previous.some((value, index) => value === '' || !Number.isFinite(Number(value)) || Number(value) < 0 || (index < 2 && Number(value) > (index === 0 ? 4 : 5)));
    const partial = incomplete > 0 || previousIncomplete;
    const validity = uwGpa === null ? 'empty' : partial ? 'partial' : 'complete';
    feedback.update({ validity, mode: 'semesters',
      primary: uwGpa === null ? '' : `${partial ? 'Partial · ' : ''}Unweighted ${fmt(uwGpa)}`,
      secondary: wGpa === null ? '' : `Weighted ${fmt(wGpa)}`,
      signature: JSON.stringify([validity, rows, previousEnabled, previousEnabled ? previous : []]),
      includedRows: rows.length - excluded - incomplete, excludedRows: excluded + incomplete,
    });
  }

  // ── Helpers ─────────────────────────────────────────────────────────────────
  function percentToLetter(pct) {
    const p = parseFloat(pct);
    if (isNaN(p)) return 'F';
    if (p >= 97) return 'A+';
    if (p >= 93) return 'A';
    if (p >= 90) return 'A-';
    if (p >= 87) return 'B+';
    if (p >= 83) return 'B';
    if (p >= 80) return 'B-';
    if (p >= 77) return 'C+';
    if (p >= 73) return 'C';
    if (p >= 70) return 'C-';
    if (p >= 67) return 'D+';
    if (p >= 63) return 'D';
    if (p >= 60) return 'D-';
    return 'F';
  }

  function fmt(g) {
    return (g === null || isNaN(g)) ? '—' : g.toFixed(2);
  }

  function gpaColor(g) {
    if (g === null || isNaN(g)) return 'var(--color-mute)';
    if (g < 2.0) return 'var(--color-gpa-red)';
    if (g < 3.0) return 'var(--color-gpa-yellow)';
    if (g < 3.5) return 'var(--color-gpa-green)';
    return 'var(--color-gpa-blue)';
  }

  function gpaLabel(g) {
    if (g === null || isNaN(g)) return '';
    if (g >= 3.9) return 'Perfect / Summa Cum Laude';
    if (g >= 3.7) return 'Magna Cum Laude';
    if (g >= 3.5) return "Dean's List";
    if (g >= 3.0) return 'Good Standing';
    if (g >= 2.0) return 'Satisfactory';
    if (g >= 1.0) return 'Below Average';
    return 'Failing';
  }

  function proximityMsg(uwGpa) {
    if (uwGpa === null || isNaN(uwGpa)) return '';
    const thresholds = [
      { val: 4.0, label: 'Perfect 4.0' },
      { val: 3.9, label: 'Summa Cum Laude (3.9)' },
      { val: 3.7, label: 'Magna Cum Laude (3.7)' },
      { val: 3.5, label: "Dean's List (3.5)" },
      { val: 3.0, label: 'Good Standing (3.0)' },
      { val: 2.0, label: 'Passing (2.0)' },
    ];
    for (const t of thresholds) {
      if (uwGpa < t.val) {
        const diff = (t.val - uwGpa).toFixed(2);
        if (parseFloat(diff) <= 0.30) {
          return `${diff} away from ${t.label}`;
        }
        return '';
      }
    }
    return '';
  }

  // ── Build a course row ───────────────────────────────────────────────────────
  function buildCourseRow(semesterEl) {
    totalCourseId++;
    const id = totalCourseId;

    // Inherit semester-level toggle state
    const noCredits = semesterEl.dataset.noCredits === 'true';
    const pctMode   = semesterEl.dataset.pctMode   === 'true';

    const row = document.createElement('div');
    row.className = 'course-row hs-course-row';
    row.dataset.id = String(id);
    row.setAttribute('role', 'listitem');
    row.setAttribute('aria-label', `Course ${id}`);

    // Layout: name | type | grade | [credits] | remove
    // The header and rows share one grid definition, including equal-credits mode.

    // ── Course name ──
    const nameInput = document.createElement('input');
    nameInput.type = 'text';
    nameInput.placeholder = `Course ${id}`;
    nameInput.className = 'input';
    nameInput.style.fontSize = '0.875rem';
    nameInput.setAttribute('aria-label', 'Course name');

    // ── Course type ──
    const typeSelect = document.createElement('select');
    typeSelect.className = 'input course-type';
    typeSelect.style.cssText = 'font-size:0.8125rem; padding: 0.5rem 0.5rem; padding-right: 2rem;';
    typeSelect.setAttribute('aria-label', 'Course type');
    COURSE_TYPES.forEach(t => {
      const opt = document.createElement('option');
      opt.value = t;
      opt.textContent = t;
      typeSelect.appendChild(opt);
    });
    typeSelect.addEventListener('change', recalculate);

    // ── Grade ──
    const gradeWrapper = document.createElement('div');

    if (pctMode) {
      const pctInput = document.createElement('input');
      pctInput.type = 'number';
      pctInput.min = '0';
      pctInput.max = '100';
      pctInput.step = '1';
      pctInput.placeholder = '%';
      pctInput.className = 'input pct-input';
      pctInput.style.cssText = 'font-size:0.875rem; text-align:center; padding: 0.5rem;';
      pctInput.setAttribute('aria-label', 'Grade percentage');
      pctInput.addEventListener('input', recalculate);
      gradeWrapper.appendChild(pctInput);
    } else {
      const gradeSelect = document.createElement('select');
      gradeSelect.className = 'input grade-select';
      gradeSelect.style.cssText = 'font-size:0.8125rem; padding: 0.5rem 0.5rem; padding-right: 2rem;';
      gradeSelect.setAttribute('aria-label', 'Letter grade');
      GRADE_OPTIONS.forEach(g => {
        const opt = document.createElement('option');
        opt.value = g;
        opt.textContent = g;
        if (g === 'A') opt.selected = true;
        gradeSelect.appendChild(opt);
      });
      gradeSelect.addEventListener('change', recalculate);
      gradeWrapper.appendChild(gradeSelect);
    }

    // ── Credits ──
    const creditsInput = document.createElement('input');
    creditsInput.type = 'number';
    creditsInput.min = '0.5';
    creditsInput.max = '12';
    creditsInput.step = '0.5';
    creditsInput.value = '1';
    creditsInput.className = 'input credits-input';
    creditsInput.style.cssText = 'font-size:0.875rem; text-align:center; padding: 0.5rem;';
    creditsInput.setAttribute('aria-label', 'Credit hours');
    creditsInput.addEventListener('input', recalculate);

    // ── Remove button ──
    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'btn btn-secondary btn-sm';
    removeBtn.style.cssText = 'padding: 0.35rem 0.4rem; color: var(--color-mute); min-width: 32px;';
    removeBtn.setAttribute('aria-label', `Remove course ${id}`);
    removeBtn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    removeBtn.addEventListener('click', () => {
      row.remove();
      recalculate();
    });

    function field(label: string, control: HTMLElement, className = '') {
      const wrapper = document.createElement('div');
      wrapper.className = className;
      const caption = document.createElement('span');
      caption.className = 'hs-field-label';
      caption.textContent = label;
      wrapper.append(caption, control);
      return wrapper;
    }
    row.appendChild(nameInput);
    row.appendChild(field('Type', typeSelect));
    row.appendChild(field(pctMode ? 'Grade (%)' : 'Grade', gradeWrapper));
    if (!noCredits) row.appendChild(field('Credits', creditsInput, 'hs-credits-field'));
    row.appendChild(removeBtn);

    return row;
  }

  // ── Build a semester section ─────────────────────────────────────────────────
  function buildSemester(labelOverride) {
    semesterCount++;
    const idx   = semesterCount;
    const label = labelOverride || SEMESTER_LABELS[idx - 1] || `Semester ${idx}`;

    const section = document.createElement('div');
    section.className = 'card p-0 overflow-hidden mb-4 semester-section';
    section.dataset.semesterId = String(idx);
    section.dataset.noCredits  = 'false';
    section.dataset.pctMode    = 'false';

    // ── Semester header ──
    const header = document.createElement('div');
    header.className = 'flex items-center justify-between gap-3 flex-wrap px-4 py-3';
    header.style.cssText = 'background: var(--color-canvas-soft); border-bottom: 1px solid var(--color-hairline);';

    // Label (editable)
    const labelInput = document.createElement('input');
    labelInput.type = 'text';
    labelInput.value = label;
    labelInput.className = 'font-semibold text-sm bg-transparent border-none outline-none';
    labelInput.style.cssText = 'color: var(--color-ink); font-family: var(--font-sans); min-width: 120px; max-width: 200px;';
    labelInput.setAttribute('aria-label', 'Semester name');
    labelInput.addEventListener('input', recalculate);

    // Running GPA badge
    const runningBadge = document.createElement('span');
    runningBadge.className = 'badge badge-blue running-gpa-badge';
    runningBadge.style.display = 'none';
    runningBadge.setAttribute('aria-label', 'Running cumulative GPA after this semester');

    // Toggles
    const togglesDiv = document.createElement('div');
    togglesDiv.className = 'flex items-center gap-3 flex-wrap';

    // Pct toggle
    const pctLabel = document.createElement('label');
    pctLabel.className = 'toggle';
    pctLabel.setAttribute('aria-label', 'Toggle percentage input mode');
    const pctInput = document.createElement('input');
    pctInput.type = 'checkbox';
    const pctTrack = document.createElement('span');
    pctTrack.className = 'toggle-track';
    const pctThumb = document.createElement('span');
    pctThumb.className = 'toggle-thumb';
    pctLabel.appendChild(pctInput);
    pctLabel.appendChild(pctTrack);
    pctLabel.appendChild(pctThumb);
    const pctText = document.createElement('span');
    pctText.className = 'text-xs';
    pctText.style.color = 'var(--color-mute)';
    pctText.textContent = '%';

    pctInput.addEventListener('change', () => {
      section.dataset.pctMode = pctInput.checked ? 'true' : 'false';
      rebuildCourseRows(section);
    });

    // No-credits toggle
    const ncLabel = document.createElement('label');
    ncLabel.className = 'toggle';
    ncLabel.setAttribute('aria-label', 'Toggle no-credits equal weight mode');
    const ncInput = document.createElement('input');
    ncInput.type = 'checkbox';
    const ncTrack = document.createElement('span');
    ncTrack.className = 'toggle-track';
    const ncThumb = document.createElement('span');
    ncThumb.className = 'toggle-thumb';
    ncLabel.appendChild(ncInput);
    ncLabel.appendChild(ncTrack);
    ncLabel.appendChild(ncThumb);
    const ncText = document.createElement('span');
    ncText.className = 'text-xs';
    ncText.style.color = 'var(--color-mute)';
    ncText.textContent = 'No Credits';

    ncInput.addEventListener('change', () => {
      section.dataset.noCredits = ncInput.checked ? 'true' : 'false';
      rebuildCourseRows(section);
    });

    // Remove semester button (only if more than 1)
    const removeSemBtn = document.createElement('button');
    removeSemBtn.type = 'button';
    removeSemBtn.className = 'btn btn-secondary btn-sm';
    removeSemBtn.style.cssText = 'padding: 0.3rem 0.5rem; color: var(--color-mute);';
    removeSemBtn.setAttribute('aria-label', 'Remove this semester');
    removeSemBtn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    removeSemBtn.addEventListener('click', () => {
      section.remove();
      semesterCount = document.querySelectorAll('.semester-section').length;
      recalculate();
    });

    togglesDiv.appendChild(pctLabel);
    togglesDiv.appendChild(pctText);
    togglesDiv.appendChild(ncLabel);
    togglesDiv.appendChild(ncText);
    togglesDiv.appendChild(removeSemBtn);

    header.appendChild(labelInput);
    header.appendChild(runningBadge);
    header.appendChild(togglesDiv);

    // ── Column headers ──
    const colHeaders = document.createElement('div');
    colHeaders.className = 'hs-course-columns';
    colHeaders.innerHTML = `
      <span class="text-xs font-medium uppercase tracking-wide" style="color: var(--color-mute);">Course</span>
      <span class="text-xs font-medium uppercase tracking-wide text-center" style="color: var(--color-mute);">Type</span>
      <span class="text-xs font-medium uppercase tracking-wide text-center" style="color: var(--color-mute);">Grade</span>
      <span class="text-xs font-medium uppercase tracking-wide text-center credit-col-header" style="color: var(--color-mute);">Credits</span>
      <span></span>
    `;

    // ── Course list ──
    const courseList = document.createElement('div');
    courseList.className = 'px-4 pb-3 flex flex-col gap-2 course-list';
    courseList.setAttribute('role', 'list');
    courseList.setAttribute('aria-label', `Courses for ${label}`);

    // ── Add course button ──
    const addCourseBtn = document.createElement('button');
    addCourseBtn.type = 'button';
    addCourseBtn.className = 'btn btn-ghost btn-sm mx-4 mb-3';
    addCourseBtn.style.cssText = 'border: 1px dashed var(--color-hairline-strong); color: var(--color-brand);';
    addCourseBtn.setAttribute('aria-label', 'Add course to this semester');
    addCourseBtn.innerHTML = `
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      Add Course
    `;
    addCourseBtn.addEventListener('click', () => {
      const row = buildCourseRow(section);
      courseList.appendChild(row);
      recalculate();
    });

    section.appendChild(header);
    section.appendChild(colHeaders);
    section.appendChild(courseList);
    section.appendChild(addCourseBtn);

    // Add 4 default courses
    for (let i = 0; i < 4; i++) {
      const row = buildCourseRow(section);
      courseList.appendChild(row);
    }

    return section;
  }

  function rebuildCourseRows(semesterEl) {
    const courseList = semesterEl.querySelector('.course-list');
    if (!courseList) return;
    const count = courseList.children.length || 4;
    courseList.innerHTML = '';
    for (let i = 0; i < count; i++) {
      courseList.appendChild(buildCourseRow(semesterEl));
    }
    recalculate();
  }

  // ── Main calculation ─────────────────────────────────────────────────────────
  function recalculate() {
    // Previous GPA inputs
    const prevEnabled = prevToggle && (prevToggle as HTMLInputElement).checked;
    let prevUW = 0, prevW = 0, prevCr = 0;
    if (prevEnabled) {
      prevUW = parseFloat((prevUWEl as HTMLInputElement)?.value || '0') || 0;
      prevW  = parseFloat((prevWEl as HTMLInputElement)?.value  || '0') || 0;
      prevCr = parseFloat((prevCrEl as HTMLInputElement)?.value || '0') || 0;
    }

    let cumulativeUWQP = prevUW * prevCr;
    let cumulativeWQP  = prevW  * prevCr;
    let cumulativeCr   = prevCr;

    const allSemesters = document.querySelectorAll('.semester-section');

    allSemesters.forEach(semEl => {
      const noCredits = (semEl as HTMLElement).dataset.noCredits === 'true';
      const pctMode   = (semEl as HTMLElement).dataset.pctMode   === 'true';
      const rows      = semEl.querySelectorAll('.course-row');

      let semUWQP = 0, semWQP = 0, semCr = 0;

      rows.forEach(row => {
        let gradePoints: number | null = null;

        if (pctMode) {
          const pctEl = row.querySelector('.pct-input') as HTMLInputElement;
          if (pctEl && pctEl.value !== '') {
            const letter = percentToLetter(pctEl.value);
            gradePoints = GRADE_POINTS[letter] ?? null;
          }
        } else {
          const selEl = row.querySelector('.grade-select') as HTMLSelectElement;
          if (selEl) gradePoints = GRADE_POINTS[selEl.value] ?? null;
        }

        if (gradePoints === null) return; // P, W — skip

        const typeEl = row.querySelector('.course-type') as HTMLSelectElement;
        const type   = typeEl?.value || 'Regular';
        const bonus  = TYPE_BONUS[type] || 0;
        // A failing grade earns no course-weight bonus.
        const weightedPoints = gradePoints > 0 ? Math.min(gradePoints + bonus, 5.0) : 0;

        const credits = noCredits
          ? 1
          : parseFloat((row.querySelector('.credits-input') as HTMLInputElement)?.value || '0');

        if (!credits || credits <= 0) return;

        semUWQP += gradePoints * credits;
        semWQP  += weightedPoints * credits;
        semCr   += credits;
      });

      // Update running cumulative badge
      const badge = semEl.querySelector('.running-gpa-badge') as HTMLElement;
      if (semCr > 0) {
        const runUW = (cumulativeUWQP + semUWQP) / (cumulativeCr + semCr);
        const runW  = (cumulativeWQP  + semWQP)  / (cumulativeCr + semCr);
        if (badge) {
          badge.textContent = `Cumulative: ${fmt(runUW)} UW / ${fmt(runW)} W`;
          badge.style.display = '';
        }
      } else {
        if (badge) badge.style.display = 'none';
      }

      cumulativeUWQP += semUWQP;
      cumulativeWQP  += semWQP;
      cumulativeCr   += semCr;
    });

    if (cumulativeCr === 0) {
      showEmpty();
      return;
    }

    const uwGpa = Math.round((cumulativeUWQP / cumulativeCr) * 1000) / 1000;
    const wGpa  = Math.round((cumulativeWQP  / cumulativeCr) * 1000) / 1000;

    showResult(uwGpa, wGpa, cumulativeCr, cumulativeUWQP);
  }

  function showEmpty() {
    updateFeedback(null, null);
    emptyHint.style.display = '';
    emptyHint.classList.remove('hidden');
    resultPanel.classList.add('hidden');
  }

  function showResult(uwGpa, wGpa, totalCr, totalUWQP) {
    updateFeedback(uwGpa, wGpa);
    emptyHint.style.display = 'none';
    emptyHint.classList.add('hidden');
    resultPanel.classList.remove('hidden');

    const uwColor = gpaColor(uwGpa);
    const wColor  = gpaColor(wGpa);

    // Unweighted
    uwGpaEl.textContent = fmt(uwGpa);
    uwGpaEl.style.color = uwColor;
    uwLabelEl.textContent = gpaLabel(uwGpa);
    const uwPct = Math.min(Math.max((uwGpa / 4.0) * 100, 0), 100);
    uwMeterEl.style.width = uwPct + '%';
    uwMeterEl.style.background = uwColor;
    uwMeterEl.setAttribute('aria-valuenow', uwGpa.toFixed(2));

    // Weighted
    wGpaEl.textContent = fmt(wGpa);
    wGpaEl.style.color = wColor;
    wLabelEl.textContent = gpaLabel(Math.min(wGpa, 4.0)); // label based on 4.0 equivalent
    const wPct = Math.min(Math.max((wGpa / 5.0) * 100, 0), 100);
    wMeterEl.style.width = wPct + '%';
    wMeterEl.style.background = wColor;
    wMeterEl.setAttribute('aria-valuenow', wGpa.toFixed(2));

    // Stats
    totalCreditsEl.textContent = totalCr % 1 === 0 ? String(totalCr) : totalCr.toFixed(1);
    totalQpEl.textContent = totalUWQP.toFixed(2);

    // Proximity
    proximityEl.textContent = proximityMsg(uwGpa);

    // Pulse animation
    uwGpaEl.classList.remove('pulse-once');
    wGpaEl.classList.remove('pulse-once');
    void uwGpaEl.offsetWidth;
    void wGpaEl.offsetWidth;
    uwGpaEl.classList.add('pulse-once');
    wGpaEl.classList.add('pulse-once');
  }

  // ── Previous GPA toggle ──────────────────────────────────────────────────────
  prevToggle?.addEventListener('change', () => {
    if ((prevToggle as HTMLInputElement).checked) {
      prevInputs?.classList.remove('hidden');
    } else {
      prevInputs?.classList.add('hidden');
    }
    recalculate();
  });

  prevUWEl?.addEventListener('input', recalculate);
  prevWEl?.addEventListener('input', recalculate);
  prevCrEl?.addEventListener('input', recalculate);

  // ── Add semester ─────────────────────────────────────────────────────────────
  addSemesterBtn?.addEventListener('click', () => {
    const sem = buildSemester('');
    semestersContainer.appendChild(sem);
    recalculate();
  });

  // ── Action buttons ───────────────────────────────────────────────────────────
  shareBtn?.addEventListener('click', () => {
    const uwText = uwGpaEl?.textContent || '—';
    const wText  = wGpaEl?.textContent  || '—';
    const url    = new URL(window.location.href);
    url.searchParams.set('uw', uwText);
    url.searchParams.set('w', wText);
    const shareUrl = url.toString();

    const copy = (text: string) => {
      if (navigator.clipboard?.writeText) return navigator.clipboard.writeText(text);
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.cssText = 'position:fixed;opacity:0';
      document.body.appendChild(ta);
      ta.focus(); ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      return Promise.resolve();
    };

    copy(shareUrl).then(() => {
      if (shareBtnText) {
        shareBtnText.textContent = 'Copied!';
        setTimeout(() => { if (shareBtnText) shareBtnText.textContent = 'Share'; }, 2000);
      }
    }).catch(() => {
      if (shareBtnText) {
        shareBtnText.textContent = 'Failed';
        setTimeout(() => { if (shareBtnText) shareBtnText.textContent = 'Share'; }, 2000);
      }
    });
  });

  printBtn?.addEventListener('click', () => window.print());

  resetBtn?.addEventListener('click', () => {
    feedback.reset();
    // Clear all semesters
    semestersContainer.innerHTML = '';
    semesterCount = 0;
    totalCourseId = 0;

    // Reset previous GPA section
    if (prevToggle) (prevToggle as HTMLInputElement).checked = false;
    prevInputs?.classList.add('hidden');
    if (prevUWEl) (prevUWEl as HTMLInputElement).value = '';
    if (prevWEl)  (prevWEl  as HTMLInputElement).value = '';
    if (prevCrEl) (prevCrEl as HTMLInputElement).value = '';

    // Add fresh semester
    const sem = buildSemester(SEMESTER_LABELS[0]);
    semestersContainer.appendChild(sem);
    showEmpty();
    recalculate();
  });

  // ── FAQ accordion ────────────────────────────────────────────────────────────
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item   = btn.closest('.faq-item');
      const isOpen = item?.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(el => {
        el.classList.remove('open');
        el.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen && item) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // ── Restore from URL params ──────────────────────────────────────────────────
  const urlParams = new URLSearchParams(window.location.search);
  const sharedUW  = urlParams.get('uw');
  const sharedW   = urlParams.get('w');
  if (sharedUW || sharedW) {
    const banner = document.createElement('div');
    banner.className = 'callout callout-blue mb-4';
    banner.style.fontSize = '0.875rem';
    banner.innerHTML = `Shared result — Unweighted: <strong>${sharedUW || '—'}</strong> / Weighted: <strong>${sharedW || '—'}</strong>. Enter your courses above to recalculate.`;
    const calcSection = document.getElementById('hs-calculator');
    if (calcSection) calcSection.insertBefore(banner, calcSection.firstChild);
  }

  // ── Init: add first semester ─────────────────────────────────────────────────
  const firstSem = buildSemester(SEMESTER_LABELS[0]);
  semestersContainer.appendChild(firstSem);
  recalculate();

})();
</script>
