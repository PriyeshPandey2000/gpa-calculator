        ))}
      </div>
    </div>
  </section>

</Layout>

<!-- ══════════════════════════════════════════════════════════════════
     HIGH SCHOOL GPA CALCULATOR JAVASCRIPT
══════════════════════════════════════════════════════════════════ -->
<script>
(function () {
  'use strict';

  // ── Grade point map ─────────────────────────────────────────────────────────
  const GRADE_POINTS = {
    'A+': 4.0, 'A': 4.0, 'A-': 3.7,
    'B+': 3.3, 'B': 3.0, 'B-': 2.7,
    'C+': 2.3, 'C': 2.0, 'C-': 1.7,
    'D+': 1.3, 'D': 1.0, 'D-': 0.7,
    'F': 0.0, 'P': null, 'W': null
  };

  const GRADE_OPTIONS = ['A+','A','A-','B+','B','B-','C+','C','C-','D+','D','D-','F','P','W'];

  const COURSE_TYPES = ['Regular','Honors','AP','IB'];
  const TYPE_BONUS   = { Regular: 0, Honors: 0.5, AP: 1.0, IB: 1.0 };

  // Semester label sequences per year
  const SEMESTER_LABELS = [
    'Freshman Fall', 'Freshman Spring',
    'Sophomore Fall', 'Sophomore Spring',
    'Junior Fall', 'Junior Spring',
    'Senior Fall', 'Senior Spring'
  ];

  // ── State ───────────────────────────────────────────────────────────────────
  let semesterCount  = 0;
  let totalCourseId  = 0;

  // ── DOM refs ────────────────────────────────────────────────────────────────
  const semestersContainer = document.getElementById('semesters-container');
  const addSemesterBtn     = document.getElementById('add-semester-btn');
  const emptyHint          = document.getElementById('hs-empty-hint');
  const resultPanel        = document.getElementById('hs-result-panel');

  const uwGpaEl            = document.getElementById('uw-gpa-result');
  const uwLabelEl          = document.getElementById('uw-gpa-label');
  const uwMeterEl          = document.getElementById('uw-meter-fill');
  const wGpaEl             = document.getElementById('w-gpa-result');
  const wLabelEl           = document.getElementById('w-gpa-label');
  const wMeterEl           = document.getElementById('w-meter-fill');
  const totalCreditsEl     = document.getElementById('hs-total-credits');
  const totalQpEl          = document.getElementById('hs-total-qp');
  const proximityEl        = document.getElementById('hs-proximity-msg');

  const shareBtn           = document.getElementById('hs-share-btn');
  const shareBtnText       = document.getElementById('hs-share-text');
  const printBtn           = document.getElementById('hs-print-btn');
  const resetBtn           = document.getElementById('hs-reset-btn');

  const prevToggle         = document.getElementById('prev-gpa-toggle');
  const prevInputs         = document.getElementById('prev-gpa-inputs');
  const prevUWEl           = document.getElementById('prev-unweighted-gpa');
  const prevWEl            = document.getElementById('prev-weighted-gpa');
  const prevCrEl           = document.getElementById('prev-credits');

  // ── Helpers ─────────────────────────────────────────────────────────────────
  function percentToLetter(pct) {
    const p = parseFloat(pct);
    if (isNaN(p)) return 'F';
    if (p >= 97) return 'A+';
    if (p >= 93) return 'A';
    if (p >= 90) return 'A-';
    if (p >= 87) return 'B+';
    if (p >= 83) return 'B';
    if (p >= 80) return 'B-';
    if (p >= 77) return 'C+';
    if (p >= 73) return 'C';
    if (p >= 70) return 'C-';
    if (p >= 67) return 'D+';
    if (p >= 63) return 'D';
    if (p >= 60) return 'D-';
    return 'F';
  }

  function fmt(g) {
    return (g === null || isNaN(g)) ? '—' : g.toFixed(2);
  }

  function gpaColor(g) {
    if (g === null || isNaN(g)) return '#888888';
    if (g < 2.0) return '#ee0000';
    if (g < 3.0) return '#f5a623';
    if (g < 3.5) return '#16a34a';
    return '#0070f3';
  }

  function gpaLabel(g) {
    if (g === null || isNaN(g)) return '';
    if (g >= 3.9) return 'Perfect / Summa Cum Laude';
    if (g >= 3.7) return 'Magna Cum Laude';
    if (g >= 3.5) return "Dean's List";
    if (g >= 3.0) return 'Good Standing';
    if (g >= 2.0) return 'Satisfactory';
    if (g >= 1.0) return 'Below Average';
    return 'Failing';
  }

  function proximityMsg(uwGpa) {
    if (uwGpa === null || isNaN(uwGpa)) return '';
    const thresholds = [
      { val: 4.0, label: 'Perfect 4.0' },
      { val: 3.9, label: 'Summa Cum Laude (3.9)' },
      { val: 3.7, label: 'Magna Cum Laude (3.7)' },
      { val: 3.5, label: "Dean's List (3.5)" },
      { val: 3.0, label: 'Good Standing (3.0)' },
      { val: 2.0, label: 'Passing (2.0)' },
    ];
    for (const t of thresholds) {
      if (uwGpa < t.val) {
        const diff = (t.val - uwGpa).toFixed(2);
        if (parseFloat(diff) <= 0.30) {
          return `${diff} away from ${t.label}`;
        }
        return '';
      }
    }
    return '';
  }

  // ── Build a course row ───────────────────────────────────────────────────────
  function buildCourseRow(semesterEl) {
    totalCourseId++;
    const id = totalCourseId;

    // Inherit semester-level toggle state
    const noCredits = semesterEl.dataset.noCredits === 'true';
    const pctMode   = semesterEl.dataset.pctMode   === 'true';

    const row = document.createElement('div');
    row.className = 'course-row';
    row.dataset.id = String(id);
    row.setAttribute('role', 'listitem');
    row.setAttribute('aria-label', `Course ${id}`);

    // Layout: name | type | grade | [credits] | remove
    row.style.gridTemplateColumns = noCredits
      ? '1fr 110px 110px 32px'
      : '1fr 110px 110px 72px 32px';

    // ── Course name ──
    const nameInput = document.createElement('input');
    nameInput.type = 'text';
    nameInput.placeholder = `Course ${id}`;
    nameInput.className = 'input';
    nameInput.style.fontSize = '0.875rem';
    nameInput.setAttribute('aria-label', 'Course name');
    nameInput.addEventListener('input', recalculate);

    // ── Course type ──
    const typeSelect = document.createElement('select');
    typeSelect.className = 'input course-type';
    typeSelect.style.cssText = 'font-size:0.8125rem; padding: 0.5rem 0.5rem; padding-right: 2rem;';
    typeSelect.setAttribute('aria-label', 'Course type');
    COURSE_TYPES.forEach(t => {
      const opt = document.createElement('option');
      opt.value = t;
      opt.textContent = t;
      typeSelect.appendChild(opt);
    });
    typeSelect.addEventListener('change', recalculate);

    // ── Grade ──
    const gradeWrapper = document.createElement('div');

    if (pctMode) {
      const pctInput = document.createElement('input');
      pctInput.type = 'number';
      pctInput.min = '0';
      pctInput.max = '100';
      pctInput.step = '1';
      pctInput.placeholder = '%';
      pctInput.className = 'input pct-input';
      pctInput.style.cssText = 'font-size:0.875rem; text-align:center; padding: 0.5rem;';
      pctInput.setAttribute('aria-label', 'Grade percentage');
      pctInput.addEventListener('input', recalculate);
      gradeWrapper.appendChild(pctInput);
    } else {
      const gradeSelect = document.createElement('select');
      gradeSelect.className = 'input grade-select';
      gradeSelect.style.cssText = 'font-size:0.8125rem; padding: 0.5rem 0.5rem; padding-right: 2rem;';
      gradeSelect.setAttribute('aria-label', 'Letter grade');
      GRADE_OPTIONS.forEach(g => {
        const opt = document.createElement('option');
        opt.value = g;
        opt.textContent = g;
        if (g === 'A') opt.selected = true;
        gradeSelect.appendChild(opt);
      });
      gradeSelect.addEventListener('change', recalculate);
      gradeWrapper.appendChild(gradeSelect);
    }

    // ── Credits ──
    const creditsInput = document.createElement('input');
    creditsInput.type = 'number';
    creditsInput.min = '0.5';
    creditsInput.max = '12';
    creditsInput.step = '0.5';
    creditsInput.value = '1';
    creditsInput.className = 'input credits-input';
    creditsInput.style.cssText = 'font-size:0.875rem; text-align:center; padding: 0.5rem;';
    creditsInput.setAttribute('aria-label', 'Credit hours');
    creditsInput.addEventListener('input', recalculate);

    // ── Remove button ──
    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'btn btn-secondary btn-sm';
    removeBtn.style.cssText = 'padding: 0.35rem 0.4rem; color: var(--color-mute); min-width: 32px;';
    removeBtn.setAttribute('aria-label', `Remove course ${id}`);
    removeBtn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    removeBtn.addEventListener('click', () => {
      row.remove();
      recalculate();
    });

    row.appendChild(nameInput);
    row.appendChild(typeSelect);
    row.appendChild(gradeWrapper);
    if (!noCredits) row.appendChild(creditsInput);
    row.appendChild(removeBtn);

    return row;
  }

  // ── Build a semester section ─────────────────────────────────────────────────
  function buildSemester(labelOverride) {
    semesterCount++;
    const idx   = semesterCount;
    const label = labelOverride || SEMESTER_LABELS[idx - 1] || `Semester ${idx}`;

    const section = document.createElement('div');
    section.className = 'card p-0 overflow-hidden mb-4 semester-section';
    section.dataset.semesterId = String(idx);
    section.dataset.noCredits  = 'false';
    section.dataset.pctMode    = 'false';

    // ── Semester header ──
    const header = document.createElement('div');
    header.className = 'flex items-center justify-between gap-3 flex-wrap px-4 py-3';
    header.style.cssText = 'background: var(--color-canvas-soft); border-bottom: 1px solid var(--color-hairline);';

    // Label (editable)
    const labelInput = document.createElement('input');
    labelInput.type = 'text';
    labelInput.value = label;
    labelInput.className = 'font-semibold text-sm bg-transparent border-none outline-none';
    labelInput.style.cssText = 'color: var(--color-ink); font-family: var(--font-sans); min-width: 120px; max-width: 200px;';
    labelInput.setAttribute('aria-label', 'Semester name');
    labelInput.addEventListener('input', recalculate);

    // Running GPA badge
    const runningBadge = document.createElement('span');
    runningBadge.className = 'badge badge-blue running-gpa-badge';
    runningBadge.style.display = 'none';
    runningBadge.setAttribute('aria-label', 'Running cumulative GPA after this semester');

    // Toggles
    const togglesDiv = document.createElement('div');
    togglesDiv.className = 'flex items-center gap-3 flex-wrap';

    // Pct toggle
    const pctLabel = document.createElement('label');
    pctLabel.className = 'toggle';
    pctLabel.setAttribute('aria-label', 'Toggle percentage input mode');
    const pctInput = document.createElement('input');
    pctInput.type = 'checkbox';
    const pctTrack = document.createElement('span');
    pctTrack.className = 'toggle-track';
    const pctThumb = document.createElement('span');
    pctThumb.className = 'toggle-thumb';
    pctLabel.appendChild(pctInput);
    pctLabel.appendChild(pctTrack);
    pctLabel.appendChild(pctThumb);
    const pctText = document.createElement('span');
    pctText.className = 'text-xs';
    pctText.style.color = 'var(--color-mute)';
    pctText.textContent = '%';

    pctInput.addEventListener('change', () => {
      section.dataset.pctMode = pctInput.checked ? 'true' : 'false';
      rebuildCourseRows(section);
    });

    // No-credits toggle
    const ncLabel = document.createElement('label');
    ncLabel.className = 'toggle';
    ncLabel.setAttribute('aria-label', 'Toggle no-credits equal weight mode');
    const ncInput = document.createElement('input');
    ncInput.type = 'checkbox';
    const ncTrack = document.createElement('span');
    ncTrack.className = 'toggle-track';
    const ncThumb = document.createElement('span');
    ncThumb.className = 'toggle-thumb';
    ncLabel.appendChild(ncInput);
    ncLabel.appendChild(ncTrack);
    ncLabel.appendChild(ncThumb);
    const ncText = document.createElement('span');
    ncText.className = 'text-xs';
    ncText.style.color = 'var(--color-mute)';
    ncText.textContent = 'No Credits';

    ncInput.addEventListener('change', () => {
      section.dataset.noCredits = ncInput.checked ? 'true' : 'false';
      const creditHeader = section.querySelector('.credit-col-header');
      if (creditHeader) {
        (creditHeader as HTMLElement).style.display = ncInput.checked ? 'none' : '';
      }
      rebuildCourseRows(section);
    });

    // Remove semester button (only if more than 1)
    const removeSemBtn = document.createElement('button');
    removeSemBtn.type = 'button';
    removeSemBtn.className = 'btn btn-secondary btn-sm';
    removeSemBtn.style.cssText = 'padding: 0.3rem 0.5rem; color: var(--color-mute);';
    removeSemBtn.setAttribute('aria-label', 'Remove this semester');
    removeSemBtn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    removeSemBtn.addEventListener('click', () => {
      section.remove();
      semesterCount = document.querySelectorAll('.semester-section').length;
      recalculate();
    });

    togglesDiv.appendChild(pctLabel);
    togglesDiv.appendChild(pctText);
    togglesDiv.appendChild(ncLabel);
    togglesDiv.appendChild(ncText);
    togglesDiv.appendChild(removeSemBtn);

    header.appendChild(labelInput);
    header.appendChild(runningBadge);
    header.appendChild(togglesDiv);

    // ── Column headers ──
    const colHeaders = document.createElement('div');
    colHeaders.className = 'px-4 pt-3 pb-1 grid gap-2';
    colHeaders.style.gridTemplateColumns = 'calc(1fr) 110px 110px 72px 32px';
    colHeaders.innerHTML = `
      <span class="text-xs font-medium uppercase tracking-wide" style="color: var(--color-mute);">Course</span>
      <span class="text-xs font-medium uppercase tracking-wide text-center" style="color: var(--color-mute);">Type</span>
      <span class="text-xs font-medium uppercase tracking-wide text-center" style="color: var(--color-mute);">Grade</span>
      <span class="text-xs font-medium uppercase tracking-wide text-center credit-col-header" style="color: var(--color-mute);">Credits</span>
      <span></span>
    `;

    // ── Course list ──
    const courseList = document.createElement('div');
    courseList.className = 'px-4 pb-3 flex flex-col gap-2 course-list';
    courseList.setAttribute('role', 'list');
    courseList.setAttribute('aria-label', `Courses for ${label}`);

    // ── Add course button ──
    const addCourseBtn = document.createElement('button');
    addCourseBtn.type = 'button';
    addCourseBtn.className = 'btn btn-ghost btn-sm mx-4 mb-3';
    addCourseBtn.style.cssText = 'border: 1px dashed var(--color-hairline-strong); color: var(--color-brand);';
    addCourseBtn.setAttribute('aria-label', 'Add course to this semester');
    addCourseBtn.innerHTML = `
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      Add Course
    `;
    addCourseBtn.addEventListener('click', () => {
      const row = buildCourseRow(section);
      courseList.appendChild(row);
      recalculate();
    });

    section.appendChild(header);
    section.appendChild(colHeaders);
    section.appendChild(courseList);
    section.appendChild(addCourseBtn);

    // Add 4 default courses
    for (let i = 0; i < 4; i++) {
      const row = buildCourseRow(section);
      courseList.appendChild(row);
    }

    return section;
  }

  function rebuildCourseRows(semesterEl) {
    const courseList = semesterEl.querySelector('.course-list');
    if (!courseList) return;
    const count = courseList.children.length || 4;
    courseList.innerHTML = '';
    for (let i = 0; i < count; i++) {
      courseList.appendChild(buildCourseRow(semesterEl));
    }
    recalculate();
  }

  // ── Main calculation ─────────────────────────────────────────────────────────
  function recalculate() {
    // Previous GPA inputs
    const prevEnabled = prevToggle && (prevToggle as HTMLInputElement).checked;
    let prevUW = 0, prevW = 0, prevCr = 0;
    if (prevEnabled) {
      prevUW = parseFloat((prevUWEl as HTMLInputElement)?.value || '0') || 0;
      prevW  = parseFloat((prevWEl as HTMLInputElement)?.value  || '0') || 0;
      prevCr = parseFloat((prevCrEl as HTMLInputElement)?.value || '0') || 0;
    }

    let cumulativeUWQP = prevUW * prevCr;
    let cumulativeWQP  = prevW  * prevCr;
    let cumulativeCr   = prevCr;

    const allSemesters = document.querySelectorAll('.semester-section');

    allSemesters.forEach(semEl => {
      const noCredits = (semEl as HTMLElement).dataset.noCredits === 'true';
      const pctMode   = (semEl as HTMLElement).dataset.pctMode   === 'true';
      const rows      = semEl.querySelectorAll('.course-row');

      let semUWQP = 0, semWQP = 0, semCr = 0;

      rows.forEach(row => {
        let gradePoints: number | null = null;

        if (pctMode) {
          const pctEl = row.querySelector('.pct-input') as HTMLInputElement;
          if (pctEl && pctEl.value !== '') {
            const letter = percentToLetter(pctEl.value);
            gradePoints = GRADE_POINTS[letter] ?? null;
          }
        } else {
          const selEl = row.querySelector('.grade-select') as HTMLSelectElement;
          if (selEl) gradePoints = GRADE_POINTS[selEl.value] ?? null;
        }

        if (gradePoints === null) return; // P, W — skip

        const typeEl = row.querySelector('.course-type') as HTMLSelectElement;
        const type   = typeEl?.value || 'Regular';
        const bonus  = TYPE_BONUS[type] || 0;
        const weightedPoints = Math.min(gradePoints + bonus, 5.0);

        const credits = noCredits
          ? 1
          : parseFloat((row.querySelector('.credits-input') as HTMLInputElement)?.value || '0');

        if (!credits || credits <= 0) return;

        semUWQP += gradePoints * credits;
        semWQP  += weightedPoints * credits;
        semCr   += credits;
      });

      // Update running cumulative badge
      const badge = semEl.querySelector('.running-gpa-badge') as HTMLElement;
      if (semCr > 0) {
        const runUW = (cumulativeUWQP + semUWQP) / (cumulativeCr + semCr);
        const runW  = (cumulativeWQP  + semWQP)  / (cumulativeCr + semCr);
        if (badge) {
          badge.textContent = `Cumulative: ${fmt(runUW)} UW / ${fmt(runW)} W`;
          badge.style.display = '';
        }
      } else {
        if (badge) badge.style.display = 'none';
      }

      cumulativeUWQP += semUWQP;
      cumulativeWQP  += semWQP;
      cumulativeCr   += semCr;
    });

    if (cumulativeCr === 0) {
      showEmpty();
      return;
    }

    const uwGpa = Math.round((cumulativeUWQP / cumulativeCr) * 1000) / 1000;
    const wGpa  = Math.round((cumulativeWQP  / cumulativeCr) * 1000) / 1000;

    showResult(uwGpa, wGpa, cumulativeCr, cumulativeUWQP);
  }

  function showEmpty() {
    emptyHint.style.display = '';
    emptyHint.classList.remove('hidden');
    resultPanel.classList.add('hidden');
  }

  function showResult(uwGpa, wGpa, totalCr, totalUWQP) {
    emptyHint.style.display = 'none';
    emptyHint.classList.add('hidden');
    resultPanel.classList.remove('hidden');

    const uwColor = gpaColor(uwGpa);
    const wColor  = gpaColor(wGpa);

    // Unweighted
    uwGpaEl.textContent = fmt(uwGpa);
    uwGpaEl.style.color = uwColor;
    uwLabelEl.textContent = gpaLabel(uwGpa);
    const uwPct = Math.min(Math.max((uwGpa / 4.0) * 100, 0), 100);
    uwMeterEl.style.width = uwPct + '%';
    uwMeterEl.style.background = uwColor;
    uwMeterEl.setAttribute('aria-valuenow', uwGpa.toFixed(2));

    // Weighted
    wGpaEl.textContent = fmt(wGpa);
    wGpaEl.style.color = wColor;
    wLabelEl.textContent = gpaLabel(Math.min(wGpa, 4.0)); // label based on 4.0 equivalent
    const wPct = Math.min(Math.max((wGpa / 5.0) * 100, 0), 100);
    wMeterEl.style.width = wPct + '%';
    wMeterEl.style.background = wColor;
    wMeterEl.setAttribute('aria-valuenow', wGpa.toFixed(2));

    // Stats
    totalCreditsEl.textContent = totalCr % 1 === 0 ? String(totalCr) : totalCr.toFixed(1);
    totalQpEl.textContent = totalUWQP.toFixed(2);

    // Proximity
    proximityEl.textContent = proximityMsg(uwGpa);

    // Pulse animation
    uwGpaEl.classList.remove('pulse-once');
    wGpaEl.classList.remove('pulse-once');
    void uwGpaEl.offsetWidth;
    void wGpaEl.offsetWidth;
    uwGpaEl.classList.add('pulse-once');
    wGpaEl.classList.add('pulse-once');
  }

  // ── Previous GPA toggle ──────────────────────────────────────────────────────
  prevToggle?.addEventListener('change', () => {
    if ((prevToggle as HTMLInputElement).checked) {
      prevInputs?.classList.remove('hidden');
    } else {
      prevInputs?.classList.add('hidden');
    }
    recalculate();
  });

  prevUWEl?.addEventListener('input', recalculate);
  prevWEl?.addEventListener('input', recalculate);
  prevCrEl?.addEventListener('input', recalculate);

  // ── Add semester ─────────────────────────────────────────────────────────────
  addSemesterBtn?.addEventListener('click', () => {
    const sem = buildSemester('');
    semestersContainer.appendChild(sem);
    recalculate();
  });

  // ── Action buttons ───────────────────────────────────────────────────────────
  shareBtn?.addEventListener('click', () => {
    const uwText = uwGpaEl?.textContent || '—';
    const wText  = wGpaEl?.textContent  || '—';
    const url    = new URL(window.location.href);
    url.searchParams.set('uw', uwText);
    url.searchParams.set('w', wText);
    const shareUrl = url.toString();

    const copy = (text: string) => {
      if (navigator.clipboard?.writeText) return navigator.clipboard.writeText(text);
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.cssText = 'position:fixed;opacity:0';
      document.body.appendChild(ta);
      ta.focus(); ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      return Promise.resolve();
    };

    copy(shareUrl).then(() => {
      if (shareBtnText) {
        shareBtnText.textContent = 'Copied!';
        setTimeout(() => { if (shareBtnText) shareBtnText.textContent = 'Share'; }, 2000);
      }
    }).catch(() => {
      if (shareBtnText) {
        shareBtnText.textContent = 'Failed';
        setTimeout(() => { if (shareBtnText) shareBtnText.textContent = 'Share'; }, 2000);
      }
    });
  });

  printBtn?.addEventListener('click', () => window.print());

  resetBtn?.addEventListener('click', () => {
    // Clear all semesters
    semestersContainer.innerHTML = '';
    semesterCount = 0;
    totalCourseId = 0;

    // Reset previous GPA section
    if (prevToggle) (prevToggle as HTMLInputElement).checked = false;
    prevInputs?.classList.add('hidden');
    if (prevUWEl) (prevUWEl as HTMLInputElement).value = '';
    if (prevWEl)  (prevWEl  as HTMLInputElement).value = '';
    if (prevCrEl) (prevCrEl as HTMLInputElement).value = '';

    // Add fresh semester
    const sem = buildSemester(SEMESTER_LABELS[0]);
    semestersContainer.appendChild(sem);
    showEmpty();
    recalculate();
  });

  // ── FAQ accordion ────────────────────────────────────────────────────────────
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item   = btn.closest('.faq-item');
      const isOpen = item?.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(el => {
        el.classList.remove('open');
        el.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen && item) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // ── Restore from URL params ──────────────────────────────────────────────────
  const urlParams = new URLSearchParams(window.location.search);
  const sharedUW  = urlParams.get('uw');
  const sharedW   = urlParams.get('w');
  if (sharedUW || sharedW) {
    const banner = document.createElement('div');
    banner.className = 'callout callout-blue mb-4';
    banner.style.fontSize = '0.875rem';
    banner.innerHTML = `Shared result — Unweighted: <strong>${sharedUW || '—'}</strong> / Weighted: <strong>${sharedW || '—'}</strong>. Enter your courses above to recalculate.`;
    const calcSection = document.getElementById('hs-calculator');
    if (calcSection) calcSection.insertBefore(banner, calcSection.firstChild);
  }

  // ── Init: add first semester ─────────────────────────────────────────────────
  const firstSem = buildSemester(SEMESTER_LABELS[0]);
  semestersContainer.appendChild(firstSem);
  recalculate();

})();
</script>
