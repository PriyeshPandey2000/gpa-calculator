            title: "Grade Calculator",
            desc: "Find out what grade you need on your final exam to hit your target course grade."
          }
        ].map(card => (
          <a
            href={card.href}
            class="card group block p-5 transition-all duration-200 hover:shadow-md no-underline"
            aria-label={card.title}
