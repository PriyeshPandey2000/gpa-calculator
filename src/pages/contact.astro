---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact — GPA Calculator Free"
  description="Contact the GPA Calculator Free team. Report bugs, suggest features, or ask questions about our free GPA calculators."
  canonical="/contact"
>
  <section class="page-hero">
    <div class="max-w-3xl mx-auto px-4">
      <nav class="breadcrumb mb-4"><a href="/">Home</a><span class="sep">/</span><span>Contact</span></nav>
      <h1 class="mb-3">Contact Us</h1>
      <p class="text-lg" style="color:var(--color-body)">Questions, bug reports, or feature suggestions? We'd love to hear from you.</p>
    </div>
  </section>

  <section class="max-w-xl mx-auto px-4 py-10">
    <div class="card p-8">
      <h2 class="text-xl font-semibold mb-6" style="color:var(--color-ink)">Send a Message</h2>

      <div data-fs-success class="callout callout-blue hidden">
        <span>✓ Message sent! We'll get back to you within 2-3 business days.</span>
      </div>
      <div data-fs-error class="callout hidden" style="background:var(--color-error-soft);border-left:3px solid var(--color-error);color:var(--color-error)"></div>

      <form id="contact-form" class="flex flex-col gap-5">
        <div>
          <label for="name">Your Name</label>
          <input type="text" id="name" name="name" placeholder="Jane Smith" class="input" data-fs-field required />
          <span data-fs-error="name" class="text-xs" style="color:var(--color-error)"></span>
        </div>
        <div>
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" placeholder="jane@example.com" class="input" data-fs-field required />
          <span data-fs-error="email" class="text-xs" style="color:var(--color-error)"></span>
        </div>
        <div>
          <label for="subject">Subject</label>
          <select id="subject" name="subject" class="input">
            <option value="bug">Bug Report</option>
            <option value="feature">Feature Request</option>
            <option value="general">General Question</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div>
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" placeholder="Describe your question or issue..." class="input" style="resize:vertical" data-fs-field required></textarea>
          <span data-fs-error="message" class="text-xs" style="color:var(--color-error)"></span>
        </div>
        <button type="submit" class="btn btn-primary btn-lg w-full" data-fs-submit-btn>Send Message</button>
      </form>

      <script>
        window.formspree = window.formspree || function () { (formspree.q = formspree.q || []).push(arguments); };
        formspree('initForm', { formElement: '#contact-form', formId: 'xqeobbjg' });
      </script>
      <script src="https://unpkg.com/@formspree/ajax@1" defer></script>
    </div>

    <div class="mt-8 text-sm" style="color:var(--color-body)">
      <h3 class="font-semibold mb-2" style="color:var(--color-ink)">Other Ways to Reach Us</h3>
      <p class="mb-1">Email: <a href="mailto:priyeshpandey2000@gmail.com">priyeshpandey2000@gmail.com</a></p>
      <p>Response time: typically 2-3 business days</p>
    </div>
  </section>
</Layout>

